{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/execution.schema.json",
  "policies": {
    "recovery_mode": "manual_recover",
    "workflow_budgets": {
      "research_actions": {
        "config_path": [
          "research_budget",
          "default_actions"
        ],
        "maximum": 100000
      }
    }
  },
  "agents": {
    "registry": {
      "startup_folder_watcher": {
        "role": "Startup Folder Watcher",
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.intake_blocks:startup_folder_watcher"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 900
          }
        }
      },
      "company_packet_grouper": {
        "role": "Company Packet Grouper",
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.intake_blocks:company_packet_grouper"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 900
          }
        }
      },
      "document_evidence_extractor": {
        "role": "Document Evidence Extractor",
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.intake_blocks:document_evidence_extractor"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 1200
          }
        }
      },
      "claim_normalizer": {
        "role": "Claim Normalizer",
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.intake_blocks:claim_normalizer"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 1200
          }
        }
      },
      "research_planner": {
        "role": "Research Planner",
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.research_planner:research_planner"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 1200
          }
        }
      },
      "company_identity_researcher": {
        "role": "Company Identity Researcher",
        "lifecycle": {
          "public_research": true
        },
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.public_researcher:company_identity_researcher"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 3600
          }
        }
      },
      "funding_researcher": {
        "role": "Funding Researcher",
        "lifecycle": {
          "public_research": true
        },
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.public_researcher:funding_researcher"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 3600
          }
        }
      },
      "market_comp_researcher": {
        "role": "Market And Comparable Researcher",
        "lifecycle": {
          "public_research": true
        },
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.public_researcher:market_comp_researcher"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 3600
          }
        }
      },
      "traction_verifier": {
        "role": "Traction Verifier",
        "lifecycle": {
          "public_research": true
        },
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.public_researcher:traction_verifier"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 3600
          }
        }
      },
      "rendered_page_researcher": {
        "role": "Rendered Page Researcher",
        "lifecycle": {
          "public_research": true
        },
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.public_researcher:rendered_page_researcher"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 3600
          }
        }
      },
      "research_reconciler": {
        "role": "Research Reconciler",
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.research_reconciler:research_reconciler"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 900
          }
        }
      },
      "berkus_scorer": {
        "role": "Berkus Scorer",
        "lifecycle": {
          "method": "berkus_method"
        },
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.valuation_scorer:berkus_scorer"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 1800
          }
        }
      },
      "scorecard_bill_payne_scorer": {
        "role": "Scorecard Bill Payne Scorer",
        "lifecycle": {
          "method": "scorecard_bill_payne_method"
        },
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.valuation_scorer:scorecard_bill_payne_scorer"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 1800
          }
        }
      },
      "risk_factor_summation_scorer": {
        "role": "Risk Factor Summation Scorer",
        "lifecycle": {
          "method": "risk_factor_summation_method"
        },
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.valuation_scorer:risk_factor_summation_scorer"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 1800
          }
        }
      },
      "venture_capital_method_scorer": {
        "role": "Venture Capital Method Scorer",
        "lifecycle": {
          "method": "venture_capital_method"
        },
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.valuation_scorer:venture_capital_method_scorer"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 1800
          }
        }
      },
      "first_chicago_scorer": {
        "role": "First Chicago Scorer",
        "lifecycle": {
          "method": "first_chicago_method"
        },
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.valuation_scorer:first_chicago_scorer"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 1800
          }
        }
      },
      "comparables_market_multiple_scorer": {
        "role": "Comparables Market Multiple Scorer",
        "lifecycle": {
          "method": "comparables_market_multiple_method"
        },
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.valuation_scorer:comparables_market_multiple_scorer"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 1800
          }
        }
      },
      "cost_to_duplicate_scorer": {
        "role": "Cost To Duplicate Scorer",
        "lifecycle": {
          "method": "cost_to_duplicate_method"
        },
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.valuation_scorer:cost_to_duplicate_scorer"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 1800
          }
        }
      },
      "score_consistency_auditor": {
        "role": "Score Consistency Auditor",
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.score_consistency_auditor:score_consistency_auditor"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 900
          }
        }
      },
      "company_report_writer": {
        "role": "Company Report Writer",
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.company_report_writer:company_report_writer"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 900
          }
        }
      },
      "batch_index_writer": {
        "role": "Batch Index Writer",
        "block": {
          "uses": "mn.blocks.domain_operation@1",
          "hooks": {
            "operation": "domain.batch_index_writer:batch_index_writer"
          },
          "limits": {
            "max_calls": 8,
            "timeout_seconds": 900
          }
        }
      }
    }
  },
  "defaults": {
    "worker": {
      "with": {
        "image": "mirror-neuron/vc-assistant:local",
        "upload_paths": [
          {
            "source": "domain",
            "target": "domain"
          }
        ]
      }
    }
  },
  "requirements": {
    "cpu": {
      "min_cores": 1
    },
    "disk": {
      "min_gb": 1
    },
    "memory": {
      "min_gb": 2
    }
  },
  "workers": {
    "groups": [
      {
        "steps": [
          "collect_public_research"
        ],
        "with": {
          "stereotype": "public_browser_worker"
        }
      },
      {
        "steps": [
          "write_company_reports",
          "publish_batch_summary"
        ],
        "with": {
          "stereotype": "internal_write_worker"
        }
      }
    ]
  },
  "mode": "compiled",
  "job_name": "vc-assistant"
}
