{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/contracts.schema.json",
  "summary": "General task execution and recursive harness improvement in a Job-isolated OpenShell workspace.",
  "inputs": {
    "task": {
      "type": "string",
      "required": false,
      "privacy": "confidential",
      "description": "Saved instructions for each run. Defaults to summarizing the input folder into summary.md. A per-run task overrides these instructions; if absent, ask in Chat."
    },
    "input_folder": {
      "type": "local_path",
      "path_kind": "directory",
      "required": true,
      "privacy": "confidential",
      "description": "Read-only task material, including Markdown files and source code. Generated work belongs only in the output folder."
    },
    "supervisor_instructions": {
      "type": "array",
      "required": false,
      "privacy": "confidential",
      "description": "Explicit supervisor preferences and working rules. Captured for the next run; never a permission grant or an evidence source.",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "kind": {
            "enum": [
              "communication",
              "work_rule"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  },
  "outputs": {
    "profile": "standard_run_store",
    "primary": {
      "id": "result",
      "path": "result.json",
      "schema_version": "otterdesk.general_assistant.result.v1",
      "type": "task_result",
      "required_fields": [
        "status",
        "answer",
        "deliverables",
        "improvement"
      ]
    },
    "artifacts": [
      {
        "artifact_id": "result",
        "path": "result.json",
        "mime_type": "application/json",
        "required": true,
        "privacy": "confidential"
      },
      {
        "artifact_id": "answer",
        "path": "answer.md",
        "mime_type": "text/markdown",
        "required": true,
        "privacy": "confidential"
      },
      {
        "artifact_id": "deliverables",
        "path": "deliverables",
        "mime_type": "application/octet-stream",
        "required": false,
        "privacy": "confidential"
      },
      {
        "artifact_id": "harness_audit",
        "path": "harness-audit.json",
        "mime_type": "application/json",
        "required": true,
        "privacy": "confidential"
      }
    ]
  },
  "privacy": {
    "classification": "confidential",
    "external_sharing": "disabled",
    "notes": "The task, read-only input and Harness2 memory may be read by the runtime model. Task tools cannot write input or reach the Core conversation RPC. Generated work is exported only to the configured output folder. Memory is private to the hired Job."
  }
}
