{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/execution.schema.json",
  "type": "batch",
  "mode": "compiled",
  "job_name": "computer-use",
  "requirements": {
    "cpu": {
      "min_cores": 2
    },
    "memory": {
      "min_gb": 24
    },
    "disk": {
      "min_gb": 16
    },
    "gpu": {
      "min_count": 0
    },
    "network": {
      "egress": "Runtime vision model and Membrane service. The independent native app opens user-authorized apps and HTTPS websites through the local desktop."
    },
    "os": "darwin"
  },
  "agents": {
    "registry": {}
  },
  "defaults": {
    "worker": {
      "uses": "mn-agents.worker.python_host@1",
      "with": {
        "stereotype": [
          "blueprint_host_worker",
          "internal_write_worker"
        ],
        "upload_paths": [
          {
            "source": "domain",
            "target": "domain"
          }
        ],
        "timeout_seconds": 900,
        "pass_env": [
          "MN_CONTEXT_ADDR",
          "MN_CONTEXT_AUTH_TOKEN",
          "MN_LLM_API_KEY",
          "MN_LLM_PROVIDER",
          "MN_LLM_API_BASE",
          "MN_LLM_BACKEND",
          "MN_COMPUTER_USE_APP"
        ]
      }
    }
  },
  "workers": {
    "groups": [
      {
        "steps": [
          "solve_task"
        ],
        "uses": "mn-agents.worker.python_host@1",
        "with": {
          "timeout_seconds": 3600,
          "max_attempts": 1,
          "safe_to_retry": false,
          "idempotent": false,
          "side_effect": "external_write"
        }
      }
    ]
  },
  "runtime": {
    "placement": {
      "must_run_local": true
    }
  }
}
