{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/workflow.schema.json",
  "workflow_id": "general_assistant_v1",
  "mode": "static_dag",
  "execution": {
    "strategy": "serial",
    "max_parallel_steps": 1
  },
  "steps": [
    {
      "id": "prepare_task",
      "kind": "source",
      "label": "Prepare the Mac task and working rules",
      "goal": "Prepare the Mac task and working rules",
      "needs": [],
      "control": {
        "timeout_seconds": 900,
        "retry": {
          "max_attempts": 1
        }
      }
    },
    {
      "id": "solve_task",
      "kind": "stage",
      "label": "Observe and operate the Mac, asking for help when needed",
      "goal": "Observe and operate the Mac, asking for help when needed",
      "needs": [
        "prepare_task"
      ],
      "control": {
        "timeout_seconds": 3600,
        "retry": {
          "max_attempts": 1
        }
      }
    },
    {
      "id": "publish_task",
      "kind": "sink",
      "label": "Publish the observed result and retain navigation lessons",
      "goal": "Publish the observed result and retain navigation lessons",
      "needs": [
        "solve_task"
      ],
      "control": {
        "timeout_seconds": 120,
        "retry": {
          "max_attempts": 1
        }
      }
    }
  ]
}
