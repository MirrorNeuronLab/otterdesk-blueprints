{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/extensions/ui.schema.json",
  "starter_questions": [
    "What is your mission?",
    "What requires my approval?",
    "How do you collaborate with your marketing co-worker?"
  ],
  "init_config_review": {
    "required": true,
    "fields": [
      {
        "path": "inputs.payload.website_url",
        "label": "Website",
        "type": "text",
        "required": true,
        "default": "https://bibblio.app"
      },
      {
        "path": "inputs.payload.goal_id",
        "label": "Shared goal",
        "type": "text",
        "required": true,
        "default": "bibblio-marketing"
      },
      {
        "path": "inputs.payload.peer_job_id",
        "label": "Previous pair peer",
        "type": "text",
        "required": false
      },
      {
        "path": "inputs.payload.instruction",
        "label": "Marketing instructions",
        "type": "textarea",
        "required": false
      },
      {
        "path": "inputs.payload.common_goal",
        "label": "Common goal",
        "type": "textarea",
        "required": false,
        "default": "Market Bibblio through relevant, human-approved email outreach."
      },
      {
        "path": "inputs.payload.collaboration_group_id",
        "label": "Collaboration group",
        "type": "text",
        "required": false
      },
      {
        "path": "inputs.payload.collaboration_peers",
        "label": "Group members",
        "type": "textarea",
        "value_type": "array",
        "required": false,
        "default": []
      }
    ]
  },
  "setup_guide": {
    "schema": "otterdesk.setup_guide.v1",
    "introduction": "Studies Bibblio and proposes evidence-backed email campaigns for your approval.",
    "sample": {
      "available": false
    },
    "real": {
      "introduction": "Review your marketing settings and connect co-workers in Collaboration.",
      "values": {}
    },
    "fields": [
      {
        "path": "inputs.payload.website_url",
        "label": "Website",
        "type": "text",
        "required": true,
        "default": "https://bibblio.app"
      },
      {
        "path": "inputs.payload.goal_id",
        "label": "Shared goal",
        "type": "text",
        "required": true,
        "default": "bibblio-marketing"
      },
      {
        "path": "inputs.payload.peer_job_id",
        "label": "Previous pair peer",
        "type": "text",
        "required": false
      },
      {
        "path": "inputs.payload.instruction",
        "label": "Marketing instructions",
        "type": "textarea",
        "required": false
      },
      {
        "path": "inputs.payload.common_goal",
        "label": "Common goal",
        "type": "textarea",
        "required": false,
        "default": "Market Bibblio through relevant, human-approved email outreach."
      },
      {
        "path": "inputs.payload.collaboration_group_id",
        "label": "Collaboration group",
        "type": "text",
        "required": false
      },
      {
        "path": "inputs.payload.collaboration_peers",
        "label": "Group members",
        "type": "textarea",
        "value_type": "array",
        "required": false,
        "default": []
      }
    ]
  }
}
