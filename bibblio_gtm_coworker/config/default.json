{
  "inputs": {
    "adapter": "mock",
    "description": "Synthetic focused input for Bibblio GTM Co-worker.",
    "payload": {
      "business_goal": "Turn Bibblio into a profitable business.",
      "goal_id": "bibblio-profitable-business",
      "input_folder": "@/examples/sample_inputs",
      "contacts_csv": "@/examples/sample_inputs/edtech_contacts_sample.csv",
      "output_folder": "~/Downloads/bibblio_gtm_coworker",
      "peer_mcp_servers": []
    }
  },
  "outputs": {
    "folder_path": "~/Downloads/bibblio_gtm_coworker",
    "write_run_store": true
  },
  "execution": {
    "quick_test": true
  },
  "llm": {
    "mode": "fake",
    "require_live": false
  },
  "mcp_collaboration": {
    "publish_local_exchange": true,
    "peer_reads_enabled": false
  },
  "privacy": {
    "default_classification": "confidential",
    "child_data_export": "blocked",
    "external_communications": "approval_required",
    "minimum_data": true
  },
  "gtm": {
    "max_contacts_per_run": 100,
    "outreach_mode": "draft_only",
    "max_initial_pilot_contacts": 10
  }
}

