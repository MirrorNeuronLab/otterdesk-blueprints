{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/execution.schema.json",
  "policies": {
    "recovery_mode": "local_restart"
  },
  "agents": {
    "registry": {
      "research_packet_auditor": {
        "handler": "mn_sdk.integrations.block_worker",
        "role": "Research Packet Auditor",
        "with": {
          "revision": "research_assistant@4.0.2",
          "instance": {
            "uses": "mn.blocks.domain_operation@1",
            "hooks": {
              "operation": "domain.verification:audit_packet"
            },
            "limits": {
              "max_calls": 1,
              "timeout_seconds": 1800
            }
          }
        }
      },
      "research_report_writer": {
        "handler": "mn_sdk.integrations.block_worker",
        "role": "Research Report Writer",
        "with": {
          "revision": "research_assistant@4.0.2",
          "instance": {
            "uses": "mn.blocks.domain_operation@1",
            "hooks": {
              "operation": "domain.reporting:publish_packet"
            },
            "limits": {
              "max_calls": 1,
              "timeout_seconds": 1800
            }
          }
        }
      }
    }
  },
  "defaults": {
    "worker": {
      "with": {
        "stereotype": "internal_write_worker",
        "image": "mirror-neuron/research-assistant:local",
        "upload_paths": [
          {
            "source": "domain",
            "target": "domain"
          }
        ],
        "upload_path": "domain",
        "upload_as": "domain"
      }
    }
  },
  "requirements": {
    "cpu": {
      "min_cores": 1
    },
    "disk": {
      "min_gb": 1
    },
    "memory": {
      "min_gb": 2
    },
    "gpu": {
      "min_count": 1,
      "min_memory_mb": 49152,
      "memory_operator": ">=",
      "enforcement": "hard"
    }
  },
  "workers": {
    "groups": [
      {
        "steps": [
          "build_research_evidence",
          "develop_and_challenge_hypotheses"
        ],
        "with": {
          "stereotype": "public_browser_worker"
        }
      },
      {
        "steps": [
          "assess_evidence_coverage",
          "assess_experiment_readiness"
        ],
        "with": {
          "stereotype": "internal_write_worker"
        }
      },
      {
        "steps": [
          "verify_and_publish_research_packet"
        ],
        "with": {
          "stereotype": "internal_write_worker"
        }
      }
    ]
  },
  "mode": "compiled",
  "job_name": "research-assistant"
}
