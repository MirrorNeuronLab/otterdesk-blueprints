{
  "inputs": {
    "adapter": "mock",
    "description": "Synthetic Bibblio demo input for the generic Business Finance Co-worker.",
    "payload": {
      "business_name": "Bibblio",
      "business_goal": "Build a successful business for Bibblio.",
      "goal_id": "bibblio-business-success",
      "planning_horizon_days": 90,
      "input_folder": "@/examples/sample_inputs",
      "metrics_file": "@/examples/sample_inputs/business_metrics.json",
      "output_folder": "~/Downloads/business_finance_coworker"
    }
  },
  "outputs": {
    "folder_path": "~/Downloads/business_finance_coworker",
    "write_run_store": true
  },
  "execution": {
    "quick_test": true
  },
  "llm": {
    "mode": "fake",
    "require_live": false
  },
  "knowledge_rag": {
    "backend": "milvus_lite"
  },
  "privacy": {
    "default_classification": "confidential",
    "child_data_export": "blocked",
    "external_communications": "approval_required",
    "minimum_data": true
  },
  "finance": {
    "maximum_cac_payback_months": 6,
    "maximum_monthly_churn_rate": 0.08,
    "cash_guardrail_monthly_spend": 500
  }
}
