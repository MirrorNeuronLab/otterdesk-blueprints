{
  "air-gapped": false,
  "apiVersion": "mn.workflow/v1",
  "kind": "WorkflowSource",
  "standard": {
    "profile": "blueprint"
  },
  "identity": {
    "id": "business_finance_coworker",
    "name": "Business Finance Co-worker",
    "job_name": "business-finance-coworker",
    "category": "business",
    "version": 1,
    "manifest_version": "1.0"
  },
  "description": "A generic Business Finance co-worker that calculates contribution economics, exposes missing evidence, and publishes cash, acquisition, pricing, and break-even guardrails for founder review.",
  "intent": {
    "description": "Business Finance and Unit Economics Controller serving a configurable business-success goal; the bundled demo applies the role to Bibblio.",
    "problem": "Early-stage businesses need a reliable view of contribution, CAC, payback, break-even scale, and missing financial inputs before growth or pricing decisions.",
    "target_users": "Founders and designated finance, bookkeeping, accounting, and operating reviewers.",
    "safety": {
      "enabled": true,
      "mode": "approval_required",
      "allowed_decisions": [
        "approve",
        "revise",
        "reject"
      ],
      "blocked_actions": [
        "send_external_communications",
        "publish_child_facing_content",
        "spend_money_or_launch_paid_campaigns",
        "change_pricing_or_subscription_terms",
        "make_learning_medical_or_therapeutic_claims",
        "change_child_or_family_data_collection"
      ],
      "default_action": "reject",
      "timeout_seconds": 86400,
      "reason": "The co-worker observes, analyzes, drafts, and queues; a designated human approves every consequential external action."
    }
  },
  "config": {
    "default": "config/default.json",
    "embed": true,
    "manifest_defaults": [
      "llm",
      "knowledge_rag",
      {
        "from": "requirements",
        "to": "resources"
      },
      {
        "from": "workflow.policy.human",
        "to": "human_control"
      },
      {
        "from": "identity.id",
        "to": "identity.blueprint_id"
      },
      {
        "from": "identity.name",
        "to": "identity.name"
      }
    ]
  },
  "defaults": {
    "worker": {
      "with": {
        "stereotype": "internal_write_worker",
        "image": "mirror-neuron/business-finance-coworker:local",
        "upload_paths": [
          {
            "source": "domain",
            "target": "domain"
          }
        ]
      }
    }
  },
  "contracts": {
    "input_adapters": {
      "default": "mock",
      "resolved_artifact": "inputs.json",
      "supported": [
        "mock",
        "json",
        "file",
        "env_json"
      ]
    },
    "inputs": {
      "business_name": {
        "type": "domain_value",
        "required": false,
        "privacy": "internal",
        "description": "Business name used to contextualize role outputs. The bundled demo defaults to Bibblio.",
        "example": "Bibblio"
      },
      "business_goal": {
        "type": "domain_value",
        "required": false,
        "privacy": "internal",
        "description": "Shared business goal served by the independently launched co-workers.",
        "example": "Build a successful business for Bibblio."
      },
      "goal_id": {
        "type": "domain_value",
        "required": false,
        "privacy": "internal",
        "description": "Stable goal identity used for explicit MCP peer collaboration.",
        "example": "bibblio-business-success"
      },
      "planning_horizon_days": {
        "type": "domain_value",
        "required": false,
        "privacy": "internal",
        "description": "Founder-facing planning horizon, bounded from 30 to 365 days.",
        "example": 90
      },
      "input_folder": {
        "type": "local_path",
        "path_kind": "directory",
        "required": false,
        "privacy": "confidential",
        "description": "Local folder containing this co-worker's focused input file.",
        "example": "@/examples/sample_inputs"
      },
      "output_folder": {
        "type": "local_path",
        "path_kind": "directory",
        "required": false,
        "privacy": "confidential",
        "description": "Local folder for review-ready artifacts.",
        "example": "~/Downloads/bibblio"
      },
      "metrics_file": {
        "type": "local_path",
        "path_kind": "file",
        "required": false,
        "privacy": "confidential",
        "description": "Dated JSON snapshot of customer funnel, subscription, margin, acquisition-spend, and operating-cost metrics. Generic customer fields are preferred; the unchanged Bibblio demo retains family-named fields.",
        "example": "@/examples/sample_inputs/business_metrics.json"
      }
    },
    "outputs": {
      "primary": {
        "id": "final_artifact",
        "type": "final_artifact",
        "path": "final_artifact.json",
        "schema_version": "mn.blueprint.final_artifact_contract.v1",
        "required_fields": [
          "type",
          "business_name",
          "business_goal",
          "worker_role",
          "role_contribution",
          "north_star_question",
          "role_scorecard",
          "founder_decisions",
          "executive_summary",
          "recommended_action",
          "confidence",
          "evidence",
          "next_steps",
          "ninety_day_plan",
          "cross_functional_handoffs",
          "source_refs",
          "job_context"
        ]
      },
      "artifacts": [
        {
          "artifact_id": "final_artifact",
          "type": "final_artifact",
          "path": "final_artifact.json",
          "producer": "business_finance_controller",
          "mime_type": "application/json",
          "schema_version": "mn.blueprint.final_artifact.v1",
          "source_refs": [
            "inputs.json",
            "workflow_state/work_packets"
          ]
        },
        {
          "artifact_id": "business_finance_packet",
          "type": "business_finance_control_brief",
          "path": "business_finance_packet.json",
          "producer": "business_finance_controller",
          "mime_type": "application/json",
          "schema_version": "mn.business_success.role_brief.v1",
          "source_refs": [
            "inputs.json",
            "workflow_state/work_packets"
          ]
        }
      ]
    },
    "status": {
      "event": "blueprint_status",
      "heartbeat": true,
      "phases": [
        "loading_inputs",
        "running_worker",
        "waiting_for_human",
        "writing_artifacts",
        "completed"
      ]
    },
    "privacy": {
      "default_classification": "confidential"
    }
  },
  "agents": {
    "registry": {
      "business_finance_controller": {
        "handler": "agents.business_finance_controller",
        "role": "Business Finance and Unit Economics Controller"
      }
    }
  },
  "llm": {
    "enabled": true,
    "mode": "actor_assisted",
    "mock_mode": "deterministic",
    "provider": "docker_model_runner",
    "model": "small",
    "runtime_model": "small",
    "backend": "llama.cpp",
    "default_config": "primary",
    "configs": {
      "primary": {
        "provider": "docker_model_runner",
        "model": "small",
        "runtime_model": "small",
        "backend": "llama.cpp",
        "temperature": 0.2,
        "max_tokens": 2400
      }
    },
    "responsibilities": [
      "Separate observed facts from assumptions.",
      "Preserve source references and name missing evidence.",
      "Draft review-ready recommendations without executing external actions."
    ],
    "agents": {
      "business_finance_controller": {
        "llm_config": "primary",
        "role": "Business Finance and Unit Economics Controller",
        "responsibilities": [
          "Calculate contribution economics from supplied observed inputs.",
          "Gate acquisition and pricing proposals against explicit cash and payback thresholds.",
          "Keep accounting, tax, treasury, pricing, and contract actions human-controlled."
        ]
      }
    }
  },
  "response_service": {
    "enabled": true
  },
  "knowledge_rag": {
    "chunk_overlap": 80,
    "chunk_size": 800,
    "enabled": true,
    "index_on_startup": true,
    "knowledge_dir": "@/payloads/knowledge",
    "max_context_chars": 6000,
    "namespace": "",
    "required": true,
    "top_k": 5
  },
  "requirements": {
    "cpu": {
      "min_cores": 1
    },
    "memory": {
      "min_gb": 1
    },
    "disk": {
      "min_gb": 1
    },
    "gpu": {
      "min_count": 0
    }
  },
  "metadata": {
    "blueprint_id": "business_finance_coworker",
    "runtime_features": [
      "deterministic unit economics",
      "break-even and payback model",
      "MCP finance thresholds",
      "human financial approval"
    ],
    "collaboration_group": "business-success-team",
    "business_goal": "Build a successful business for Bibblio.",
    "job_data": {
      "resources": [
        {
          "name": "knowledge",
          "path": "knowledge",
          "access": "read_write",
          "seed": "@/payloads/knowledge"
        },
        {
          "name": "rag",
          "path": "databases/rag",
          "access": "read_write"
        },
        {
          "name": "state",
          "path": "state",
          "access": "read_write"
        }
      ]
    }
  },
  "workflow": {
    "workflow_id": "business_finance_coworker_v1",
    "execution": {
      "strategy": "serial"
    },
    "policy": {
      "failure": {
        "default": "fail_closed"
      },
      "human": {
        "enabled": true,
        "mode": "approval_required",
        "allowed_decisions": [
          "approve",
          "revise",
          "reject"
        ],
        "blocked_actions": [
          "send_external_communications",
          "publish_child_facing_content",
          "spend_money",
          "change_pricing",
          "change_data_collection"
        ],
        "default_action": "reject",
        "timeout_seconds": 86400
      }
    },
    "steps": [
      {
        "id": "calculate_unit_economics",
        "kind": "source",
        "label": "Calculate Unit Economics",
        "goal": "Calculate deterministic contribution economics and name every missing or excluded input.",
        "needs": [],
        "run": {
          "definition": "steps.calculate_unit_economics"
        },
        "control": {
          "required": true,
          "timeout_seconds": 900,
          "failure_policy": "fail_workflow",
          "retry": {
            "max_attempts": 2,
            "backoff_seconds": 1,
            "backoff_multiplier": 2,
            "jitter": 0
          },
          "uncertainty": {
            "min_confidence": 0,
            "on_low_confidence": "continue_with_warning"
          }
        }
      },
      {
        "id": "publish_financial_control_packet",
        "kind": "sink",
        "label": "Publish Financial Control Packet",
        "goal": "Publish founder-review cash, spend, and evidence guardrails for peer co-workers.",
        "needs": [
          "calculate_unit_economics"
        ],
        "run": {
          "definition": "steps.publish_financial_control_packet"
        },
        "control": {
          "required": true,
          "timeout_seconds": 900,
          "failure_policy": "fail_workflow",
          "retry": {
            "max_attempts": 2,
            "backoff_seconds": 1,
            "backoff_multiplier": 2,
            "jitter": 0
          },
          "uncertainty": {
            "min_confidence": 0,
            "on_low_confidence": "continue_with_warning"
          }
        }
      }
    ]
  },
  "skill_dependencies": [
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-goal-work-packet-skill",
      "version": "1.2.31"
    },
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-rag-skill",
      "version": "1.2.31"
    },
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-job-response-skill",
      "version": "1.2.31"
    },
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-mcp-client-skill",
      "version": "1.2.31"
    }
  ],
  "agent_dependencies": [
    {
      "type": "pip",
      "source": "gar",
      "name": "mn-prototype-stateful-step-agent",
      "version": "1.2.31"
    }
  ]
}
