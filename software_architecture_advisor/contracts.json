        "path": "data/work_packages.json",
        "mime_type": "application/json",
        "type": "work_packages",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "catalog_plan",
        "path": "catalog/plan.json",
        "mime_type": "application/json",
        "type": "catalog_plan",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
      },
