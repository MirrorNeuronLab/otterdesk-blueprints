{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/contracts.schema.json",
  "inputs": {
    "repository_url": {
      "type": "string",
      "required": false,
      "privacy": "confidential",
      "description": "Public HTTPS GitHub repository-root URL. Mutually exclusive with input_folder."
    },
    "input_folder": {
      "type": "local_path",
      "path_kind": "directory",
      "required": false,
      "privacy": "confidential",
      "description": "Local source folder, staged by the platform. Mutually exclusive with repository_url."
    },
    "goal": {
      "type": "string",
      "required": false,
      "privacy": "confidential",
      "description": "Architecture investigation objective."
    },
    "graph_export": {
      "type": "local_path",
      "path_kind": "file",
      "required": false,
      "privacy": "confidential",
      "description": "Optional version-1 or version-2 evidence graph export; needed for non-Python structural modules."
    },
    "output_folder": {
      "type": "local_path",
      "path_kind": "directory",
      "required": false,
      "privacy": "confidential",
      "description": "Destination for reports and audit files."
    }
  },
  "outputs": {
    "artifacts": [
      {
        "artifact_id": "snapshot",
        "path": "snapshot.json",
        "mime_type": "application/json",
        "type": "snapshot",
        "producer": "workflow",
        "schema_version": "mn.architecture.snapshot.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "investigation",
        "path": "investigation.json",
        "mime_type": "application/json",
        "type": "investigation",
        "producer": "workflow",
        "schema_version": "mn.architecture.investigation.v2",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "report",
        "path": "report.md",
        "mime_type": "text/markdown",
        "type": "report",
        "producer": "workflow",
        "schema_version": "mn.architecture.report.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "suggestive_prompts",
        "path": "suggestive_prompts.md",
        "mime_type": "text/markdown",
        "type": "suggestive_prompts",
        "producer": "workflow",
        "schema_version": "mn.architecture.suggestive_prompts.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "knowledge",
        "path": "knowledge.json",
        "mime_type": "application/json",
        "type": "knowledge",
        "producer": "workflow",
        "schema_version": "mn.architecture.knowledge.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "report_data",
        "path": "report.json",
        "mime_type": "application/json",
        "type": "report_data",
        "producer": "workflow",
        "schema_version": "mn.architecture.report_data.v2",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "model_trace",
        "path": "model-trace.json",
        "mime_type": "application/json",
        "type": "model_trace",
        "producer": "workflow",
        "schema_version": "mn.architecture.model_trace.v2",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "events",
        "path": "events.log",
        "mime_type": "application/x-ndjson",
        "type": "events",
        "producer": "workflow",
        "schema_version": "mn.architecture.events.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "review_index",
        "path": "review_index.json",
        "mime_type": "application/json",
        "type": "review_index",
        "producer": "workflow",
        "schema_version": "mn.architecture.review_index.v2",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "investigation_plan",
        "path": "investigation-plan.json",
        "mime_type": "application/json",
        "type": "investigation_plan",
        "producer": "workflow",
        "schema_version": "mn.architecture.plan.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "context_memory",
        "path": "context-memory",
        "mime_type": "application/octet-stream",
        "type": "context_memory",
        "producer": "workflow",
        "schema_version": "mn.context.working.v1",
        "privacy": "confidential",
        "required": false
      }
    ]
  },
  "privacy": {
    "classification": "confidential",
    "external_sharing": "disabled",
    "notes": "Frozen repository text, passages, graph receipts and model traces remain confidential run artifacts. Repository content is never executed."
  }
}
