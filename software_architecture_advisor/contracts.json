        "mime_type": "application/json",
        "type": "recommendations",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "assumptions",
        "path": "data/assumptions.json",
        "mime_type": "application/json",
        "type": "assumptions",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "verification_tasks",
        "path": "data/verification_tasks.json",
        "mime_type": "application/json",
        "type": "verification_tasks",
        "producer": "workflow",
