{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/contracts.schema.json",
  "inputs": {
    "repository_url": {
      "type": "string",
      "required": false,
      "privacy": "confidential",
      "description": "Public HTTPS GitHub repository-root URL. Mutually exclusive with input_folder."
    },
    "input_folder": {
      "type": "local_path",
      "path_kind": "directory",
      "required": false,
      "privacy": "confidential",
      "description": "Local source folder, staged by the platform. Mutually exclusive with repository_url."
    },
    "goal": {
      "type": "string",
      "required": false,
      "privacy": "confidential",
      "description": "Architecture investigation objective."
    },
    "graph_export": {
      "type": "local_path",
      "path_kind": "file",
      "required": false,
      "privacy": "confidential",
      "description": "Optional version-1 or version-2 evidence graph export citing captured code; supplies unsupported structural layers or explicit runtime evidence."
    },
    "output_folder": {
      "type": "local_path",
      "path_kind": "directory",
      "required": false,
      "privacy": "confidential",
      "description": "Destination for reports and audit files."
    },
    "review_file": {
      "type": "local_path",
      "path_kind": "file",
      "required": false,
      "privacy": "confidential",
      "description": "Optional bounded JSON review export from the architecture dashboard. Does not authorize source edits."
    }
  },
  "outputs": {
    "artifacts": [
      {
        "artifact_id": "chat_summary",
        "path": "data/chat-summary.json",
        "mime_type": "application/json",
        "type": "chat_summary",
        "producer": "workflow",
        "schema_version": "otterdesk.report-summary.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "snapshot",
        "path": "snapshot.json",
        "mime_type": "application/json",
        "type": "snapshot",
        "producer": "workflow",
        "schema_version": "mn.architecture.snapshot.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "structural_analysis",
        "path": "analysis/dependencies.json",
        "mime_type": "application/json",
        "type": "structural_analysis",
        "producer": "workflow",
        "schema_version": "mn.architecture.structural_analysis.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "dependency_dsm",
        "path": "analysis/dependency-dsm.csv",
        "mime_type": "text/csv",
        "type": "dependency_dsm",
        "producer": "workflow",
        "schema_version": "mn.architecture.dependency_dsm.v1",
        "privacy": "confidential",
        "required": false
      },
      {
        "artifact_id": "report",
        "path": "reports/report.md",
        "mime_type": "text/markdown",
        "type": "report",
        "producer": "workflow",
        "schema_version": "mn.architecture.report.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "report_data",
        "path": "data/report.json",
        "mime_type": "application/json",
        "type": "report_data",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog_report.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "events",
        "path": "events.log",
        "mime_type": "application/x-ndjson",
        "type": "events",
        "producer": "workflow",
        "schema_version": "mn.architecture.events.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "review_index",
        "path": "review_index.json",
        "mime_type": "application/json",
