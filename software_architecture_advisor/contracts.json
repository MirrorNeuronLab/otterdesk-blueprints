        "mime_type": "application/json",
        "type": "evidence",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "claims",
        "path": "data/claims.json",
        "mime_type": "application/json",
        "type": "claims",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
