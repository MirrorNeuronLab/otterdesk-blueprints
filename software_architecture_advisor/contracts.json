{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/contracts.schema.json",
  "inputs": {
    "repository_url": {
      "type": "string",
      "required": false,
      "privacy": "confidential",
      "description": "Public HTTPS GitHub repository-root URL. Mutually exclusive with input_folder."
    },
    "input_folder": {
      "type": "local_path",
      "path_kind": "directory",
      "required": false,
      "privacy": "confidential",
      "description": "Local source folder, staged by the platform. Mutually exclusive with repository_url."
    },
    "goal": {
      "type": "string",
      "required": false,
      "privacy": "confidential",
      "description": "Architecture investigation objective."
    },
    "graph_export": {
      "type": "local_path",
      "path_kind": "file",
      "required": false,
      "privacy": "confidential",
      "description": "Optional version-1 or version-2 evidence graph export; needed for non-Python structural modules."
    },
    "output_folder": {
      "type": "local_path",
      "path_kind": "directory",
      "required": false,
      "privacy": "confidential",
      "description": "Destination for reports and audit files."
    }
  },
  "input_validation": {
    "rules": [
      {
        "command": [
          "/usr/bin/python3",
          "payloads/agents/validation/validate_source_input.py"
        ],
        "name": "source_input_validate",
        "timeout_seconds": 5,
        "type": "command"
      }
    ]
  },
  "outputs": {
    "artifacts": [
      {
        "artifact_id": "snapshot",
        "path": "snapshot.json",
        "mime_type": "application/json",
        "type": "snapshot",
        "producer": "workflow",
        "schema_version": "mn.architecture.snapshot.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "structural_analysis",
        "path": "analysis/dependencies.json",
        "mime_type": "application/json",
        "type": "structural_analysis",
        "producer": "workflow",
        "schema_version": "mn.architecture.structural_analysis.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "dependency_dsm",
        "path": "analysis/dependency-dsm.csv",
        "mime_type": "text/csv",
        "type": "dependency_dsm",
        "producer": "workflow",
        "schema_version": "mn.architecture.dependency_dsm.v1",
        "privacy": "confidential",
        "required": false
      },
      {
        "artifact_id": "report",
        "path": "report.md",
        "mime_type": "text/markdown",
        "type": "report",
        "producer": "workflow",
        "schema_version": "mn.architecture.report.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "report_data",
        "path": "report.json",
        "mime_type": "application/json",
        "type": "report_data",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog_report.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "events",
        "path": "events.log",
        "mime_type": "application/x-ndjson",
        "type": "events",
        "producer": "workflow",
        "schema_version": "mn.architecture.events.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "review_index",
        "path": "review_index.json",
        "mime_type": "application/json",
        "type": "review_index",
        "producer": "workflow",
        "schema_version": "mn.architecture.review_index.v2",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "coverage",
        "path": "coverage.json",
        "mime_type": "application/json",
        "type": "coverage",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "evidence",
        "path": "evidence.json",
        "mime_type": "application/json",
        "type": "evidence",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "claims",
        "path": "claims.json",
        "mime_type": "application/json",
        "type": "claims",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "findings",
        "path": "findings.json",
        "mime_type": "application/json",
        "type": "findings",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "recommendations",
        "path": "recommendations.json",
        "mime_type": "application/json",
        "type": "recommendations",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "assumptions",
        "path": "assumptions.json",
        "mime_type": "application/json",
        "type": "assumptions",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "verification_tasks",
        "path": "verification_tasks.json",
        "mime_type": "application/json",
        "type": "verification_tasks",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "roadmap",
        "path": "roadmap.json",
        "mime_type": "application/json",
        "type": "roadmap",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "work_packages",
        "path": "work_packages.json",
        "mime_type": "application/json",
        "type": "work_packages",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "catalog_plan",
        "path": "catalog/plan.json",
        "mime_type": "application/json",
        "type": "catalog_plan",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "catalog_terminal",
        "path": "catalog/terminal.json",
        "mime_type": "application/json",
        "type": "catalog_terminal",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "sections",
        "path": "sections",
        "mime_type": "application/octet-stream",
        "type": "sections",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
      },
      {
        "artifact_id": "work_package_documents",
        "path": "work_packages",
        "mime_type": "application/octet-stream",
        "type": "work_package_documents",
        "producer": "workflow",
        "schema_version": "mn.architecture.catalog.v1",
        "privacy": "confidential",
        "required": true
      }
    ]
  },
  "privacy": {
    "classification": "confidential",
    "external_sharing": "disabled",
    "notes": "Frozen repository text and review artifacts are confidential. Bounded source excerpts are sent to the configured OpenCode model provider; public sharing is disabled. Source is never executed."
  }
}
