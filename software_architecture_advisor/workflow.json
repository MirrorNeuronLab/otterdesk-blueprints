{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/workflow.schema.json",
  "workflow_id": "software_architecture_advisor_v3",
  "steps": [
    {
      "id": "capture_repository",
      "kind": "source",
      "label": "Capture Repository",
      "goal": "Freeze source text and revision provenance.",
      "needs": [],
      "run": {
        "definition": "steps.capture_repository"
      },
      "control": {
        "timeout_seconds": 3600
      }
    },
    {
      "id": "analyze_dependency_structure",
      "kind": "stage",
      "label": "Analyze Dependency Structure",
      "goal": "Publish an evidence-linked dependency matrix, coupling measures, and static cycles.",
      "needs": [
        "capture_repository"
      ],
      "run": {
        "definition": "steps.analyze_dependency_structure"
      },
      "control": {
        "timeout_seconds": 3600
      }
    },
    {
      "id": "investigate_architecture",
      "kind": "stage",
      "label": "Investigate Architecture",
      "goal": "Review bounded source packets and all 150 report aspects, challenge conclusions, and admit evidence-driven follow-ups.",
      "needs": [
        "analyze_dependency_structure"
      ],
      "run": {
        "definition": "steps.investigate_architecture"
      },
      "control": {
        "timeout_seconds": 604800
      }
    },
    {
      "id": "publish_architecture_review",
      "kind": "sink",
      "label": "Publish Architecture Review",
      "goal": "Validate evidence and publish review drafts and follow-up tasks.",
      "needs": [
        "investigate_architecture"
      ],
      "run": {
        "definition": "steps.publish_architecture_review"
      },
      "control": {
        "timeout_seconds": 3600
      }
    }
  ],
  "defaults": {
    "step": {
      "control": {
        "failure_policy": "fail_workflow",
        "retry": {
          "max_attempts": 1
        }
      }
    }
  },
  "child_workflows": {
    "investigate_architecture": {
      "planner": "plan_architecture_round",
      "templates": {
        "plan_architecture_round": {
          "run": {
            "handler": "agents.architecture_planner"
          },
          "control": {
            "timeout_seconds": 300,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": []
          }
        },
        "review_architecture_packet": {
          "run": {
            "handler": "agents.architecture_packet_reviewer"
          },
          "control": {
            "timeout_seconds": 720,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        }
      },
      "inputs": {
        "context": [
          "outputs",
          "result",
          "context"
        ]
      },
      "outputs": {
        "result": []
      },
      "max_rounds": 20,
      "max_steps_per_round": 64
    }
  }
}
