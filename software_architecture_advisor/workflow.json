{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/workflow.schema.json",
  "workflow_id": "software_architecture_advisor_v2",
  "steps": [
    {
      "id": "capture_repository",
      "kind": "source",
      "label": "Capture Repository",
      "goal": "Freeze source text and revision provenance.",
      "needs": [],
      "run": {
        "definition": "steps.capture_repository"
      },
      "control": {
        "timeout_seconds": 3600
      }
    },
    {
      "id": "investigate_architecture",
      "kind": "stage",
      "label": "Investigate Architecture",
      "goal": "Test bounded hypotheses using graph and counter-evidence.",
      "needs": [
        "capture_repository"
      ],
      "run": {
        "definition": "steps.investigate_architecture"
      },
      "control": {
        "timeout_seconds": 3600
      }
    },
    {
      "id": "publish_architecture_review",
      "kind": "sink",
      "label": "Publish Architecture Review",
      "goal": "Validate evidence and publish review drafts and follow-up tasks.",
      "needs": [
        "investigate_architecture"
      ],
      "run": {
        "definition": "steps.publish_architecture_review"
      },
      "control": {
        "timeout_seconds": 3600
      }
    }
  ],
  "defaults": {
    "step": {
      "control": {
        "failure_policy": "fail_workflow",
        "retry": {
          "max_attempts": 1
        }
      }
    }
  },
  "child_workflows": {
    "investigate_architecture": {
      "planner": "plan_architecture_round",
      "templates": {
        "plan_architecture_round": {
          "run": {
            "handler": "agents.architecture_planner"
          },
          "control": {
            "timeout_seconds": 1200,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": []
          }
        },
        "query_architecture_graph": {
          "run": {
            "handler": "agents.architecture_graph_analyst"
          },
          "control": {
            "timeout_seconds": 300,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        },
        "search_architecture_evidence": {
          "run": {
            "handler": "agents.architecture_evidence_retriever"
          },
          "control": {
            "timeout_seconds": 300,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        },
        "assess_architecture_hypothesis": {
          "run": {
            "handler": "agents.architecture_hypothesis_assessor"
          },
          "control": {
            "timeout_seconds": 300,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        },
        "summarize_architecture_round": {
          "run": {
            "handler": "agents.architecture_round_reviewer"
          },
          "control": {
            "timeout_seconds": 300,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        }
      },
      "inputs": {
        "context": [
          "outputs",
          "result",
          "context"
        ]
      },
      "outputs": {
        "result": []
      },
      "max_rounds": 3,
      "max_steps_per_round": 25
    }
  }
}
