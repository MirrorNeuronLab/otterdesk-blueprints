{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/workflow.schema.json",
  "workflow_id": "software_architecture_advisor_v3",
  "steps": [
    {
      "id": "capture_repository",
      "kind": "source",
      "label": "Capture Repository",
      "goal": "Freeze source text and revision provenance.",
      "needs": [],
      "control": {
        "timeout_seconds": 3600
      }
    },
    {
      "id": "analyze_dependency_structure",
      "kind": "stage",
      "label": "Analyze Dependency Structure",
      "goal": "Publish an evidence-linked dependency matrix, coupling measures, and static cycles.",
      "needs": [
        "capture_repository"
      ],
      "control": {
        "timeout_seconds": 3600
      }
    },
    {
      "id": "investigate_architecture",
      "kind": "stage",
      "label": "Investigate Architecture",
      "goal": "Interpret the selected architecture aspects from precomputed source graphs, challenge conclusions, and admit bounded evidence-driven follow-ups.",
      "needs": [
        "analyze_dependency_structure"
      ],
      "control": {
        "timeout_seconds": 604800
      }
    },
    {
      "id": "publish_architecture_review",
      "kind": "sink",
      "label": "Publish Architecture Review",
      "goal": "Validate evidence and publish review drafts and follow-up tasks.",
      "needs": [
        "investigate_architecture"
      ],
      "control": {
        "timeout_seconds": 3600
      }
    }
  ],
  "defaults": {
    "step": {
      "control": {
        "failure_policy": "fail_workflow",
        "retry": {
          "max_attempts": 1
        }
      }
    }
  },
  "child_workflows": {
    "investigate_architecture": {
      "planner": "plan_architecture_round",
      "templates": {
        "plan_architecture_round": {
          "control": {
            "timeout_seconds": 3600,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": []
          }
        },
        "review_architecture_packet": {
          "run": {
            "handler": "mn_sdk.integrations.block_worker",
            "with": {
              "revision": "software_architecture_advisor@7.0.5",
              "instance": {
                "uses": "mn.blocks.domain_operation@1",
                "hooks": {
                  "operation": "domain.sandbox_review:review_admitted"
                },
                "input_schema": {
                  "type": "object",
                  "required": [
                    "review_input"
                  ]
                },
                "limits": {
                  "max_calls": 1,
                  "timeout_seconds": 720
                }
              }
            }
          },
          "control": {
            "timeout_seconds": 720,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        }
      },
      "inputs": {
        "seed": [
          "outputs",
          "result"
        ]
      },
      "outputs": {
        "result": [
          "result"
        ]
      },
      "max_rounds": 20,
      "max_steps_per_round": 64
    }
  }
}
