{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/extensions/blocks.schema.json",
  "steps": {
    "investigate_architecture": {
      "uses": "mn.blocks.bounded_investigation@1",
      "hooks": {
        "initialize": "domain.catalog_planning:initializer",
        "plan": "domain.catalog_planning:planner",
        "summarize": "domain.catalog_planning:summarize"
      },
      "inputs": {
        "repository_url": {
          "$ref": "run_input",
          "path": [
            "repository_url"
          ]
        },
        "input_folder": {
          "$ref": "run_input",
          "path": [
            "input_folder"
          ]
        },
        "goal": {
          "$ref": "run_input",
          "path": [
            "goal"
          ]
        },
        "graph_export": {
          "$ref": "run_input",
          "path": [
            "graph_export"
          ]
        },
        "output_folder": {
          "$ref": "run_input",
          "path": [
            "output_folder"
          ]
        },
        "review_file": {
          "$ref": "run_input",
          "path": [
            "review_file"
          ]
        },
        "previous": {
          "$ref": "upstream",
          "step_id": "analyze_dependency_structure"
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "status",
          "catalog"
        ],
        "properties": {
          "status": {
            "enum": [
              "partial",
              "review_draft"
            ]
          },
          "catalog": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "limits": {
        "max_calls": 1,
        "timeout_seconds": 604800
      }
    },
    "capture_repository": {
      "uses": "mn.blocks.domain_operation@1",
      "hooks": {
        "operation": "domain.intake:capture_input"
      },
      "inputs": {
        "goal": {
          "$ref": "run_input",
          "path": [
            "goal"
          ]
        },
        "graph_export": {
          "$ref": "run_input",
          "path": [
            "graph_export"
          ]
        },
        "input_folder": {
          "$ref": "run_input",
          "path": [
            "input_folder"
          ]
        },
        "output_folder": {
          "$ref": "run_input",
          "path": [
            "output_folder"
          ]
        },
        "repository_url": {
          "$ref": "run_input",
          "path": [
            "repository_url"
          ]
        },
        "review_file": {
          "$ref": "run_input",
          "path": [
            "review_file"
          ]
        }
      },
      "outputs": {
        "result": {
          "$ref": "flow_output",
          "path": [
            "result"
          ]
        }
      },
      "limits": {
        "max_calls": 1,
        "timeout_seconds": 3600
      }
    },
    "analyze_dependency_structure": {
      "uses": "mn.blocks.domain_operation@1",
      "hooks": {
        "operation": "domain.structural_analysis:analyze_snapshot"
      },
      "inputs": {
        "previous": {
          "$ref": "upstream",
          "step_id": "capture_repository"
        }
      },
      "outputs": {
        "result": {
          "$ref": "flow_output",
          "path": [
            "result"
          ]
        }
      },
      "limits": {
        "max_calls": 1,
        "timeout_seconds": 3600
      }
    },
    "publish_architecture_review": {
      "uses": "mn.blocks.domain_operation@1",
      "hooks": {
        "operation": "domain.catalog_publication:publish"
      },
      "inputs": {
        "goal": {
          "$ref": "run_input",
          "path": [
            "goal"
          ]
        },
        "graph_export": {
          "$ref": "run_input",
          "path": [
            "graph_export"
          ]
        },
        "input_folder": {
          "$ref": "run_input",
          "path": [
            "input_folder"
          ]
        },
        "output_folder": {
          "$ref": "run_input",
          "path": [
            "output_folder"
          ]
        },
        "previous": {
          "$ref": "upstream",
          "step_id": "investigate_architecture"
        },
        "repository_url": {
          "$ref": "run_input",
          "path": [
            "repository_url"
          ]
        },
        "review_file": {
          "$ref": "run_input",
          "path": [
            "review_file"
          ]
        }
      },
      "outputs": {
        "result": {
          "$ref": "flow_output",
          "path": [
            "result"
          ]
        }
      },
      "limits": {
        "max_calls": 1,
        "timeout_seconds": 3600
      }
    }
  }
}
