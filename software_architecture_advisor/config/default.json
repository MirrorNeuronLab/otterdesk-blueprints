{
  "llm": {
    "context_tokens": 16384,
    "output_tokens": 3000,
    "timeout_seconds": 60,
    "max_calls": 30,
    "structured_output": "json_schema"
  },
  "embedding": {
    "mode": "neural",
    "provider": "litellm_proxy",
    "model": "docker.io/ai/embeddinggemma:latest",
    "api_base": null
  },
  "graph": {
    "binary": "rgx",
    "timeout_seconds": 15,
    "row_limit": 20
  },
  "analysis": {
    "max_dsm_modules": 300
  },
  "investigation": {
    "max_hypotheses": 3,
    "top_k": 3,
    "max_queries": 60,
    "max_rounds": 3,
    "max_distinct_hypotheses": 6,
    "timeout_seconds": 1200,
    "final_model_reserve": 6
  },
  "ingest": {
    "source_roots": [
      "src",
      "."
    ],
    "max_files": 5000,
    "max_file_bytes": 500000,
    "max_total_bytes": 20000000,
    "chunk_chars": 650,
    "git_commits": 200,
    "exclude": [
      ".git",
      ".venv",
      "venv",
      "node_modules",
      "__pycache__",
      "target",
      "dist",
      "build",
      ".advisor"
    ],
    "layers": {
      "controller": [
        "*controller*",
        "*routes*",
        "*views*"
      ],
      "domain": [
        "*domain*"
      ],
      "infrastructure": [
        "*repository*",
        "*infra*"
      ]
    }
  },
  "lazy": {
    "lock_timeout_seconds": 120,
    "max_layer_nodes": 200000,
    "max_layer_edges": 400000
  },
  "source": {
    "clone_timeout_seconds": 180
  },
  "knowledge": {
    "enabled": true,
    "path": null,
    "max_cards": 2,
    "max_prompt_bytes": 1200
  },
  "inputs": {
    "adapter": "json",
    "payload": {
      "repository_url": "https://github.com/homerquan/Archmind",
      "goal": "Review architecture across the 150 report aspects; identify evidence-backed findings, counterevidence, unknowns, prioritized recommendations, and bounded proposed implementation tasks."
    }
  },
  "outputs": {
    "adapter": "local_run_store",
    "artifact_contract": "Read-only architecture review, evidence audit, and copy-ready implementation prompts; no source changes.",
    "folder_path": "~/Downloads/architecture-advisor",
    "run_root": "~/.mn/runs",
    "write_run_store": true
  },
  "offline": false,
  "skill_runtime": {
    "enabled": true,
    "driver": "docker_worker",
    "docker_worker_image": "docker_worker",
    "image": "mirror-neuron/software-architecture-advisor:local",
    "install_scope": "shared_job_container"
  },
  "local_inputs": {
    "folders": [
      {
        "config_path": "inputs.payload.input_folder",
        "payload_path": "mn_local_inputs/repository",
        "runtime_path": "mn_local_inputs/repository",
        "allowed_extensions": [
          "*"
        ]
      }
    ]
  },
  "context_memory": {
    "enabled": false,
    "contract": "mn.context.working.v1"
  },
  "catalog_review": {
    "max_tasks": 1024,
    "max_rounds": 20,
    "tasks_per_round": 64,
    "chunk_bytes": 24000,
    "prompt_bytes": 60000,
    "max_calls": 1024,
    "walltime_seconds": 604800,
    "max_followups": 64
  },
  "opencode": {
    "model": "opencode/muse-spark-1.3-contributor-free",
    "timeout_seconds": 600,
    "max_output_bytes": 1048576,
    "sandbox_root": "/sandbox/job",
    "spark_base_url": "http://10.0.4.32:8000/v1"
  },
  "file_memory": {
    "enabled": true,
    "max_results": 3,
    "read_lines": 24,
    "max_context_bytes": 4000,
    "max_note_bytes": 6000
  }
}
