{
  "llm": {
    "context_tokens": 16384,
    "output_tokens": 3000,
    "timeout_seconds": 60,
    "max_calls": 30,
    "structured_output": "json_schema"
  },
  "embedding": {
    "mode": "neural",
    "provider": "docker_model_runner",
    "model": "default",
    "api_base": null
  },
  "graph": {
    "binary": "rgx",
    "timeout_seconds": 15,
    "row_limit": 20
  },
  "investigation": {
    "max_hypotheses": 3,
    "top_k": 3,
    "max_queries": 60,
    "max_rounds": 3,
    "max_distinct_hypotheses": 6,
    "timeout_seconds": 1200,
    "final_model_reserve": 6
  },
  "ingest": {
    "source_roots": [
      "src",
      "."
    ],
    "max_files": 5000,
    "max_file_bytes": 500000,
    "max_total_bytes": 20000000,
    "chunk_chars": 650,
    "git_commits": 200,
    "exclude": [
      ".git",
      ".venv",
      "venv",
      "node_modules",
      "__pycache__",
      "target",
      "dist",
      "build",
      ".advisor"
    ],
    "layers": {
      "controller": [
        "*controller*",
        "*routes*",
        "*views*"
      ],
      "domain": [
        "*domain*"
      ],
      "infrastructure": [
        "*repository*",
        "*infra*"
      ]
    }
  },
  "lazy": {
    "lock_timeout_seconds": 120,
    "max_layer_nodes": 200000,
    "max_layer_edges": 400000
  },
  "source": {
    "clone_timeout_seconds": 180
  },
  "knowledge": {
    "enabled": true,
    "path": null,
    "max_cards": 2,
    "max_prompt_bytes": 1200
  },
  "inputs": {
    "adapter": "json",
    "payload": {
      "goal": "Inspect the software architecture, identify an actionable boundary or coupling concern, and check counter-evidence before recommending a change."
    }
  },
  "output_folder": "~/Downloads/software_architecture_advisor",
  "offline": false,
  "skill_runtime": {
    "enabled": true,
    "driver": "docker_worker",
    "docker_worker_image": "docker_worker",
    "image": "mirror-neuron/software-architecture-advisor:local",
    "install_scope": "shared_job_container"
  }
}
