{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/execution.schema.json",
  "mode": "compiled",
  "job_name": "software-architecture-advisor",
  "agents": {
    "registry": {
      "repository_examiner": {
        "handler": "agents.repository_examiner",
        "role": "Repository Examiner"
      },
      "architecture_investigator": {
        "handler": "agents.architecture_investigator",
        "role": "Architecture Investigator"
      },
      "architecture_review_editor": {
        "handler": "agents.architecture_review_editor",
        "role": "Architecture Review Editor"
      },
      "architecture_planner": {
        "handler": "agents.architecture_planner",
        "role": "Architecture Planner"
      },
      "architecture_graph_analyst": {
        "handler": "agents.architecture_graph_analyst",
        "role": "Architecture Graph Analyst"
      },
      "architecture_evidence_retriever": {
        "handler": "agents.architecture_evidence_retriever",
        "role": "Architecture Evidence Retriever"
      },
      "architecture_hypothesis_assessor": {
        "handler": "agents.architecture_hypothesis_assessor",
        "role": "Architecture Hypothesis Assessor"
      },
      "architecture_round_reviewer": {
        "handler": "agents.architecture_round_reviewer",
        "role": "Architecture Round Reviewer"
      }
    }
  },
  "requirements": {
    "cpu": {
      "min_cores": 2
    },
    "memory": {
      "min_gb": 4
    },
    "disk": {
      "min_gb": 8
    },
    "network": {
      "egress": "Public GitHub for URL inputs; configured model and embedding providers for live analysis"
    }
  },
  "workers": {
    "groups": [
      {
        "steps": [
          "capture_repository",
          "investigate_architecture",
          "publish_architecture_review",
          "plan_architecture_round",
          "query_architecture_graph",
          "search_architecture_evidence",
          "assess_architecture_hypothesis",
          "summarize_architecture_round"
        ],
        "uses": "mn-agents.worker.python_docker@1",
        "with": {
          "stereotype": [
            "blueprint_docker_worker",
            "internal_write_worker"
          ],
          "docker_worker_image": "docker_worker",
          "image": "mirror-neuron/software-architecture-advisor:local",
          "dockerfile": "docker_worker/Dockerfile",
          "build_context": ".",
          "workdir": "/app",
          "timeout_seconds": 3600,
          "upload_paths": [
            {
              "source": "domain",
              "target": "domain"
            },
            {
              "source": "agents",
              "target": "agents"
            },
            {
              "source": "steps",
              "target": "steps"
            },
            {
              "source": "runtime",
              "target": "runtime"
            },
            {
              "source": "knowledge",
              "target": "knowledge"
            }
          ]
        }
      }
    ]
  },
  "required_context_engine": true
}
