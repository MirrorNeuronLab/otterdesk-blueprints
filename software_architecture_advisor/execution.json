{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/execution.schema.json",
  "mode": "compiled",
  "job_name": "architecture-advisor",
  "agents": {
    "registry": {
      "repository_examiner": {
        "handler": "agents.repository_examiner",
        "role": "Repository Examiner"
      },
      "architecture_structure_analyst": {
        "handler": "agents.architecture_structure_analyst",
        "role": "Architecture Structure Analyst"
      },
      "architecture_investigator": {
        "handler": "agents.architecture_investigator",
        "role": "Architecture Investigator"
      },
      "architecture_review_editor": {
        "handler": "agents.architecture_review_editor",
        "role": "Architecture Review Editor"
      },
      "architecture_planner": {
        "handler": "agents.architecture_planner",
        "role": "Architecture Planner"
      },
      "architecture_packet_reviewer": {
        "handler": "agents.architecture_packet_reviewer",
        "role": "Architecture Packet Reviewer"
      }
    }
  },
  "requirements": {
    "cpu": {
      "min_cores": 2
    },
    "memory": {
      "min_gb": 4
    },
    "disk": {
      "min_gb": 8
    },
    "network": {
      "egress": "Public GitHub for URL acquisition; OpenCode Zen opencode.ai:443 or Local Spark 10.0.4.32:8000 for the selected review model."
    }
  },
  "workers": {
    "groups": [
      {
        "steps": [
          "capture_repository",
          "analyze_dependency_structure",
          "investigate_architecture",
          "publish_architecture_review",
          "plan_architecture_round"
        ],
        "uses": "mn-agents.worker.python_docker@1",
        "with": {
          "stereotype": [
            "blueprint_docker_worker",
            "internal_write_worker"
          ],
          "docker_worker_image": "docker_worker",
          "image": "mirror-neuron/software-architecture-advisor:local",
          "dockerfile": "docker_worker/Dockerfile",
          "build_context": ".",
          "workdir": "/app",
          "timeout_seconds": 3600,
          "upload_paths": [
            {
              "source": "domain",
              "target": "domain"
            },
            {
              "source": "agents",
              "target": "agents"
            },
            {
              "source": "steps",
              "target": "steps"
            },
            {
              "source": "runtime",
              "target": "runtime"
            },
            {
              "source": "knowledge",
              "target": "knowledge"
            },
            {
              "source": "report_specs",
              "target": "report_specs"
            }
          ]
        }
      },
      {
        "steps": [
          "review_architecture_packet"
        ],
        "uses": "mn-agents.worker.python_host@1",
        "with": {
          "command": [
            "python3",
            "-m",
            "mn_sdk.step_runtime"
          ],
          "upload_path": "runtime",
          "upload_as": "runtime",
          "workdir": "/sandbox/job",
          "runner_module": "MirrorNeuron.Runner.OpenShell",
          "from": "openshell_worker",
          "policy": "openshell_worker/policy.yaml",
          "sandbox_upload_path": "/sandbox/job",
          "reuse_shared_sandbox": true,
          "no_auto_providers": true,
          "no_keep": true,
          "timeout_seconds": 720,
          "max_attempts": 1,
          "safe_to_retry": false,
          "idempotent": true,
          "side_effect": "network_read",
          "upload_paths": [
            {
              "source": "domain",
              "target": "domain"
            },
            {
              "source": "agents",
              "target": "agents"
            },
            {
              "source": "steps",
              "target": "steps"
            },
            {
              "source": "runtime",
              "target": "runtime"
            },
            {
              "source": "report_specs",
              "target": "report_specs"
            }
          ],
          "environment": {
            "PYTHONPATH": ".",
            "OPENCODE_DISABLE_MODELS_FETCH": "true"
          },
          "stereotype": [
            "blueprint_host_worker"
          ],
          "custom_openshell_image": "openshell_worker",
          "artifact_handoff": {
            "version": "mn.artifact_handoff/v1",
            "max_files": 16,
            "max_bytes": 8000000
          }
        }
      }
    ]
  },
  "required_context_engine": false
}
