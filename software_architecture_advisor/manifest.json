{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/manifest.schema.json",
  "id": "software_architecture_advisor",
  "name": "Architecture Advisor",
  "version": "3.5.0",
  "description": "Reviews large codebases in bounded OpenCode tasks inside OpenShell, checks counterevidence, and publishes a traceable 23-section architecture report with explicit coverage and proposed work packages.",
  "workflow": "workflow.json",
  "execution": "execution.json",
  "contracts": "contracts.json",
  "config": "config/default.json",
  "dependencies": "dependencies.json",
  "license": "LICENSE.md",
  "terms": "TERM.md",
  "extensions": {
    "mn.domain": {
      "file": "extensions/domain.json",
      "required": true
    },
    "mn.product": {
      "file": "extensions/product.json",
      "required": false
    },
    "mn.response": {
      "file": "extensions/response.json",
      "required": true
    },
    "mn.llm": {
      "file": "extensions/llm.json",
      "required": true
    },
    "mn.ui": {
      "file": "extensions/ui.json",
      "required": false
    },
    "mn.context": {
      "file": "extensions/context.json",
      "required": true
    }
  }
}
