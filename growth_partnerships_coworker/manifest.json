{
  "apiVersion": "mn.workflow/v1",
  "kind": "WorkflowSource",
  "standard": {
    "profile": "blueprint",
    "source_schema": "mn.workflow/v1",
    "target_schema": "mn.workflow/v1",
    "migration_policy": "sdk_managed"
  },
  "identity": {
    "id": "growth_partnerships_coworker",
    "name": "Growth & Partnerships Co-worker",
    "job_name": "growth-partnerships-coworker",
    "category": "business",
    "version": 1,
    "manifest_version": "2.0"
  },
  "description": "A generic Growth & Partnerships co-worker that qualifies approved contacts, designs relevance-first demand tests, and can deliver one explicitly approved development SMTP test without exposing contact details through MCP.",
  "intent": {
    "description": "Growth and Partnerships Lead serving a configurable business-success goal; the bundled demo applies the role to Bibblio.",
    "problem": "Early-stage businesses need a repeatable path to qualified customers and partners without optimizing for spam, unqualified volume, or unaffordable acquisition.",
    "target_users": "Founders and designated growth, partnership, privacy, brand, and legal reviewers.",
    "safety": {
      "enabled": true,
      "mode": "approval_required",
      "allowed_decisions": [
        "approve",
        "revise",
        "reject"
      ],
      "blocked_actions": [
        "send_external_communications_without_explicit_approval",
        "send_bulk_external_communications_in_development",
        "publish_child_facing_content",
        "spend_money_or_launch_paid_campaigns",
        "change_pricing_or_subscription_terms",
        "make_learning_medical_or_therapeutic_claims",
        "change_child_or_family_data_collection"
      ],
      "default_action": "reject",
      "timeout_seconds": 86400,
      "reason": "The co-worker observes, analyzes, drafts, and queues. SMTP is disabled by default; a designated human must explicitly approve the single-recipient development delivery."
    }
  },
  "config": {
    "default": "config/default.json",
    "embed": true,
    "manifest_defaults": [
      "llm",
      "knowledge_rag",
      {
        "from": "requirements",
        "to": "resources"
      },
      {
        "from": "workflow.policy.human",
        "to": "human_control"
      },
      {
        "from": "identity.id",
        "to": "identity.blueprint_id"
      },
      {
        "from": "identity.name",
        "to": "identity.name"
      }
    ]
  },
  "defaults": {
    "worker": {
      "with": {
        "stereotype": "internal_write_worker",
        "image": "mirror-neuron/growth-partnerships-coworker:local",
        "upload_paths": [
          {
            "source": "domain",
            "target": "domain"
          }
        ]
      }
    }
  },
  "workers": {
    "groups": [
      {
        "steps": [
          "deliver_approved_email"
        ],
        "with": {
          "side_effect": "external",
          "pass_env": [
            "MN_SMTP_USERNAME",
            "MN_SMTP_PASSWORD",
            "MN_SMTP_DEV_RECIPIENT"
          ]
        }
      }
    ]
  },
  "contracts": {
    "input_adapters": {
      "default": "mock",
      "resolved_artifact": "inputs.json",
      "supported": [
        "mock",
        "json",
        "file",
        "env_json"
      ]
    },
    "inputs": {
      "business_name": {
        "type": "domain_value",
        "required": false,
        "privacy": "internal",
        "description": "Business name used to contextualize role outputs. The bundled demo defaults to Bibblio.",
        "example": "Bibblio"
      },
      "business_goal": {
        "type": "domain_value",
        "required": false,
        "privacy": "internal",
        "description": "Shared business goal served by the independently launched co-workers.",
        "example": "Build a successful business for Bibblio."
      },
      "goal_id": {
        "type": "domain_value",
        "required": false,
        "privacy": "internal",
        "description": "Stable goal identity used for explicit MCP peer collaboration.",
        "example": "bibblio-business-success"
      },
      "planning_horizon_days": {
        "type": "domain_value",
        "required": false,
        "privacy": "internal",
        "description": "Founder-facing planning horizon, bounded from 30 to 365 days.",
        "example": 90
      },
      "input_folder": {
        "type": "local_path",
        "path_kind": "directory",
        "required": false,
        "privacy": "confidential",
        "description": "Local folder containing this co-worker's focused input file.",
        "example": "@/examples/sample_inputs"
      },
      "output_folder": {
        "type": "local_path",
        "path_kind": "directory",
        "required": false,
        "privacy": "confidential",
        "description": "Local folder for review-ready artifacts.",
        "example": "~/Downloads/bibblio"
      },
      "contacts_csv": {
        "type": "local_path",
        "path_kind": "file",
        "required": false,
        "privacy": "confidential",
        "description": "Approved confidential CSV with Name, Email, Category, Note, and Highlight columns.",
        "example": "@/examples/sample_inputs/edtech_contacts_sample.csv"
      },
      "email_send_approval": {
        "type": "domain_value",
        "required": false,
        "privacy": "confidential",
        "description": "Explicit development-send decision. Delivery requires approved=true and a bounded approval_id; omission keeps SMTP disabled.",
        "example": {
          "approved": false
        }
      }
    },
    "outputs": {
      "primary": {
        "id": "final_artifact",
        "type": "final_artifact",
        "path": "final_artifact.json",
        "schema_version": "mn.blueprint.final_artifact_contract.v1",
        "required_fields": [
          "type",
          "business_name",
          "business_goal",
          "worker_role",
          "role_contribution",
          "north_star_question",
          "role_scorecard",
          "founder_decisions",
          "executive_summary",
          "recommended_action",
          "confidence",
          "evidence",
          "next_steps",
          "ninety_day_plan",
          "cross_functional_handoffs",
          "source_refs",
          "job_context"
        ]
      },
      "artifacts": [
        {
          "artifact_id": "final_artifact",
          "type": "final_artifact",
          "path": "final_artifact.json",
          "producer": "growth_partnerships_lead",
          "mime_type": "application/json",
          "schema_version": "mn.blueprint.final_artifact.v1",
          "source_refs": [
            "inputs.json",
            "workflow_state/work_packets"
          ]
        },
        {
          "artifact_id": "growth_partnerships_packet",
          "type": "growth_partnerships_operating_brief",
          "path": "growth_partnerships_packet.json",
          "producer": "growth_partnerships_lead",
          "mime_type": "application/json",
          "schema_version": "mn.business_success.role_brief.v1",
          "source_refs": [
            "inputs.json",
            "workflow_state/work_packets"
          ]
        },
        {
          "artifact_id": "email_delivery_receipt",
          "type": "confidential_email_delivery_receipt",
          "path": "confidential_email_delivery_receipt.json",
          "producer": "growth_partnerships_lead",
          "mime_type": "application/json",
          "schema_version": "mn.business_growth.email_delivery_receipt.v1",
          "source_refs": [
            "confidential_outreach_queue.json",
            "inputs.json"
          ]
        }
      ]
    },
    "status": {
      "event": "blueprint_status",
      "heartbeat": true,
      "phases": [
        "loading_inputs",
        "running_worker",
        "waiting_for_human",
        "writing_artifacts",
        "completed"
      ]
    },
    "privacy": {
      "default_classification": "confidential"
    }
  },
  "agents": {
    "registry": {
      "growth_partnerships_lead": {
        "handler": "agents.growth_partnerships_lead",
        "role": "Growth and Partnerships Lead"
      }
    }
  },
  "llm": {
    "enabled": true,
    "mode": "actor_assisted",
    "mock_mode": "deterministic",
    "provider": "docker_model_runner",
    "model": "small",
    "runtime_model": "small",
    "backend": "llama.cpp",
    "default_config": "primary",
    "configs": {
      "primary": {
        "provider": "docker_model_runner",
        "model": "small",
        "runtime_model": "small",
        "backend": "llama.cpp",
        "temperature": 0.2,
        "max_tokens": 2400
      }
    },
    "responsibilities": [
      "Separate observed facts from assumptions.",
      "Preserve source references and name missing evidence.",
      "Draft review-ready recommendations and execute only an explicitly approved, development-only SMTP test."
    ],
    "agents": {
      "growth_partnerships_lead": {
        "llm_config": "primary",
        "role": "Growth and Partnerships Lead",
        "responsibilities": [
          "Qualify adult professional seed contacts by relevance and evidence.",
          "Draft customer- and partner-facing outreach without unsupported product or outcome claims.",
          "Keep SMTP disabled by default; allow only one explicitly approved development test recipient per run."
        ]
      }
    }
  },
  "response_service": {
    "enabled": true
  },
  "knowledge_rag": {
    "chunk_overlap": 80,
    "chunk_size": 800,
    "enabled": true,
    "index_on_startup": true,
    "knowledge_dir": "@/payloads/knowledge",
    "max_context_chars": 6000,
    "namespace": "",
    "required": true,
    "top_k": 5
  },
  "requirements": {
    "cpu": {
      "min_cores": 1
    },
    "memory": {
      "min_gb": 1
    },
    "disk": {
      "min_gb": 1
    },
    "gpu": {
      "min_count": 0
    }
  },
  "metadata": {
    "blueprint_id": "growth_partnerships_coworker",
    "runtime_features": [
      "confidential seed contact intake",
      "approval-gated development SMTP delivery",
      "MCP-safe aggregate work packets",
      "human send approval"
    ],
    "collaboration_group": "business-success-team",
    "business_goal": "Build a successful business for Bibblio.",
    "job_data": {
      "resources": [
        {
          "name": "knowledge",
          "path": "knowledge",
          "access": "read_write",
          "seed": "@/payloads/knowledge"
        },
        {
          "name": "rag",
          "path": "databases/rag",
          "access": "read_write"
        },
        {
          "name": "state",
          "path": "state",
          "access": "read_write"
        }
      ]
    }
  },
  "workflow": {
    "workflow_id": "growth_partnerships_coworker_v2",
    "execution": {
      "strategy": "serial"
    },
    "policy": {
      "failure": {
        "default": "fail_closed"
      },
      "human": {
        "enabled": true,
        "mode": "approval_required",
        "allowed_decisions": [
          "approve",
          "revise",
          "reject"
        ],
        "blocked_actions": [
          "send_external_communications_without_explicit_approval",
          "send_bulk_external_communications_in_development",
          "publish_child_facing_content",
          "spend_money",
          "change_pricing",
          "change_data_collection"
        ],
        "default_action": "reject",
        "timeout_seconds": 86400
      }
    },
    "steps": [
      {
        "id": "qualify_seed_contacts",
        "kind": "source",
        "label": "Qualify Seed Contacts",
        "goal": "Research and rank approved adult professional seed contacts while keeping identities in a confidential artifact.",
        "needs": [],
        "run": {
          "definition": "steps.qualify_seed_contacts"
        },
        "control": {
          "required": true,
          "timeout_seconds": 900,
          "failure_policy": "fail_workflow",
          "retry": {
            "max_attempts": 2,
            "backoff_seconds": 1,
            "backoff_multiplier": 2,
            "jitter": 0
          },
          "uncertainty": {
            "min_confidence": 0,
            "on_low_confidence": "continue_with_warning"
          }
        }
      },
      {
        "id": "publish_gtm_outreach_queue",
        "kind": "transform",
        "label": "Publish GTM Outreach Queue",
        "goal": "Publish an MCP-safe aggregate GTM decision packet and a local draft-only outreach queue.",
        "needs": [
          "qualify_seed_contacts"
        ],
        "run": {
          "definition": "steps.publish_gtm_outreach_queue"
        },
        "control": {
          "required": true,
          "timeout_seconds": 900,
          "failure_policy": "fail_workflow",
          "retry": {
            "max_attempts": 2,
            "backoff_seconds": 1,
            "backoff_multiplier": 2,
            "jitter": 0
          },
          "uncertainty": {
            "min_confidence": 0,
            "on_low_confidence": "continue_with_warning"
          }
        }
      },
      {
        "id": "deliver_approved_email",
        "kind": "sink",
        "label": "Deliver Approved Development Email",
        "goal": "Fail closed unless one development SMTP message has explicit approval and a secret-injected single test recipient.",
        "needs": [
          "publish_gtm_outreach_queue"
        ],
        "run": {
          "definition": "steps.deliver_approved_email"
        },
        "control": {
          "required": true,
          "timeout_seconds": 60,
          "failure_policy": "fail_workflow",
          "retry": {
            "max_attempts": 1,
            "backoff_seconds": 0,
            "backoff_multiplier": 1,
            "jitter": 0
          },
          "uncertainty": {
            "min_confidence": 0,
            "on_low_confidence": "continue_with_warning"
          }
        }
      }
    ]
  },
  "skill_dependencies": [
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-email-delivery-skill",
      "version": "1.2.31"
    },
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-goal-work-packet-skill",
      "version": "1.2.31"
    },
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-marketing-email-skill",
      "version": "1.2.31"
    },
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-market-research-skill",
      "version": "1.2.31"
    },
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-rag-skill",
      "version": "1.2.31"
    },
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-job-response-skill",
      "version": "1.2.31"
    }
  ],
  "agent_dependencies": [
    {
      "type": "pip",
      "source": "gar",
      "name": "mn-prototype-stateful-step-agent",
      "version": "1.2.31"
    }
  ]
}
