{
  "inputs": {
    "adapter": "mock",
    "description": "Synthetic Bibblio demo input for the generic Growth & Partnerships Co-worker.",
    "payload": {
      "business_name": "Bibblio",
      "business_goal": "Build a successful business for Bibblio.",
      "goal_id": "bibblio-business-success",
      "planning_horizon_days": 90,
      "input_folder": "@/examples/sample_inputs",
      "contacts_csv": "@/examples/sample_inputs/edtech_contacts_sample.csv",
      "output_folder": "~/Downloads/growth_partnerships_coworker",
      "email_send_approval": {
        "approved": false
      }
    }
  },
  "outputs": {
    "folder_path": "~/Downloads/growth_partnerships_coworker",
    "write_run_store": true
  },
  "execution": {
    "quick_test": true
  },
  "capabilities": {
    "required": [
      "filesystem.write"
    ],
    "optional": [
      "network.egress"
    ]
  },
  "llm": {
    "mode": "fake",
    "require_live": false
  },
  "knowledge_rag": {
    "backend": "milvus_lite"
  },
  "privacy": {
    "default_classification": "confidential",
    "child_data_export": "blocked",
    "external_communications": "approval_required",
    "minimum_data": true
  },
  "gtm": {
    "max_contacts_per_run": 100,
    "outreach_mode": "draft_only",
    "max_initial_pilot_contacts": 10
  },
  "smtp_delivery": {
    "enabled": false,
    "mode": "development",
    "host": "smtp.mail.me.com",
    "port": 587,
    "security": "starttls",
    "timeout_seconds": 10,
    "max_messages_per_run": 1
  }
}
