{
  "inputs": {
    "adapter": "mock",
    "description": "Synthetic focused input for Bibblio Content Studio Co-worker.",
    "payload": {
      "business_goal": "Turn Bibblio into a profitable business.",
      "goal_id": "bibblio-profitable-business",
      "input_folder": "@/examples/sample_inputs",
      "learning_briefs_file": "@/examples/sample_inputs/approved_learning_briefs.json",
      "output_folder": "~/Downloads/bibblio_content_studio_coworker",
      "peer_mcp_servers": []
    }
  },
  "outputs": {
    "folder_path": "~/Downloads/bibblio_content_studio_coworker",
    "write_run_store": true
  },
  "execution": {
    "quick_test": true
  },
  "llm": {
    "mode": "fake",
    "require_live": false
  },
  "mcp_collaboration": {
    "chat_grace_seconds": 8,
    "publish_local_exchange": true,
    "peer_reads_enabled": false
  },
  "privacy": {
    "default_classification": "confidential",
    "child_data_export": "blocked",
    "external_communications": "approval_required",
    "minimum_data": true
  },
  "content_studio": {
    "max_packages_per_batch": 5,
    "publication_authorized": false
  }
}
