{
  "inputs": {
    "adapter": "mock",
    "description": "Synthetic Bibblio demo input for the generic Content Studio Co-worker.",
    "payload": {
      "business_name": "Bibblio",
      "business_goal": "Build a successful business for Bibblio.",
      "goal_id": "bibblio-business-success",
      "planning_horizon_days": 90,
      "input_folder": "@/examples/sample_inputs",
      "learning_briefs_file": "@/examples/sample_inputs/approved_learning_briefs.json",
      "output_folder": "~/Downloads/content_studio_coworker"
    }
  },
  "outputs": {
    "folder_path": "~/Downloads/content_studio_coworker",
    "write_run_store": true
  },
  "execution": {
    "quick_test": true
  },
  "llm": {
    "mode": "fake",
    "require_live": false
  },
  "knowledge_rag": {
    "backend": "milvus_lite"
  },
  "privacy": {
    "default_classification": "confidential",
    "child_data_export": "blocked",
    "external_communications": "approval_required",
    "minimum_data": true
  },
  "content_studio": {
    "max_packages_per_batch": 5,
    "publication_authorized": false
  }
}
