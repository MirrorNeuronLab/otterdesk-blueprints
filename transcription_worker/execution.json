{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/execution.schema.json",
  "agents": {
    "registry": {}
  },
  "defaults": {
    "worker": {
      "uses": "mn-agents.worker.python_docker@1",
      "with": {
        "build_context": ".",
        "docker_worker_image": "docker_worker",
        "dockerfile": "docker_worker/Dockerfile",
        "image": "mirror-neuron/nvidia-transcribe-worker:0.1.0",
        "stereotype": [
          "blueprint_docker_worker",
          "internal_write_worker"
        ],
        "timeout_seconds": 3600,
        "upload_paths": [
          {
            "source": "domain",
            "target": "domain"
          }
        ],
        "workdir": "/app"
      }
    }
  },
  "job_name": "transcription-worker",
  "mode": "compiled",
  "requirements": {
    "cpu": {
      "min_cores": 8
    },
    "disk": {
      "min_gb": 100
    },
    "gpu": {
      "driver": "cuda",
      "enforcement": "hard",
      "memory_operator": ">=",
      "min_count": 1,
      "min_memory_mb": 98304,
      "vendor": "nvidia"
    },
    "memory": {
      "min_gb": 16
    },
    "network": {
      "egress": "Registry images and pinned Hugging Face model download on first use; audio stays on the managed node."
    },
    "os": "linux"
  },
  "runtime": {
    "models": {
      "transcribe": {
        "backend": "vllm",
        "model": "nvidia-nemotron-3.5-transcribe-nvfp4:0.2.1",
        "model_spec": {
          "api_model": "nvidia/NVIDIA-Nemotron-3.5-Transcribe-30B-A4B-NVFP4",
          "backend": "vllm",
          "backends": [
            "vllm"
          ],
          "context_size": 65536,
          "docker": {
            "api_path": "/v1",
            "cache_path": "/cache",
            "container_port": 8000,
            "environment": {
              "DO_NOT_TRACK": "1",
              "FLASHINFER_NVCC_THREADS": "1",
              "FLASHINFER_WORKSPACE_BASE": "/cache/flashinfer",
              "HF_HOME": "/cache/huggingface",
              "HF_HUB_DISABLE_TELEMETRY": "1",
              "MAX_JOBS": "4",
              "TORCHINDUCTOR_CACHE_DIR": "/cache/torchinductor",
              "TRITON_CACHE_DIR": "/cache/triton",
              "VLLM_CACHE_ROOT": "/cache/vllm"
            },
            "gpus": "all",
            "image": "docker.io/homerquan/nvidia-transcribe@sha256:7d9b181d9c219b156ab1f514f5fdc2327e1915d7ff96b5537ea72099e3d0e957",
            "port": 30085,
            "ready_path": "/health",
            "ready_timeout": 3600,
            "shm_size": "16g"
          },
          "id": "nvidia-nemotron-3.5-transcribe-nvfp4:0.2.1",
          "input_modalities": [
            "audio",
            "text"
          ],
          "model": "nvidia-nemotron-3.5-transcribe-nvfp4:0.2.1",
          "model_type": "audio",
          "name": "NVIDIA Nemotron 3.5 Transcribe NVFP4",
          "protocol": "openai",
          "provider": "docker_model_runner",
          "requirements": {
            "min_vram_gb": 96,
            "required_capabilities": [
              "cuda"
            ]
          },
          "source": "docker"
        },
        "provider": "docker_model_runner",
        "required": true,
        "type": "inference"
      }
    }
  },
  "type": "batch"
}
