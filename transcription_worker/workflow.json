{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/workflow.schema.json",
  "execution": {
    "max_parallel_steps": 1,
    "strategy": "serial"
  },
  "mode": "static_dag",
  "steps": [
    {
      "control": {
        "retry": {
          "max_attempts": 1
        },
        "timeout_seconds": 3600
      },
      "goal": "Find supported recordings in the selected folder and capture them for this run.",
      "id": "scan_audio_folder",
      "kind": "source",
      "label": "Scan audio folder",
      "needs": []
    },
    {
      "control": {
        "retry": {
          "max_attempts": 1
        },
        "timeout_seconds": 3600
      },
      "goal": "Convert the recordings to a consistent audio format and split them into sections for transcription.",
      "id": "prepare_recordings",
      "kind": "stage",
      "label": "Prepare recordings",
      "needs": [
        "scan_audio_folder"
      ]
    },
    {
      "control": {
        "retry": {
          "max_attempts": 1
        },
        "timeout_seconds": 3600
      },
      "goal": "Transcribe every recording and save the transcripts.",
      "id": "transcribe_audio_folder",
      "kind": "stage",
      "label": "Transcribe recordings",
      "needs": [
        "prepare_recordings"
      ]
    }
  ],
  "workflow_id": "transcription_worker_v1"
}
