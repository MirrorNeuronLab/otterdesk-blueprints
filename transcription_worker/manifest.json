{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/manifest.schema.json",
  "config": "config/default.json",
  "contracts": "contracts.json",
  "dependencies": "dependencies.json",
  "description": "Transcribe complete local audio with NVIDIA Nemotron 3.5 NVFP4 and review finished transcripts with synchronized audio and anonymous speakers.",
  "execution": "execution.json",
  "extensions": {
    "mn.blocks": {
      "file": "extensions/blocks.json",
      "required": true
    },
    "mn.context": {
      "file": "extensions/context.json",
      "required": true
    },
    "mn.mcp": {
      "file": "extensions/mcp.json",
      "required": true
    },
    "mn.product": {
      "file": "extensions/product.json",
      "required": false
    },
    "mn.rag": {
      "file": "extensions/rag.json",
      "required": true
    },
    "mn.response": {
      "file": "extensions/response.json",
      "required": true
    },
    "mn.ui": {
      "file": "extensions/ui.json",
      "required": false
    }
  },
  "id": "transcription_worker",
  "license": "LICENSE.md",
  "name": "Transcription worker",
  "payload_api": "mn.blueprint.v1",
  "tagline": "Listen back with a transcript and speaker highlights",
  "terms": "TERM.md",
  "version": "0.2.1",
  "workflow": "workflow.json"
}
