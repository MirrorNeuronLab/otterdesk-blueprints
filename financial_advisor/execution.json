          "revision": "financial_advisor@4.0.0",
          "instance": {
            "uses": "mn.blocks.domain_operation@1",
            "hooks": {
              "operation": "domain.intake:step_financial_folder_watcher"
            },
            "limits": {
              "max_calls": 1,
              "timeout_seconds": 1800
