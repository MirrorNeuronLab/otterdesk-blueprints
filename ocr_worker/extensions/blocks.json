{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/extensions/blocks.schema.json",
  "steps": {
    "extract_folder_text": {
      "uses": "mn.blocks.domain_operation@1",
      "hooks": {
        "operation": "domain.ocr:run"
      },
      "inputs": {
        "input_folder": {
          "$ref": "run_input",
          "path": [
            "input_folder"
          ]
        },
        "merge_level": {
          "$ref": "run_input",
          "path": [
            "merge_level"
          ]
        }
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_folder"
        ],
        "properties": {
          "input_folder": {
            "type": "string",
            "minLength": 1
          },
          "merge_level": {
            "enum": [
              "word",
              "sentence",
              "paragraph"
            ]
          }
        }
      },
      "limits": {
        "max_calls": 1100,
        "timeout_seconds": 86400
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "report",
          "file_count",
          "failed_count"
        ],
        "properties": {
          "report": {
            "type": "object"
          },
          "file_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "failed_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        }
      }
    }
  }
}
