{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/extensions/blocks.schema.json",
  "services": {
    "camera_operator": {
      "uses": "mn.blocks.monitored_service@1",
      "config": {
        "interval_seconds": 5,
        "max_cycles": 1000000,
        "buffer_policy": "latest",
        "max_checkpoint_bytes": 67108864,
        "startup_timeout_seconds": 1200
      },
      "hooks": {
        "start": "domain.service_lifecycle:start",
        "ready": "domain.service_lifecycle:ready",
        "health": "domain.service_lifecycle:health",
        "cycle": "domain.service_lifecycle:cycle",
        "stop": "domain.service_lifecycle:stop"
      },
      "limits": {
        "max_calls": 1
      }
    }
  }
}
