{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/extensions/ui.schema.json",
  "configuration_contract": {
    "optional_files": [
      "scenario.json",
      "config/overwrite.json",
      "payloads/prompts/",
      "knowledge/"
    ],
    "required_files": [
      "manifest.json",
      "README.md",
      "SPEC.md",
      "config/default.json",
      "payloads/",
      "LICENSE.md",
      "TERM.md"
    ]
  },
  "observability_dashboard": {
    "panels": [
      "current_status",
      "recent_events",
      "pending_human_requests",
      "output_artifacts",
      "resource_usage",
      "errors",
      "input_lag",
      "backpressure",
      "llm_calls",
      "token_budget",
      "llm_retries",
      "output_skill_attempts",
      "output_skill_failures"
    ],
    "reads": [
      "events.jsonl",
      "human.jsonl",
      "logs.jsonl",
      "resources.jsonl",
      "result.json",
      "final_artifact.json",
      "cctv_report.json",
      "cctv_report.md",
      "web_ui.json"
    ],
    "schema_version": "mn.blueprint.observability_dashboard.v1",
    "source": "local_run_store"
  },
  "init_config_review": {
    "required": true,
    "instruction": "Confirm the approved camera securely before starting.",
    "fields": [
      {
        "path": "video_source.uri",
        "label": "Video stream URL",
        "type": "password",
        "secret": true,
        "role": "input",
        "required": true,
        "protocols": [
          "rtsp:",
          "rtsps:"
        ],
        "description": "Enter an approved RTSP or RTSPS camera in this secure field. The NVIDIA computer must be able to reach it."
      },
      {
        "path": "video_source.name",
        "label": "Camera name",
        "type": "text",
        "default": "Camera",
        "required": false
      },
      {
        "path": "inputs.payload.monitoring_goal",
        "label": "Monitoring goal",
        "type": "text",
        "required": false,
        "description": "Optional visible condition. Leave blank for concise scene activity."
      },
      {
        "path": "outputs.folder_path",
        "label": "Output folder",
        "type": "local_path",
        "path_kind": "directory",
        "default": "~/Downloads/cctv-operator",
        "required": false
      }
    ]
  },
  "web_ui": {
    "enabled": true,
    "kind": "service",
    "adapter": "external-url",
    "node_id": "camera_operator",
    "service_name": "cctv-operator-web-ui",
    "description": "Read-only live video and completed NVIDIA video-window observations.",
    "reads": [
      "monitoring_state.json",
      "cctv_report.json"
    ],
    "registration": {
      "module": "domain.service_lifecycle",
      "package": "mn-python-sdk-web-ui"
    }
  },
  "starter_questions": [
    "What has the camera observed?",
    "Show the saved video observations.",
    "What camera and goal do you need?",
    "Explain the latest observation’s limits."
  ],
  "setup_guide": {
    "schema": "otterdesk.setup_guide.v1",
    "introduction": "I review camera activity with NVIDIA video analysis and save observations with their video times. Enter an approved camera in the secure Video stream URL field. A live preview is separate from completed analysis.",
    "prompt_file": "@/payloads/prompts/setup.md",
    "sample": {
      "available": false
    },
    "real": {
      "introduction": "Enter one approved RTSP camera in the secure field, then optionally describe what to watch for.",
      "values": {}
    },
    "fields": [
      {
        "path": "video_source.uri",
        "label": "Video stream URL",
        "type": "password",
        "secret": true,
        "role": "input",
        "required": true,
        "protocols": [
          "rtsp:",
          "rtsps:"
        ],
        "description": "Enter an approved RTSP or RTSPS camera in this secure field. The NVIDIA computer must be able to reach it."
      },
      {
        "path": "video_source.name",
        "label": "Camera name",
        "type": "text",
        "default": "Camera",
        "required": false
      },
      {
        "path": "inputs.payload.monitoring_goal",
        "label": "Monitoring goal",
        "type": "text",
        "required": false,
        "description": "Optional visible condition. Leave blank for concise scene activity."
      },
      {
        "path": "outputs.folder_path",
        "label": "Output folder",
        "type": "local_path",
        "path_kind": "directory",
        "default": "~/Downloads/cctv-operator",
        "required": false
      }
    ]
  }
}
