{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/extensions/mcp.schema.json",
  "profile": "mn.mcp.supervision.v1",
  "manual": "@/knowledge/user_manual.md",
  "tools": {
    "get_operator_status": {
      "description": "Read current NVIDIA analysis health, the separate preview and latest completed video-window description. A read never starts capture.",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 8000
          }
        },
        "required": [
          "question"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean"
          },
          "ready": {
            "type": "boolean"
          },
          "summary": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "command_id": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "accepted": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          },
          "metrics": {
            "type": "object"
          },
          "details": {
            "type": "array"
          },
          "understanding": {
            "type": "object"
          },
          "pipeline": {
            "type": "object"
          },
          "warning": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "get_operator_activity": {
      "description": "Read the first observation for each goal and the start of each possible goal sighting.",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "after_revision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "after_revision"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "command_id": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "accepted": {
            "type": "boolean"
          },
          "current_revision": {
            "type": "integer"
          },
          "updates": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "set_monitoring_instruction": {
      "description": "Change the visible condition in future NVIDIA video windows. Preserve the exact subject and negation. For a past-video question use answer_video_question. Clearing restores the configured goal. A completed receipt confirms the goal was applied. A matching observation arrives separately.",
      "effect": "monitoring",
      "inputSchema": {
        "type": "object",
        "properties": {
          "instruction": {
            "type": "string",
            "maxLength": 4000
          },
          "clear": {
            "type": "boolean"
          },
          "analyze_now": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "instruction",
          "clear",
          "analyze_now",
          "request_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "command_id": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      },
      "request_id_argument": "command_id",
      "completion": {
        "tool": "get_operation_status",
        "id_argument": "operation_id",
        "id_field": "command_id",
        "poll_interval_ms": 500,
        "timeout_seconds": 30,
        "arguments": {
          "kind": "command"
        }
      }
    },
    "get_video_history": {
      "description": "List up to twelve recent sampled windows by capture interval. For questions about a person, color, object or condition use answer_video_question.",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "after": {
            "type": "string",
            "maxLength": 512
          },
          "before": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": [
          "after",
          "before"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "command_id": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "get_pipeline_benchmarks": {
      "description": "Read NVIDIA-reported model and video-window timings for retained captions in the current run. These exclude model startup and are not event-to-notice latency.",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "command_id": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "answer_video_question": {
      "description": "Search saved footage for a retrospective question. Rank indexed images and captions in Membrane, then inspect candidates. Preserve the original question. For relative times such as past hour, leave after and before empty so the co-worker resolves them at request time. Explicit bounds are timezone-qualified ISO capture times. Return the completed answer, citations and coverage. Reads never change monitoring.",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 8000
          },
          "after": {
            "type": "string",
            "maxLength": 64
          },
          "before": {
            "type": "string",
            "maxLength": 64
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "question",
          "after",
          "before",
          "request_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "command_id": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request_id_argument": "command_id",
      "completion": {
        "tool": "get_operation_status",
        "id_argument": "operation_id",
        "id_field": "command_id",
        "arguments": {
          "kind": "video"
        },
        "poll_interval_ms": 500,
        "timeout_seconds": 90
      }
    }
  },
  "service": {
    "name": "cctv-operator-mcp",
    "path": "/mcp",
    "required_tags": [
      "mcp",
      "video-analysis",
      "cctv-operator"
    ]
  },
  "preflight": {
    "required_for_effects": [
      "monitoring"
    ],
    "tool": "get_operator_status",
    "arguments": {
      "question": "Check operator readiness."
    },
    "required_result": {
      "ready": true
    }
  },
  "activity": {
    "tool": "watch_job_activity"
  }
}
