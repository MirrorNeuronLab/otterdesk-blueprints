{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/contracts.schema.json",
  "events": {
    "stream": "events.jsonl",
    "types": [
      "service_lifecycle",
      "blueprint_status",
      "artifact_written"
    ]
  },
  "input_adapters": {
    "supported": [
      "json"
    ],
    "default": "json",
    "resolved_artifact": "inputs.json",
    "validation_rules": [
      {
        "type": "command",
        "name": "video_source_validate",
        "command": [
          "python3",
          "payloads/agents/validation/validate_video_source.py"
        ],
        "timeout_seconds": 12
      }
    ]
  },
  "inputs": {
    "video_source": {
      "type": "domain_value",
      "required": true,
      "privacy": "confidential",
      "description": "One approved RTSP or RTSPS camera, supplied through video_source.uri in the secure setup field."
    },
    "monitoring_goal": {
      "type": "domain_value",
      "required": false,
      "privacy": "internal",
      "description": "Describe a visible condition or leave blank for concise scene activity."
    },
    "output_folder": {
      "type": "local_path",
      "path_kind": "directory",
      "required": false,
      "privacy": "internal",
      "description": "Additional host copy of saved observations.",
      "example": "~/Downloads/cctv-operator"
    }
  },
  "outputs": {
    "artifacts": [
      {
        "artifact_id": "cctv_report_json",
        "path": "cctv_report.json",
        "mime_type": "application/json",
        "type": "domain_report",
        "producer": "camera_operator",
        "schema_version": "otterdesk.cctv.v6",
        "source_refs": []
      },
      {
        "artifact_id": "cctv_report_markdown",
        "path": "cctv_report.md",
        "mime_type": "text/markdown",
        "type": "domain_report",
        "producer": "camera_operator",
        "schema_version": "otterdesk.cctv.v6",
        "source_refs": []
      },
      {
        "artifact_id": "final_artifact",
        "path": "final_artifact.json",
        "mime_type": "application/json",
        "type": "final_artifact",
        "producer": "camera_operator",
        "schema_version": "otterdesk.cctv.v6",
        "source_refs": []
      },
      {
        "artifact_id": "monitoring_state",
        "path": "monitoring_state.json",
        "mime_type": "application/json",
        "type": "domain_state",
        "producer": "camera_operator",
        "schema_version": "otterdesk.cctv.v6",
        "source_refs": []
      },
      {
        "artifact_id": "caption_accounts",
        "path": "captions",
        "mime_type": "application/json",
        "type": "artifact_collection",
        "producer": "camera_operator",
        "schema_version": "otterdesk.cctv.v6",
        "source_refs": []
      },
      {
        "artifact_id": "window_snapshots",
        "path": "snapshots",
        "mime_type": "image/jpeg",
        "type": "artifact_collection",
        "producer": "camera_operator",
        "schema_version": "otterdesk.cctv.v6",
        "source_refs": []
      },
      {
        "artifact_id": "camera_context_markdown",
        "path": "context_sources/outputs",
        "mime_type": "text/markdown",
        "type": "artifact_collection",
        "producer": "camera_operator",
        "schema_version": "otterdesk.cctv.v6",
        "source_refs": []
      },
      {
        "artifact_id": "web_ui",
        "path": "web_ui.json",
        "mime_type": "application/json",
        "type": "web_ui",
        "producer": "camera_operator",
        "schema_version": "otterdesk.cctv.v6",
        "source_refs": []
      }
    ],
    "primary": {
      "id": "final_artifact",
      "path": "final_artifact.json",
      "required_fields": [
        "type",
        "executive_summary",
        "recommended_action",
        "confidence",
        "evidence",
        "next_steps",
        "source_refs"
      ],
      "schema_version": "mn.blueprint.final_artifact_contract.v1",
      "type": "final_artifact"
    },
    "profile": "standard_run_store"
  },
  "privacy": {
    "default_classification": "internal",
    "rules": {
      "confidential": {
        "log": "redacted",
        "send_to_llm": "allowed_configs_only",
        "send_to_output_skills": "approved_destinations_only"
      },
      "internal": {
        "log": "metadata_only",
        "send_to_llm": true,
        "send_to_output_skills": true
      },
      "public": {
        "log": true,
        "send_to_llm": true,
        "send_to_output_skills": true
      },
      "regulated": {
        "log": "redacted",
        "send_to_llm": false,
        "send_to_output_skills": "approved_destinations_only"
      }
    },
    "classification": "internal"
  },
  "status": {
    "attempt_event": "workflow_step_attempt_started",
    "beacon_event": "agent_beacon",
    "beacon_interval_ms": 15000,
    "beacon_missed_action": "fail_attempt",
    "beacon_timeout_ms": 45000,
    "blocked_event": "workflow_step_blocked",
    "heartbeat_event": "agent_beacon",
    "heartbeat_required": true,
    "phases": [
      {
        "completion_event": "blueprint_phase_completed",
        "failure_event": "blueprint_phase_failed",
        "phase": "loading_inputs",
        "progress_event": "blueprint_status",
        "required": true,
        "start_event": "blueprint_phase_started"
      },
      {
        "completion_event": "blueprint_phase_completed",
        "failure_event": "blueprint_phase_failed",
        "phase": "running_worker",
        "progress_event": "blueprint_status",
        "required": true,
        "start_event": "blueprint_phase_started"
      },
      {
        "completion_event": "blueprint_phase_completed",
        "failure_event": "blueprint_phase_failed",
        "phase": "waiting_for_human",
        "progress_event": "blueprint_status",
        "required": true,
        "start_event": "blueprint_phase_started"
      },
      {
        "completion_event": "blueprint_phase_completed",
        "failure_event": "blueprint_phase_failed",
        "phase": "writing_artifacts",
        "progress_event": "blueprint_status",
        "required": true,
        "start_event": "blueprint_phase_started"
      },
      {
        "completion_event": "blueprint_phase_completed",
        "failure_event": "blueprint_phase_failed",
        "phase": "completed",
        "progress_event": "blueprint_status",
        "required": true,
        "start_event": "blueprint_phase_started"
      }
    ],
    "retry_event": "workflow_step_attempt_retry_scheduled",
    "runtime_state_source": "workflow_state",
    "schema_version": "mn.blueprint.status_contract.v1",
    "source": "run_store",
    "status_event": "blueprint_status",
    "terminal_step_events": [
      "workflow_step_completed",
      "workflow_step_partial",
      "workflow_step_skipped",
      "workflow_step_failed"
    ],
    "event": "blueprint_status",
    "heartbeat": true
  },
  "summary": "Review one approved RTSP camera with NVIDIA real-time video captions, a live preview, saved observations and supervised monitoring goals.",
  "users": [
    "Video operators, security reviewers, safety operations teams, and site-access coordinators."
  ],
  "artifacts": {
    "artifacts": [
      {
        "artifact_id": "cctv_report_json",
        "path": "cctv_report.json",
        "mime_type": "application/json",
        "type": "domain_report",
        "producer": "camera_operator",
        "schema_version": "otterdesk.cctv.v6",
        "source_refs": []
      },
      {
        "artifact_id": "cctv_report_markdown",
        "path": "cctv_report.md",
        "mime_type": "text/markdown",
        "type": "domain_report",
        "producer": "camera_operator",
        "schema_version": "otterdesk.cctv.v6",
        "source_refs": []
      },
      {
        "artifact_id": "final_artifact",
        "path": "final_artifact.json",
        "mime_type": "application/json",
        "type": "final_artifact",
        "producer": "camera_operator",
        "schema_version": "otterdesk.cctv.v6",
        "source_refs": []
      },
      {
        "artifact_id": "monitoring_state",
        "path": "monitoring_state.json",
        "mime_type": "application/json",
        "type": "domain_state",
        "producer": "camera_operator",
        "schema_version": "otterdesk.cctv.v6",
        "source_refs": []
      },
      {
        "artifact_id": "caption_accounts",
        "path": "captions",
        "mime_type": "application/json",
        "type": "artifact_collection",
        "producer": "camera_operator",
        "schema_version": "otterdesk.cctv.v6",
        "source_refs": []
      },
      {
        "artifact_id": "window_snapshots",
        "path": "snapshots",
        "mime_type": "image/jpeg",
        "type": "artifact_collection",
        "producer": "camera_operator",
        "schema_version": "otterdesk.cctv.v6",
        "source_refs": []
      },
      {
        "artifact_id": "camera_context_markdown",
        "path": "context_sources/outputs",
        "mime_type": "text/markdown",
        "type": "artifact_collection",
        "producer": "camera_operator",
        "schema_version": "otterdesk.cctv.v6",
        "source_refs": []
      },
      {
        "artifact_id": "web_ui",
        "path": "web_ui.json",
        "mime_type": "application/json",
        "type": "web_ui",
        "producer": "camera_operator",
        "schema_version": "otterdesk.cctv.v6",
        "source_refs": []
      }
    ],
    "final_artifact_json": "final_artifact.json",
    "result_json": "result.json",
    "events_jsonl": "events.jsonl"
  }
}
