{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/workflow.schema.json",
  "workflow_id": "cctv_operator_v6",
  "execution": {
    "strategy": "serial"
  },
  "steps": [
    {
      "id": "serve_video_model",
      "needs": [],
      "kind": "task",
      "label": "Monitor camera activity",
      "goal": "Keep NVIDIA real-time video analysis and the supervised camera operator running.",
      "run": {
        "agent": "realtime_vlm",
        "binding": "serve_video_model"
      },
      "worker": {
        "enabled": false
      },
      "control": {
        "timeout_seconds": 86400,
        "retry": {
          "max_attempts": 1
        }
      }
    }
  ],
  "defaults": {
    "step": {
      "control": {
        "required": true,
        "failure_policy": "fail_workflow",
        "retry": {
          "max_attempts": 1
        }
      }
    }
  }
}
