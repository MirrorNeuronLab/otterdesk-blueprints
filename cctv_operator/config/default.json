{
  "standard_version": "1.0",
  "mode": "live",
  "video_source": {
    "uri": "",
    "name": "Camera"
  },
  "analysis": {
    "chunk_duration": 4,
    "frames_per_chunk": 8,
    "max_tokens": 192,
    "caption_timeout_seconds": 120
  },
  "vlm": {
    "base_url": "http://127.0.0.1:8019",
    "startup_timeout_seconds": 1200
  },
  "inputs": {
    "adapter": "json",
    "payload": {
      "monitoring_goal": ""
    }
  },
  "outputs": {
    "folder_path": "~/Downloads/cctv-operator",
    "adapter": "local_run_store"
  },
  "retention": {
    "max_captions": 10000
  },
  "web_ui": {
    "enabled": true,
    "adapter": "external_url",
    "service": {
      "host": "0.0.0.0",
      "port": 0
    }
  },
  "logging": {
    "level": "INFO",
    "redact_fields": [
      "uri",
      "password",
      "token",
      "authorization"
    ]
  },
  "knowledge_rag": {
    "backend": "duckdb",
    "index_on_startup": true
  },
  "text_memory": {
    "enabled": false
  }
}
