{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/execution.schema.json",
  "type": "service",
  "mode": "compiled",
  "job_name": "cctv-operator",
  "service": {
    "enabled": true,
    "run_until": "manual_stop",
    "state_artifact": "monitoring_state.json",
    "manual_close": "Pause or stop the co-worker in OtterDesk. Core releases this run\u2019s NVIDIA Compose project and camera operator."
  },
  "requirements": {
    "cpu": {
      "min_cores": 4
    },
    "memory": {
      "min_gb": 8
    },
    "disk": {
      "min_gb": 25
    },
    "gpu": {
      "driver": "cuda",
      "enforcement": "hard",
      "memory_operator": ">=",
      "min_count": 1,
      "min_memory_mb": 49152,
      "vendor": "nvidia"
    }
  },
  "agents": {
    "entrypoints": [
      "realtime_vlm",
      "camera_operator"
    ],
    "nodes": [
      {
        "node_id": "realtime_vlm",
        "alias": "realtime_vlm",
        "display_name": "NVIDIA real-time video analysis",
        "agent_type": "executor",
        "type": "generic",
        "constraints": [
          {
            "attribute": "capabilities",
            "operator": "contains_all",
            "value": [
              "nvidia",
              "cuda"
            ]
          }
        ],
        "resources": {
          "gpu_count": 1,
          "ports": [
            {
              "label": "realtime_vlm",
              "port": 8019,
              "protocol": "http"
            }
          ],
          "devices": [
            {
              "kind": "gpu",
              "type": "nvidia/gpu",
              "vendor": "nvidia",
              "driver": "cuda",
              "min_memory_mb": 49152,
              "memory_operator": ">=",
              "count": 1
            }
          ]
        },
        "config": {
          "runner_module": "MirrorNeuron.Runner.DockerCompose",
          "compose": {
            "context": "vss",
            "file": "compose.yaml",
            "env_file": "runtime.env",
            "services": [
              "vlm"
            ],
            "health": [
              {
                "url": "http://127.0.0.1:8019/v1/ready"
              }
            ],
            "startup_timeout_seconds": 1200
          },
          "idempotent": false,
          "safe_to_retry": false,
          "timeout_seconds": 86400,
          "max_attempts": 1,
          "output_message_type": null
        }
      }
    ],
    "extra_nodes": [
      {
        "node_id": "camera_operator",
        "alias": "camera_operator",
        "display_name": "CCTV co-worker",
        "agent_type": "executor",
        "type": "stream",
        "config": {
          "from": "base",
          "runner_module": "MirrorNeuron.Runner.HostLocal",
          "no_keep": true,
          "no_auto_providers": true,
          "output_message_type": null,
          "upload_paths": [
            {
              "source": "domain",
              "target": "domain"
            },
            {
              "source": "web_assets",
              "target": "web_assets"
            }
          ],
          "environment": {},
          "workdir": "/sandbox/job",
          "pool": "default",
          "pool_slots": 1,
          "python_environment": {
            "packages": [
              "fastapi>=0.115,<1",
              "uvicorn>=0.34,<1",
              "httpx>=0.28,<1",
              "pydantic>=2.10,<3",
              "av>=16,<19",
              "Pillow>=11,<13"
            ]
          }
        },
        "resources": {
          "ports": [
            {
              "label": "cctv_operator_mcp",
              "port": "auto",
              "protocol": "http"
            },
            {
              "label": "web_ui",
              "port": "auto",
              "protocol": "http"
            }
          ]
        },
        "services": [
          {
            "name": "cctv-operator-mcp",
            "address": "127.0.0.1",
            "port": "${env.MN_PORT_CCTV_OPERATOR_MCP}",
            "origin": "internal",
            "tags": [
              "mcp",
              "video-analysis",
              "cctv-operator"
            ],
            "meta": {
              "path": "/mcp",
              "schema_version": "mn.cctv.operator_mcp.v6"
            },
            "checks": [
              {
                "name": "cctv-mcp",
                "type": "http",
                "address": "127.0.0.1",
                "port": "${service.port}",
                "path": "/health",
                "expected_status": 200,
                "interval_ms": 2000,
                "timeout_ms": 1000,
                "failures_before_critical": 3,
                "required": true
              }
            ]
          }
        ],
        "constraints": [
          {
            "attribute": "capabilities",
            "operator": "contains_all",
            "value": [
              "nvidia",
              "cuda"
            ]
          }
        ]
      }
    ]
  },
  "defaults": {
    "worker": {
      "enabled": false
    }
  },
  "runtime": {
    "bindings": {
      "serve_video_model": {
        "type": "worker",
        "strategy": "single",
        "workers": [
          {
            "id": "realtime_vlm",
            "role": "Run NVIDIA video analysis until the supervisor stops it."
          }
        ]
      }
    },
    "initial_inputs": {
      "realtime_vlm": [
        {
          "type": "start"
        }
      ]
    },
    "placement": {
      "mode": "single_node"
    },
    "store": {
      "artifacts": [
        "run.json",
        "config.json",
        "inputs.json",
        "events.jsonl",
        "human.jsonl",
        "logs.jsonl",
        "resources.jsonl",
        "result.json",
        "final_artifact.json",
        "cctv_report.json",
        "cctv_report.md",
        "web/conversation_media.json",
        "web/cctv_snapshot.jpg"
      ],
      "path": "./runs/${run_id}",
      "type": "local_run_store"
    },
    "workflow_control": {
      "attempts": {
        "dispatch_metadata": [
          "workflow_run_id",
          "step_id",
          "attempt_id",
          "attempt",
          "deadline_at",
          "heartbeat_deadline_at",
          "idempotency_key"
        ],
        "retry_policy_source": "workflow.steps[].control.retry",
        "stale_attempt_outputs": "ignore",
        "timeout_source": "workflow.steps[].control.timeout_seconds"
      },
      "enabled": true,
      "events": [
        "workflow_step_attempt_started",
        "workflow_step_beacon",
        "workflow_step_attempt_completed",
        "workflow_step_attempt_timed_out",
        "workflow_step_attempt_retry_scheduled",
        "workflow_step_blocked",
        "workflow_step_completed",
        "workflow_step_failed",
        "workflow_message_dead_lettered"
      ],
      "liveness": {
        "event": "agent_beacon",
        "interval_ms": 15000,
        "missed_action": "fail_attempt",
        "required": true,
        "timeout_ms": 45000
      },
      "pause_cancel": {
        "cancel_mode": "terminate_active_attempts",
        "pause_mode": "stop_active_attempts",
        "resume_mode": "reconcile_from_workflow_state"
      },
      "reconciliation": {
        "interval_ms": 2000,
        "on_missed_beacon": "fail_attempt_then_retry",
        "on_retry_exhausted": "apply_step_failure_policy",
        "on_timeout": "fail_attempt_then_retry"
      },
      "schema_version": "mn.workflow.runtime_control.v1",
      "source_of_truth": "workflow.steps",
      "state_ledger": {
        "delivery_semantics": "at_least_once_with_idempotency",
        "enabled": true,
        "message_ledger": true,
        "persisted_field": "workflow_state",
        "step_statuses": [
          "pending",
          "ready",
          "queued",
          "running",
          "retry_wait",
          "blocked",
          "completed",
          "partial",
          "skipped",
          "failed"
        ]
      }
    }
  }
}
