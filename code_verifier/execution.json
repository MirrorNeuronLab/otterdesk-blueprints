{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/execution.schema.json",
  "type": "batch",
  "mode": "compiled",
  "job_name": "code-verifier",
  "requirements": {
    "cpu": {
      "min_cores": 1
    },
    "memory": {
      "min_gb": 2
    },
    "disk": {
      "min_gb": 1
    },
    "gpu": {
      "min_count": 0
    }
  },
  "agents": {
    "registry": {}
  },
  "defaults": {
    "worker": {
      "uses": "mn-agents.worker.python_host@1",
      "with": {
        "stereotype": [
          "blueprint_host_worker",
          "internal_write_worker"
        ],
        "upload_paths": [
          {
            "source": "domain",
            "target": "domain"
          },
          {
            "source": "prompts",
            "target": "prompts"
          }
        ],
        "timeout_seconds": 3900,
        "upload_path": "domain",
        "upload_as": "domain"
      }
    }
  }
}
