{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/extensions/response.schema.json",
  "enabled": true,
  "agent": {
    "kind": "bounded_mcp",
    "service": {
      "name": "microduck-controller-mcp",
      "path": "/mcp",
      "required_tags": [
        "mcp",
        "robot-control",
        "microduck-controller"
      ]
    },
    "preflight": {
      "required_for_effects": [
        "motion",
        "navigation",
        "play",
        "locomotion",
        "posture",
        "ball",
        "simulation"
      ],
      "tool": "get_duck_state",
      "arguments": {},
      "required_result": {
        "connected": true,
        "ready": true
      }
    },
    "tools": {
      "user": {
        "get_user_manual": {
          "effect": "read",
          "arguments": {}
        },
        "get_duck_state": {
          "effect": "read",
          "arguments": {}
        },
        "move_duck": {
          "effect": "motion",
          "description": "Move briefly in one fixed direction for 250, 500, or 1000 ms. Use only for an untargeted step or turn. Never use this for a destination such as the ball; use find_ball for that goal.",
          "arguments": {
            "command_id": {
              "type": "string"
            },
            "direction": {
              "type": "string",
              "enum": [
                "forward",
                "backward",
                "turn_left",
                "turn_right"
              ]
            },
            "duration": {
              "type": "string",
              "enum": [
                "short",
                "medium",
                "long"
              ]
            }
          }
        },
        "perform_routine": {
          "effect": "motion",
          "arguments": {
            "command_id": {
              "type": "string"
            },
            "routine": {
              "type": "string",
              "enum": [
                "showcase",
                "spin_left",
                "spin_right",
                "zigzag"
              ]
            }
          }
        },
        "find_ball": {
          "effect": "navigation",
          "description": "Navigate continuously to the active ball using closed-loop position feedback, turning and advancing until the duck reaches it and stops. Use for 'move the duck to the ball', 'go to the ball', 'approach the ball', or 'find the ball'. A single move_duck step does not fulfill this goal.",
          "arguments": {
            "command_id": {
              "type": "string"
            }
          }
        },
        "free_play": {
          "effect": "play",
          "arguments": {
            "command_id": {
              "type": "string"
            }
          }
        },
        "stop_duck": {
          "effect": "stop",
          "arguments": {
            "command_id": {
              "type": "string"
            }
          }
        },
        "set_locomotion": {
          "effect": "locomotion",
          "arguments": {
            "command_id": {
              "type": "string"
            },
            "locomotion": {
              "type": "string",
              "enum": [
                "legs",
                "rollers"
              ]
            }
          }
        },
        "set_posture": {
          "effect": "posture",
          "description": "Sit down or stand up using the simulator's legged posture policy. Use sit for sit down, sit, take a seat, or seat down; use stand to get up or stand up.",
          "arguments": {
            "command_id": { "type": "string" },
            "posture": { "type": "string", "enum": ["sit", "stand"] }
          }
        },
        "play_ball_action": {
          "effect": "ball",
          "arguments": {
            "command_id": {
              "type": "string"
            },
            "action": {
              "type": "string",
              "enum": [
                "spawn_ball",
                "kick_left",
                "kick_right"
              ]
            }
          }
        },
        "reset_simulation": {
          "effect": "simulation",
          "arguments": {
            "command_id": {
              "type": "string"
            }
          }
        }
      },
      "internal": {
        "get_command_status": {
          "arguments": {
            "command_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "operations": {
      "move_duck": {
        "id_field": "command_id",
        "poll_tool": "get_command_status",
        "poll_argument": "command_id",
        "poll_interval_ms": 500,
        "timeout_seconds": 20
      },
      "perform_routine": {
        "id_field": "command_id",
        "poll_tool": "get_command_status",
        "poll_argument": "command_id",
        "poll_interval_ms": 500,
        "timeout_seconds": 20
      },
      "find_ball": {
        "id_field": "command_id",
        "poll_tool": "get_command_status",
        "poll_argument": "command_id",
        "poll_interval_ms": 500,
        "timeout_seconds": 40
      },
      "free_play": {
        "id_field": "command_id",
        "poll_tool": "get_command_status",
        "poll_argument": "command_id",
        "poll_interval_ms": 500,
        "timeout_seconds": 40
      },
      "stop_duck": {
        "id_field": "command_id",
        "poll_tool": "get_command_status",
        "poll_argument": "command_id",
        "poll_interval_ms": 500,
        "timeout_seconds": 10
      },
      "set_locomotion": {
        "id_field": "command_id",
        "poll_tool": "get_command_status",
        "poll_argument": "command_id",
        "poll_interval_ms": 500,
        "timeout_seconds": 20
      },
      "set_posture": {
        "id_field": "command_id",
        "poll_tool": "get_command_status",
        "poll_argument": "command_id",
        "poll_interval_ms": 500,
        "timeout_seconds": 20
      },
      "play_ball_action": {
        "id_field": "command_id",
        "poll_tool": "get_command_status",
        "poll_argument": "command_id",
        "poll_interval_ms": 500,
        "timeout_seconds": 20
      },
      "reset_simulation": {
        "id_field": "command_id",
        "poll_tool": "get_command_status",
        "poll_argument": "command_id",
        "poll_interval_ms": 500,
        "timeout_seconds": 20
      }
    },
    "memory": {
      "enabled": true,
      "mode": "explicit",
      "path": "knowledge/learned",
      "types": [
        "motion_alias",
        "control_constraint",
        "capability_note"
      ],
      "max_active_records": 100
    }
  }
}
