{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/extensions/blocks.schema.json",
  "operations": {
    "simulator_command": {
      "uses": "mn.blocks.controlled_operation@1",
      "config": {
        "max_state_age_seconds": 1,
        "transport": "async_device"
      },
      "hooks": {
        "validate": "domain.control_blocks:validate",
        "policy": "domain.control_blocks:policy",
        "cancel": "domain.control_blocks:cancel"
      },
      "input_schema": {
        "type": "object",
        "required": [
          "command_id",
          "kind",
          "payload"
        ],
        "properties": {
          "command_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": [
          "request_id",
          "receipt"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "receipt": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "limits": {
        "max_calls": 3,
        "timeout_seconds": 3
      }
    }
  },
  "steps": {
    "run_microduck_service": {
      "uses": "mn.blocks.monitored_service@1",
      "hooks": {
        "start": "domain.service_lifecycle:start",
        "health": "domain.service_lifecycle:health",
        "cycle": "domain.service_lifecycle:cycle",
        "stop": "domain.service_lifecycle:stop"
      },
      "inputs": {
        "input_folder": {
          "$ref": "run_input",
          "path": [
            "input_folder"
          ]
        },
        "output_folder": {
          "$ref": "run_input",
          "path": [
            "output_folder"
          ]
        }
      },
      "outputs": {
        "service": {
          "$ref": "flow_output",
          "path": [
            "result"
          ]
        }
      },
      "limits": {
        "max_calls": 1
      },
      "config": {
        "interval_seconds": 60,
        "max_cycles": 1000000,
        "buffer_policy": "latest",
        "max_checkpoint_bytes": 67108864
      }
    },
    "finalize_service": {
      "uses": "mn.blocks.domain_operation@1",
      "hooks": {
        "operation": "domain.service_lifecycle:finalize"
      },
      "inputs": {
        "service": {
          "$ref": "upstream",
          "step_id": "run_microduck_service"
        }
      },
      "outputs": {
        "final_service_result": {
          "$ref": "flow_output",
          "path": [
            "result"
          ]
        }
      },
      "limits": {
        "max_calls": 1,
        "timeout_seconds": 30
      }
    }
  },
  "services": {
    "microduck_web_ui_registrar": {
      "uses": "mn.blocks.monitored_service@1",
      "hooks": {
        "start": "domain.web_ui_service:start",
        "health": "domain.web_ui_service:health",
        "ready": "domain.web_ui_service:ready",
        "cycle": "domain.web_ui_service:cycle",
        "stop": "domain.web_ui_service:stop"
      },
      "config": {
        "interval_seconds": 5,
        "max_cycles": null,
        "buffer_policy": "latest",
        "startup_timeout_seconds": 60,
        "max_checkpoint_bytes": 67108864
      }
    }
  }
}
