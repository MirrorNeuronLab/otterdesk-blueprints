{
  "apiVersion": "mn.workflow/v1",
  "kind": "WorkflowSource",
  "type": "service",
  "identity": {
    "id": "microduck_controller",
    "name": "Microduck Controller",
    "job_name": "microduck-controller",
    "category": "Robotics",
    "version": 1,
    "manifest_version": "1.4"
  },
  "job_name": "microduck-controller",
  "description": "Talk to a live Microduck MuJoCo simulation in OtterDesk: the Job agent interprets natural-language intent and invokes bounded MCP movement, goal-directed ball navigation, continuous free play, routine, locomotion, ball, reset, stop, and state tools.",
  "response_service": {
    "enabled": true,
    "agent": {
      "kind": "bounded_mcp",
      "service": {
        "name": "microduck-controller-mcp",
        "path": "/mcp",
        "required_tags": [
          "mcp",
          "robot-control",
          "microduck-controller"
        ]
      },
      "preflight": {
        "required_for_effects": [
          "motion",
          "navigation",
          "play",
          "locomotion",
          "ball",
          "simulation"
        ],
        "tool": "get_duck_state",
        "arguments": {},
        "required_result": {
          "connected": true,
          "ready": true
        }
      },
      "tools": {
        "user": {
          "get_user_manual": {
            "effect": "read",
            "arguments": {}
          },
          "get_duck_state": {
            "effect": "read",
            "arguments": {}
          },
          "move_duck": {
            "effect": "motion",
            "arguments": {
              "command_id": {
                "type": "string"
              },
              "direction": {
                "type": "string",
                "enum": [
                  "forward",
                  "backward",
                  "turn_left",
                  "turn_right"
                ]
              },
              "duration": {
                "type": "string",
                "enum": [
                  "short",
                  "medium",
                  "long"
                ]
              }
            }
          },
          "perform_routine": {
            "effect": "motion",
            "arguments": {
              "command_id": {
                "type": "string"
              },
              "routine": {
                "type": "string",
                "enum": [
                  "showcase",
                  "spin_left",
                  "spin_right",
                  "zigzag"
                ]
              }
            }
          },
          "find_ball": {
            "effect": "navigation",
            "arguments": {
              "command_id": {
                "type": "string"
              }
            }
          },
          "free_play": {
            "effect": "play",
            "arguments": {
              "command_id": {
                "type": "string"
              }
            }
          },
          "stop_duck": {
            "effect": "stop",
            "arguments": {
              "command_id": {
                "type": "string"
              }
            }
          },
          "set_locomotion": {
            "effect": "locomotion",
            "arguments": {
              "command_id": {
                "type": "string"
              },
              "locomotion": {
                "type": "string",
                "enum": [
                  "legs",
                  "rollers"
                ]
              }
            }
          },
          "play_ball_action": {
            "effect": "ball",
            "arguments": {
              "command_id": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "enum": [
                  "spawn_ball",
                  "kick_left",
                  "kick_right"
                ]
              }
            }
          },
          "reset_simulation": {
            "effect": "simulation",
            "arguments": {
              "command_id": {
                "type": "string"
              }
            }
          }
        },
        "internal": {
          "get_command_status": {
            "arguments": {
              "command_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "operations": {
        "move_duck": {
          "id_field": "command_id",
          "poll_tool": "get_command_status",
          "poll_argument": "command_id",
          "poll_interval_ms": 500,
          "timeout_seconds": 20
        },
        "perform_routine": {
          "id_field": "command_id",
          "poll_tool": "get_command_status",
          "poll_argument": "command_id",
          "poll_interval_ms": 500,
          "timeout_seconds": 20
        },
        "find_ball": {
          "id_field": "command_id",
          "poll_tool": "get_command_status",
          "poll_argument": "command_id",
          "poll_interval_ms": 500,
          "timeout_seconds": 40
        },
        "free_play": {
          "id_field": "command_id",
          "poll_tool": "get_command_status",
          "poll_argument": "command_id",
          "poll_interval_ms": 500,
          "timeout_seconds": 40
        },
        "stop_duck": {
          "id_field": "command_id",
          "poll_tool": "get_command_status",
          "poll_argument": "command_id",
          "poll_interval_ms": 500,
          "timeout_seconds": 10
        },
        "set_locomotion": {
          "id_field": "command_id",
          "poll_tool": "get_command_status",
          "poll_argument": "command_id",
          "poll_interval_ms": 500,
          "timeout_seconds": 20
        },
        "play_ball_action": {
          "id_field": "command_id",
          "poll_tool": "get_command_status",
          "poll_argument": "command_id",
          "poll_interval_ms": 500,
          "timeout_seconds": 20
        },
        "reset_simulation": {
          "id_field": "command_id",
          "poll_tool": "get_command_status",
          "poll_argument": "command_id",
          "poll_interval_ms": 500,
          "timeout_seconds": 20
        }
      },
      "memory": {
        "enabled": true,
        "mode": "explicit",
        "path": "knowledge/learned",
        "types": [
          "motion_alias",
          "control_constraint",
          "capability_note"
        ],
        "max_active_records": 100
      }
    }
  },
  "config": {
    "default": "config/default.json",
    "embed": true,
    "manifest_defaults": [
      "llm",
      {
        "from": "requirements",
        "to": "resources"
      },
      {
        "from": "metadata.memory_layer",
        "to": "memory_layer"
      },
      {
        "from": "identity.id",
        "to": "identity.blueprint_id"
      },
      {
        "from": "identity.name",
        "to": "identity.name"
      }
    ]
  },
  "contracts": {
    "summary": "Keep one browser-backed Microduck simulator service running and expose compact state plus bounded primitive and goal-directed MCP control.",
    "inputs": {
      "input_folder": {
        "type": "local_path",
        "path_kind": "directory",
        "required": false,
        "description": "Bundled service-only demo instructions.",
        "example": "microduck_controller/examples/sample_inputs"
      },
      "output_folder": {
        "type": "local_path",
        "path_kind": "directory",
        "required": false,
        "description": "Run-scoped service artifacts are materialized here.",
        "example": "~/Download/microduck_controller"
      }
    },
    "outputs": {
      "profile": "standard_run_store",
      "primary": {
        "id": "service_result",
        "path": "final_artifact.json",
        "schema_version": "mn.microduck.service_result.v1",
        "type": "service_result"
      },
      "artifacts": [
        {
          "artifact_id": "web_ui",
          "path": "web_ui.json",
          "schema_version": "mn.blueprint.web_ui.v1"
        },
        {
          "artifact_id": "service_state",
          "path": "duck_service_state.json",
          "schema_version": "mn.microduck.service_state.v1"
        },
        {
          "artifact_id": "command_history",
          "path": "duck_command_history.json",
          "schema_version": "mn.microduck.command_history.v1"
        },
        {
          "artifact_id": "final_service_result",
          "path": "final_artifact.json",
          "schema_version": "mn.microduck.service_result.v1"
        }
      ]
    },
    "status": {
      "event": "blueprint_status",
      "heartbeat": true,
      "phases": [
        "run_microduck_service",
        "finalize_service"
      ]
    },
    "privacy": {
      "classification": "internal"
    }
  },
  "manifest": {
    "license": "ATTRIBUTION.md",
    "term": "TERM.md",
    "service": {
      "enabled": true,
      "run_until": "manual_stop",
      "manual_close": "Pause or stop the Microduck Controller in OtterDesk; Core terminates the owned service worker and browser bridge."
    }
  },
  "intent": {
    "description": "Serve a browser-owned Microduck simulation and make only fresh compact state plus bounded primitive and goal-directed ball-navigation effects available to an external MCP caller.",
    "problem": "A conversation agent needs a visible, auditable robot-simulation control surface that can complete one closed-loop goal without direct MuJoCo mutation, arbitrary browser automation, or cross-run command replay.",
    "target_users": "Robotics demonstrators, AI-agent developers, simulation researchers, and evaluators.",
    "safety": {
      "enabled": true,
      "mode": "notice_only",
      "notice_event": "human_notice",
      "requires_ack": false,
      "blocked_actions": [
        "physical_robot_control",
        "arbitrary_velocity",
        "arbitrary_javascript",
        "shell_execution"
      ]
    }
  },
  "requirements": {
    "cpu": {
      "min_cores": 2
    },
    "memory": {
      "min_gb": 2
    },
    "disk": {
      "min_gb": 2
    },
    "gpu": {
      "min_count": 0
    },
    "network": {
      "egress": "browser_cdn_required"
    }
  },
  "metadata": {
    "blueprint_id": "microduck_controller",
    "category": "Robotics",
    "description": "Talk to a live Microduck MuJoCo simulation in OtterDesk: the Job agent interprets natural-language intent and invokes bounded MCP movement, goal-directed ball navigation, continuous free play, routine, locomotion, ball, reset, stop, and state tools.",
    "generated_from": {
      "schema": "mn.workflow/v1"
    },
    "runtime_features": [
      "browser-owned MuJoCo simulation",
      "single-tab control lease",
      "bounded Streamable HTTP MCP tools",
      "deterministic closed-loop ball navigation",
      "continuous find-kick-reacquire free play",
      "short command watchdogs",
      "compact sensor context",
      "blueprint-owned MCP control manual",
      "bounded natural-language Job agent",
      "loopback-first web service",
      "Membrane context memory optimization"
    ],
    "web_ui": {
      "enabled": true,
      "title": "Microduck Controller",
      "node_id": "run_microduck_service__microduck_service",
      "service_name": "microduck-controller-web-ui"
    },
    "starter_questions": [
      "Move forward for a medium step.",
      "Could you locate the ball for me?",
      "Let's free play now—keep chasing and kicking it.",
      "Run the showcase routine.",
      "What can you do, and what are your safety limits?"
    ],
    "job_data": {
      "resources": [
        {
          "name": "knowledge",
          "path": "knowledge",
          "access": "read_write",
          "seed": "@/payloads/knowledge"
        },
        {
          "name": "rag",
          "path": "databases/rag",
          "access": "read_write"
        },
        {
          "name": "state",
          "path": "state",
          "access": "read_write"
        }
      ]
    },
    "memory_layer": {
      "enabled": true,
      "enabled_env": "MN_CONTEXT_MEMORY_ENABLED",
      "conversation_enabled": true,
      "conversation_enabled_env": "OTTERDESK_CONTEXT_MEMORY_ENABLED",
      "namespace": "microduck_controller_context",
      "collection": "mn_memory",
      "sdk_distribution": "mirrorneuron-membrane-python-sdk",
      "sdk_import_package": "mn_context_engine_sdk",
      "project_path": "${MN_MEMBRANE_PROJECT_PATH}",
      "python_sdk_path": "${MN_MEMBRANE_SDK_PATH}",
      "conversation": {
        "agent_role": "otterdesk_chat",
        "include_runtime_events": true,
        "include_runtime_logs": true,
        "include_human_events": true,
        "target_tokens": 800,
        "token_budget": 1200
      }
    },
    "init_config_review": {
      "required": false,
      "instruction": "No configuration confirmation is needed. These optional advanced settings remain available later; keep the public MCP URL loopback-only unless a trusted-LAN boundary protects the unauthenticated simulator controls.",
      "fields": [
        {
          "path": "inputs.payload.input_folder",
          "label": "Demo instructions folder",
          "default": "microduck_controller/examples/sample_inputs",
          "type": "local_path",
          "path_kind": "directory",
          "description": "The bundled service-only demo instructions."
        },
        {
          "path": "web_ui.service.public_url",
          "label": "Loopback service origin",
          "default": "http://127.0.0.1:0",
          "description": "The runtime replaces port 0 with a collision-free private port and registers it through OtterDesk's job-scoped proxy."
        },
        {
          "path": "web_ui.service.trusted_lan_enabled",
          "label": "Trusted LAN publication",
          "default": false,
          "description": "Keep false for localhost-only publication. Set true only after configuring an explicitly trusted LAN and firewall for the unauthenticated endpoint."
        },
        {
          "path": "outputs.folder_path",
          "label": "Output folder",
          "default": "~/Download/microduck_controller",
          "type": "local_path",
          "path_kind": "directory",
          "description": "Where service artifacts are written."
        }
      ]
    }
  },
  "agents": {
    "registry": {
      "microduck_service": {
        "handler": "agents.microduck_service",
        "role": "Browser-backed Microduck Simulation Service"
      },
      "finalize": {
        "handler": "agents.finalize",
        "role": "Microduck Service Finalizer"
      }
    },
    "auxiliary_entrypoints": [
      "microduck_web_ui_registrar"
    ],
    "extra_nodes": [
      {
        "node_id": "microduck_web_ui_registrar",
        "type": "generic",
        "agent_type": "executor",
        "alias": "microduck_web_ui_registrar",
        "display_name": "Microduck Web UI Registrar",
        "resources": {
          "ports": [
            {
              "label": "microduck_mcp",
              "port": 62008,
              "protocol": "http"
            }
          ]
        },
        "services": [
          {
            "name": "microduck-controller-mcp",
            "address": "127.0.0.1",
            "port": 62008,
            "origin": "internal",
            "tags": [
              "mcp",
              "robot-control",
              "microduck-controller"
            ],
            "meta": {
              "path": "/mcp",
              "manual_uri": "microduck://manual",
              "schema_version": "mn.microduck.mcp.v1"
            },
            "checks": [
              {
                "name": "microduck-mcp-http",
                "type": "http",
                "address": "127.0.0.1",
                "port": 62008,
                "path": "/health",
                "expected_status": 200,
                "interval_ms": 1000,
                "timeout_ms": 1000,
                "failures_before_critical": 3,
                "required": true
              }
            ]
          }
        ],
        "config": {
          "command": [
            "python3.11",
            "microduck_web_ui_registrar.py"
          ],
          "environment": {},
          "from": "base",
          "no_auto_providers": true,
          "no_keep": true,
          "output_message_type": null,
          "pool": "default",
          "pool_slots": 1,
          "runner_module": "MirrorNeuron.Runner.HostLocal",
          "tty": false,
          "upload_as": ".",
          "upload_path": "services",
          "workdir": "/sandbox/job"
        }
      }
    ]
  },
  "llm": {
    "enabled": true,
    "mode": "actor_assisted",
    "mock_mode": "deterministic",
    "model": "default",
    "default_config": "primary",
    "configs": {
      "primary": {
        "provider": "openai_compatible",
        "model": "default",
        "api_base": "auto",
        "temperature": 0,
        "structured_output_options": {
          "temperature": 0
        },
        "max_tokens": 300
      }
    },
    "responsibilities": [
      "Interpret Microduck requests by semantic intent using the indexed MCP control manual; examples are non-exhaustive and never exact-match triggers.",
      "Ignore polite, modal, permissive, and conversational framing such as please, now, could you, let's, and you can when the underlying supported intent is clear.",
      "Choose the exact declared tool and enum arguments for a clear paraphrase; clarify only material ambiguity, never wording variation.",
      "Map movement, routines, locomotion, one-shot ball actions, reset, stop, state, and manual paraphrases to their declared tools.",
      "Map find, seek, approach, and go-to-ball requests to one find_ball call; never expand them into repeated move_duck calls.",
      "Map free play, play-with-the-ball, suggestions such as let's free play, and permission statements such as you can free play to one free_play call; never expand them into repeated find_ball or play_ball_action calls.",
      "Use only the declared bounded MCP tools and their exact argument enums.",
      "Report observed command receipts without inventing motion or completion."
    ],
    "agents": {
      "microduck_service": {
        "llm_config": "primary",
        "role": "Microduck simulator service operator",
        "responsibilities": [
          "Keep the browser simulator and MCP surface reachable.",
          "Use the LLM to match varied natural-language phrasing to one declared control intent without requiring canonical command text.",
          "Run goal-directed ball approaches through the deterministic browser navigation loop.",
          "Run continuous free play through the deterministic find-kick-reacquire controller until stop_duck.",
          "Publish only compact simulation context and bounded command receipts.",
          "Stop remote movement when the browser lease becomes stale."
        ]
      },
      "finalize": {
        "llm_config": "primary",
        "role": "Microduck service finalizer",
        "responsibilities": [
          "Record a deliberate service shutdown.",
          "Preserve the service artifact trail.",
          "Never start or replay a simulator command."
        ]
      }
    }
  },
  "knowledge_rag": {
    "backend": "milvus_lite",
    "enabled": true,
    "index_on_startup": true,
    "knowledge_dir": "knowledge",
    "required": false,
    "chunk_size": 700,
    "chunk_overlap": 70,
    "top_k": 3,
    "max_context_chars": 1800,
    "namespace": ""
  },
  "workflow": {
    "workflow_id": "microduck_controller_v1",
    "mode": "static_dag",
    "execution": {
      "strategy": "serial",
      "max_parallel_steps": 1
    },
    "dynamic": {
      "enabled": false
    },
    "steps": [
      {
        "id": "run_microduck_service",
        "kind": "source",
        "label": "Run Microduck Simulation Service",
        "goal": "Keep the browser simulator, WebSocket bridge, and bounded MCP endpoint available until the service is deliberately stopped.",
        "needs": [],
        "run": {
          "definition": "steps.run_microduck_service"
        },
        "control": {
          "required": true,
          "timeout_seconds": 86400,
          "failure_policy": "fail_workflow",
          "retry": {
            "max_attempts": 1,
            "backoff_seconds": 1,
            "backoff_multiplier": 2,
            "jitter": 0
          },
          "uncertainty": {
            "min_confidence": 0,
            "on_low_confidence": "continue_with_warning"
          }
        }
      },
      {
        "id": "finalize_service",
        "kind": "sink",
        "label": "Finalize Microduck Service",
        "goal": "Record a deliberate service stop without starting or replaying movement.",
        "needs": [
          "run_microduck_service"
        ],
        "run": {
          "definition": "steps.finalize_service"
        },
        "control": {
          "required": true,
          "timeout_seconds": 30,
          "failure_policy": "fail_workflow",
          "retry": {
            "max_attempts": 1,
            "backoff_seconds": 1,
            "backoff_multiplier": 2,
            "jitter": 0
          },
          "uncertainty": {
            "min_confidence": 0,
            "on_low_confidence": "continue_with_warning"
          }
        }
      }
    ]
  },
  "defaults": {
    "worker": {
      "with": {
        "stereotype": "internal_write_worker"
      }
    }
  },
  "workers": {
    "groups": [
      {
        "steps": [
          "run_microduck_service"
        ],
        "uses": "mn-agents.worker.python_docker@1",
        "with": {
          "stereotype": [
            "blueprint_docker_worker",
            "internal_write_worker"
          ],
          "docker_worker_image": "docker_worker",
          "image": "mirror-neuron/microduck-controller:local",
          "dockerfile": "docker_worker/Dockerfile",
          "build_context": ".",
          "workdir": "/app",
          "timeout_seconds": 86400,
          "upload_paths": [
            {
              "source": "agents",
              "target": "agents"
            },
            {
              "source": "domain",
              "target": "domain"
            },
            {
              "source": "services",
              "target": "services"
            }
          ]
        }
      },
      {
        "steps": [
          "finalize_service"
        ],
        "uses": "mn-agents.worker.python_docker@1",
        "with": {
          "stereotype": [
            "blueprint_docker_worker",
            "internal_write_worker"
          ],
          "docker_worker_image": "docker_worker",
          "image": "mirror-neuron/microduck-controller:local",
          "dockerfile": "docker_worker/Dockerfile",
          "build_context": ".",
          "workdir": "/app"
        }
      }
    ]
  },
  "skill_dependencies": [
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-web-ui-skill",
      "version": "1.3.22"
    }
  ],
  "agent_dependencies": [
    {
      "type": "pip",
      "source": "gar",
      "name": "mn-prototype-supervised-service-agent",
      "version": "1.3.9"
    }
  ],
  "standard": {
    "profile": "blueprint",
    "profile_version": 1
  }
}
