{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/manifest.schema.json",
  "id": "microduck_controller",
  "name": "Microduck Controller",
  "version": "1.0.0",
  "description": "Talk to a live Microduck MuJoCo simulation in OtterDesk: the Job agent invokes bounded MCP movement, deterministic ball navigation, and stoppable continuous free play.",
  "workflow": "workflow.json",
  "execution": "execution.json",
  "contracts": "contracts.json",
  "config": "config/default.json",
  "license": "ATTRIBUTION.md",
  "terms": "TERM.md",
  "dependencies": "dependencies.json",
  "extensions": {
    "mn.context": {
      "file": "extensions/context.json",
      "required": true
    },
    "mn.llm": {
      "file": "extensions/llm.json",
      "required": true
    },
    "mn.product": {
      "file": "extensions/product.json",
      "required": false
    },
    "mn.rag": {
      "file": "extensions/rag.json",
      "required": true
    },
    "mn.response": {
      "file": "extensions/response.json",
      "required": true
    },
    "mn.storage": {
      "file": "extensions/storage.json",
      "required": true
    },
    "mn.ui": {
      "file": "extensions/ui.json",
      "required": false
    }
  }
}
