{
  "human_control": {
    "blocked_actions": [
      "physical_robot_control",
      "arbitrary_velocity",
      "arbitrary_javascript",
      "shell_execution"
    ],
    "enabled": true,
    "mode": "notice_only",
    "notice_event": "human_notice",
    "requires_ack": false
  },
  "inputs": {
    "adapter": "mock",
    "payload": {
      "input_folder": "microduck_controller/examples/sample_inputs",
      "output_folder": "~/Download/microduck_controller"
    }
  },
  "mcp_control": {
    "bridge_path": "/bridge",
    "browser_control_url": "",
    "enabled": true,
    "kind": "streamable_http",
    "path": "/mcp",
    "service": {
      "host": "127.0.0.1",
      "port": 62008
    }
  },
  "memory_layer": {
    "collection": "mn_memory",
    "conversation": {
      "agent_role": "otterdesk_chat",
      "include_human_events": true,
      "include_runtime_events": true,
      "include_runtime_logs": true,
      "target_tokens": 800,
      "token_budget": 1200
    },
    "conversation_enabled": true,
    "conversation_enabled_env": "OTTERDESK_CONTEXT_MEMORY_ENABLED",
    "enabled": true,
    "enabled_env": "MN_CONTEXT_MEMORY_ENABLED",
    "namespace": "microduck_controller_context",
    "project_path": "${MN_MEMBRANE_PROJECT_PATH}",
    "python_sdk_path": "${MN_MEMBRANE_SDK_PATH}",
    "sdk_distribution": "mirrorneuron-membrane-python-sdk",
    "sdk_import_package": "mn_context_engine_sdk"
  },
  "metadata": {
    "description": "Give it the bundled input folder and a local browser session, and it runs a live Microduck MuJoCo web simulation with compact duck-and-ball state, a visual control room, bounded primitive controls, deterministic goal-directed ball navigation, and stoppable continuous free play."
  },
  "outputs": {
    "adapter": "local_run_store",
    "folder_path": "~/Download/microduck_controller",
    "run_root": "~/.mn/runs",
    "write_run_store": true
  },
  "privacy": {
    "default_classification": "internal"
  },
  "web_ui": {
    "dashboard": {
      "path": "@/payloads/web_app/index.html",
      "standard_panels": [
        "status",
        "timeline",
        "agents",
        "artifacts",
        "resources",
        "logs",
        "human_control"
      ]
    },
    "enabled": true,
    "kind": "live_service",
    "service": {
      "host": "127.0.0.1",
      "listen_host": "0.0.0.0",
      "port": 0,
      "public_host": "127.0.0.1",
      "public_url": "http://127.0.0.1:0",
      "trusted_lan_enabled": false
    }
  }
}
