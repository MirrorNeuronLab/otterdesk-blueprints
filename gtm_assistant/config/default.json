{
  "inputs": {
    "adapter": "mock",
    "description": "Synthetic Bibblio demo input for the generic GTM Assistant.",
    "payload": {
      "business_name": "Bibblio",
      "business_goal": "Build a successful business for Bibblio.",
      "goal_id": "bibblio-business-success",
      "planning_horizon_days": 90,
      "input_folder": "@/examples/sample_inputs",
      "customer_feedback_file": "",
      "output_folder": "~/Downloads/gtm_assistant",
      "peer_mcp_servers": [],
      "email_send_approval": {
        "approved": false
      }
    }
  },
  "outputs": {
    "folder_path": "~/Downloads/gtm_assistant",
    "write_run_store": true
  },
  "local_inputs": {
    "folders": [
      {
        "config_path": "inputs.payload.input_folder",
        "payload_path": "mn_local_inputs/gtm_assistant",
        "runtime_path": "mn_local_inputs/gtm_assistant",
        "allowed_extensions": [
          "csv"
        ]
      }
    ]
  },
  "execution": {
    "quick_test": true
  },
  "llm": {
    "mode": "fake",
    "require_live": false
  },
  "mcp_collaboration": {
    "chat_grace_seconds": 8,
    "publish_local_exchange": true,
    "peer_reads_enabled": false
  },
  "privacy": {
    "default_classification": "confidential",
    "child_data_export": "blocked",
    "external_communications": "approval_required",
    "minimum_data": true
  },
  "parent_lifecycle": {
    "outreach_mode": "draft_only",
    "child_directed_messaging": false,
    "max_message_frequency_per_week": 1
  },
  "smtp_delivery": {
    "enabled": false,
    "mode": "development",
    "host": "smtp.mail.me.com",
    "port": 587,
    "security": "starttls",
    "timeout_seconds": 10,
    "max_messages_per_run": 1
  },
  "reply_monitoring": {
    "enabled": false,
    "host": "imap.mail.me.com",
    "port": 993,
    "security": "ssl",
    "timeout_seconds": 10,
    "poll_interval_seconds": 15
  }
}
