{
  "apiVersion": "mn.workflow.source/v2",
  "kind": "WorkflowSource",
  "standard": {
    "profile": "blueprint",
    "source_schema": "mn.workflow.source/v2",
    "target_schema": "mn.workflow/v1",
    "migration_policy": "sdk_managed"
  },
  "identity": {
    "id": "gtm_assistant",
    "name": "GTM Assistant",
    "job_name": "gtm-assistant",
    "category": "business",
    "version": 3,
    "manifest_version": "1.0"
  },
  "description": "A GTM assistant that converts de-identified customer feedback into journey friction, draft interventions, support escalations, retention evidence, and product priorities.",
  "intent": {
    "description": "Customer Lifecycle and Product Intelligence Director serving a configurable business-success goal; the bundled demo applies the role to Bibblio's parent lifecycle.",
    "problem": "Subscription businesses need customers to reach value quickly, form useful routines, receive trustworthy support, and turn churn or feedback into product improvements.",
    "target_users": "Founders and designated product, lifecycle, customer-success, support, privacy, and growth reviewers.",
    "safety": {
      "enabled": true,
      "mode": "approval_required",
      "allowed_decisions": [
        "approve",
        "revise",
        "reject"
      ],
      "blocked_actions": [
        "send_external_communications",
        "publish_child_facing_content",
        "spend_money_or_launch_paid_campaigns",
        "change_pricing_or_subscription_terms",
        "make_learning_medical_or_therapeutic_claims",
        "change_child_or_family_data_collection"
      ],
      "default_action": "reject",
      "timeout_seconds": 86400,
      "reason": "The co-worker observes, analyzes, drafts, and queues; a designated human approves every consequential external action."
    }
  },
  "config": {
    "default": "config/default.json",
    "embed": true,
    "manifest_defaults": [
      "llm",
      "mcp_collaboration",
      {
        "from": "requirements",
        "to": "resources"
      },
      {
        "from": "workflow.policy.human",
        "to": "human_control"
      },
      {
        "from": "identity.id",
        "to": "identity.blueprint_id"
      },
      {
        "from": "identity.name",
        "to": "identity.name"
      }
    ]
  },
  "defaults": {
    "worker": {
      "with": {
        "stereotype": "internal_write_worker",
        "image": "mirror-neuron/gtm-assistant:local",
        "upload_paths": [
          {
            "source": "domain",
            "target": "domain"
          }
        ]
      }
    }
  },
  "workers": {
    "groups": [
      {
        "steps": [
          "deliver_approved_lifecycle_email",
          "monitor_development_email_replies"
        ],
        "with": {
          "side_effect": "external",
          "pass_env": [
            "MN_SMTP_USERNAME",
            "MN_SMTP_PASSWORD",
            "MN_SMTP_DEV_RECIPIENT"
          ]
        }
      }
    ]
  },
  "contracts": {
    "input_adapters": {
      "default": "mock",
      "resolved_artifact": "inputs.json",
      "supported": [
        "mock",
        "json",
        "file",
        "env_json"
      ]
    },
    "inputs": {
      "business_name": {
        "type": "domain_value",
        "required": false,
        "privacy": "internal",
        "description": "Business name used to contextualize role outputs. The bundled demo defaults to Bibblio.",
        "example": "Bibblio"
      },
      "business_goal": {
        "type": "domain_value",
        "required": false,
        "privacy": "internal",
        "description": "Shared business goal served by the independently launched co-workers.",
        "example": "Build a successful business for Bibblio."
      },
      "goal_id": {
        "type": "domain_value",
        "required": false,
        "privacy": "internal",
        "description": "Stable goal identity used for explicit MCP peer collaboration.",
        "example": "bibblio-business-success"
      },
      "planning_horizon_days": {
        "type": "domain_value",
        "required": false,
        "privacy": "internal",
        "description": "Founder-facing planning horizon, bounded from 30 to 365 days.",
        "example": 90
      },
      "input_folder": {
        "type": "local_path",
        "path_kind": "directory",
        "required": false,
        "privacy": "confidential",
        "description": "Local folder containing this co-worker's focused input file.",
        "example": "@/examples/sample_inputs"
      },
      "output_folder": {
        "type": "local_path",
        "path_kind": "directory",
        "required": false,
        "privacy": "confidential",
        "description": "Local folder for review-ready artifacts.",
        "example": "~/Downloads/bibblio"
      },
      "peer_mcp_servers": {
        "type": "domain_value",
        "required": false,
        "privacy": "confidential",
        "description": "Optional pre-approved MCP servers for peer co-worker jobs serving the same goal.",
        "example": []
      },
      "customer_feedback_file": {
        "type": "local_path",
        "path_kind": "file",
        "required": false,
        "privacy": "confidential",
        "description": "De-identified CSV of customer observations, journey stages, themes, and evidence status; the bundled demo uses parent feedback.",
        "example": "@/examples/sample_inputs/parent_feedback.csv"
      },
      "email_send_approval": {
        "type": "domain_value",
        "required": false,
        "privacy": "confidential",
        "description": "Explicit development-send decision. Delivery requires approved=true and a bounded approval_id; omission keeps SMTP disabled.",
        "example": {
          "approved": false
        }
      }
    },
    "outputs": {
      "primary": {
        "id": "final_artifact",
        "type": "final_artifact",
        "path": "final_artifact.json",
        "schema_version": "mn.blueprint.final_artifact_contract.v1",
      "required_fields": [
        "type",
        "business_name",
        "business_goal",
        "worker_role",
        "role_contribution",
        "north_star_question",
        "role_scorecard",
        "founder_decisions",
        "executive_summary",
          "recommended_action",
          "confidence",
          "evidence",
        "next_steps",
        "ninety_day_plan",
        "cross_functional_handoffs",
        "collaboration",
        "source_refs"
        ]
      },
      "artifacts": [
        {
          "artifact_id": "final_artifact",
          "type": "final_artifact",
          "path": "final_artifact.json",
          "producer": "customer_lifecycle_director",
          "mime_type": "application/json",
          "schema_version": "mn.blueprint.final_artifact.v1",
          "source_refs": [
            "inputs.json",
            "workflow_state/work_packets"
          ]
        },
        {
          "artifact_id": "customer_lifecycle_packet",
          "type": "customer_lifecycle_operating_brief",
          "path": "customer_lifecycle_packet.json",
          "producer": "customer_lifecycle_director",
          "mime_type": "application/json",
          "schema_version": "mn.business_success.role_brief.v1",
          "source_refs": [
            "inputs.json",
            "workflow_state/work_packets"
          ]
        },
        {
          "artifact_id": "mcp_exchange",
          "type": "mcp_job_exchange",
          "path": "collaboration/mcp_exchange.sqlite3",
          "producer": "mirrorneuron-goal-work-packet-skill",
          "mime_type": "application/vnd.sqlite3",
          "schema_version": "mn.mcp.job_exchange.v1",
          "source_refs": [
            "workflow_state/work_packets"
          ]
        },
        {
          "artifact_id": "development_reply_monitoring",
          "type": "development_reply_monitoring_status",
          "path": "development_reply_monitoring_state.json",
          "producer": "development_reply_monitor",
          "mime_type": "application/json",
          "schema_version": "mn.gtm_assistant.reply_monitoring.v1",
          "source_refs": [
            "confidential_lifecycle_email_delivery_receipt.json"
          ]
        }
      ]
    },
    "status": {
      "event": "blueprint_status",
      "heartbeat": true,
      "phases": [
        "loading_inputs",
        "running_worker",
        "waiting_for_human",
        "writing_artifacts",
        "monitoring_development_replies",
        "completed"
      ]
    },
    "privacy": {
      "default_classification": "confidential"
    }
  },
  "agents": {
    "auxiliary_entrypoints": [
      "mcp_collaboration_server"
    ],
    "extra_nodes": [
      {
        "node_id": "mcp_collaboration_server",
        "type": "stream",
        "agent_type": "executor",
        "alias": "mcp_collaboration_server",
        "display_name": "MCP Collaboration Server",
        "config": {
          "command": [
            "mn-job-mcp-server"
          ],
          "environment": {
            "MN_BLUEPRINT_ID": "gtm_assistant",
            "MN_MCP_GOAL_ID": "bibblio-business-success",
            "MN_MCP_PATH": "/mcp"
          },
          "no_auto_providers": true,
          "no_keep": true,
          "idempotent": true,
          "output_message_type": null,
          "pass_env": [
            "MN_MCP_CONTAINER_LOOPBACK_PROXY"
          ],
          "python_environment": {
            "packages": [
              "mirrorneuron-mcp-server-skill==1.2.31"
            ]
          },
          "runner_module": "MirrorNeuron.Runner.HostLocal",
          "safe_to_retry": true,
          "tty": false,
          "upload_as": ".",
          "upload_path": ".",
          "workdir": "/sandbox/job"
        },
        "resources": {
          "ports": [
            {
              "label": "mcp-collaboration",
              "port": "auto",
              "protocol": "http"
            }
          ]
        },
        "services": [
          {
            "address": "127.0.0.1",
            "name": "mn-job-collaboration",
            "port": "${env.MN_PORT_MCP_COLLABORATION}",
            "tags": [
              "mcp",
              "job-collaboration"
            ],
            "meta": {
              "blueprint_id": "gtm_assistant",
              "goal_id": "bibblio-business-success",
              "job_id": "${env.MN_JOB_ID}",
              "run_id": "${env.MN_RUN_ID}",
              "path": "/mcp",
              "transport": "streamable-http"
            },
            "checks": [
              {
                "name": "tcp-ready",
                "type": "tcp",
                "port": "${service.port}",
                "interval_ms": 100,
                "timeout_ms": 1000,
                "failures_before_critical": 3
              }
            ]
          }
        ]
      }
    ],
    "registry": {
      "customer_lifecycle_director": {
        "handler": "agents.customer_lifecycle_director",
        "role": "Customer Lifecycle and Product Intelligence Director"
      },
      "development_reply_monitor": {
        "handler": "agents.development_reply_monitor",
        "role": "Read-only Development Reply Monitor"
      }
    }
  },
  "llm": {
    "enabled": true,
    "mode": "actor_assisted",
    "mock_mode": "deterministic",
    "provider": "docker_model_runner",
    "model": "small",
    "runtime_model": "small",
    "backend": "llama.cpp",
    "default_config": "primary",
    "configs": {
      "primary": {
        "provider": "docker_model_runner",
        "model": "small",
        "runtime_model": "small",
        "backend": "llama.cpp",
        "temperature": 0.2,
        "max_tokens": 2400
      }
    },
    "responsibilities": [
      "Separate observed facts from assumptions.",
      "Preserve source references and name missing evidence.",
      "Draft review-ready recommendations without executing external actions."
    ],
    "agents": {
      "customer_lifecycle_director": {
        "llm_config": "primary",
        "role": "Customer Lifecycle and Product Intelligence Director",
        "responsibilities": [
          "Diagnose activation, retention, support, cancellation, and value-proof friction.",
          "Draft least-intrusive customer interventions and evidence-backed product briefs.",
          "Keep communications, sensitive support, refunds, and data changes human-controlled."
        ]
      },
      "development_reply_monitor": {
        "llm_config": "primary",
        "role": "Read-only Development Reply Monitor",
        "responsibilities": [
          "Keep the approved development service available for supervised MCP inspection.",
          "Read only matching development-reply headers without retaining message bodies.",
          "Report bounded reply counts and monitor state without sending an automated response."
        ]
      }
    }
  },
  "mcp_collaboration": {
    "enabled": true,
    "goal_id": "bibblio-business-success",
    "publication_state": "staged",
    "publish_local_exchange": true,
    "peer_reads_enabled": false,
    "include_staged_peer_records": true,
    "max_peer_servers": 8,
    "max_records_per_peer": 50,
    "note": "Internal workflow messages remain on Core. MCP exposes bounded goal work packets and development reply-monitoring status from separately launched co-worker jobs only when explicit peer configurations are approved."
  },
  "requirements": {
    "cpu": {
      "min_cores": 1
    },
    "memory": {
      "min_gb": 1
    },
    "disk": {
      "min_gb": 1
    },
    "gpu": {
      "min_count": 0
    }
  },
  "metadata": {
    "blueprint_id": "gtm_assistant",
    "runtime_features": [
      "de-identified feedback analysis",
      "draft customer interventions",
      "support escalation guards",
      "MCP aggregate product intelligence"
    ],
    "collaboration_group": "business-success-team",
    "business_goal": "Build a successful business for Bibblio.",
    "init_config_review": {
      "required": true,
      "instruction": "Configure the approved iCloud SMTP sender and one development test inbox. Credentials stay in the desktop OS credential store and are supplied only to the declared delivery worker at launch.",
      "fields": [
        {
          "path": "smtp_delivery.enabled",
          "label": "Enable Development Email Delivery",
          "type": "boolean",
          "default": false,
          "required": true,
          "description": "Allows the reviewed development-send step to run. Every email still requires a separate explicit approval for that run."
        },
        {
          "path": "smtp_delivery.host",
          "label": "SMTP Server",
          "type": "text",
          "default": "smtp.mail.me.com",
          "required": true,
          "active_when_any": [
            { "path": "smtp_delivery.enabled", "equals": true },
            { "path": "reply_monitoring.enabled", "equals": true }
          ],
          "description": "Outbound iCloud mail server. imap.mail.me.com on port 993 is only for reading incoming mail and is not supported here."
        },
        {
          "path": "smtp_delivery.port",
          "label": "SMTP Port",
          "type": "text",
          "default": "587",
          "required": true,
          "active_when_any": [
            { "path": "smtp_delivery.enabled", "equals": true },
            { "path": "reply_monitoring.enabled", "equals": true }
          ],
          "description": "The approved iCloud SMTP submission port."
        },
        {
          "path": "smtp_delivery.security",
          "label": "Connection Security",
          "type": "text",
          "default": "starttls",
          "required": true,
          "active_when_any": [
            { "path": "smtp_delivery.enabled", "equals": true },
            { "path": "reply_monitoring.enabled", "equals": true }
          ],
          "description": "GTM Assistant supports STARTTLS with smtp.mail.me.com on port 587. Optional reply monitoring uses the same approved identity through IMAP separately."
        },
        {
          "path": "smtp_credentials.username",
          "label": "SMTP Username / Sender Email",
          "type": "email",
          "default": "",
          "required": true,
          "active_when_any": [
            { "path": "smtp_delivery.enabled", "equals": true },
            { "path": "reply_monitoring.enabled", "equals": true }
          ],
          "environment_variable": "MN_SMTP_USERNAME",
          "description": "The iCloud email address that authenticates with SMTP and appears as the sender."
        },
        {
          "path": "smtp_credentials.app_password",
          "label": "App-Specific Password",
          "type": "password",
          "default": "",
          "required": true,
          "secret": true,
          "active_when_any": [
            { "path": "smtp_delivery.enabled", "equals": true },
            { "path": "reply_monitoring.enabled", "equals": true }
          ],
          "environment_variable": "MN_SMTP_PASSWORD",
          "description": "An Apple app-specific password. It is encrypted in the OS credential store and never saved in the co-worker registry or configuration JSON."
        },
        {
          "path": "smtp_credentials.development_recipient",
          "label": "Development Recipient",
          "type": "email",
          "default": "",
          "required": true,
          "active_when_any": [
            { "path": "smtp_delivery.enabled", "equals": true },
            { "path": "reply_monitoring.enabled", "equals": true }
          ],
          "environment_variable": "MN_SMTP_DEV_RECIPIENT",
          "description": "The single test inbox that may receive an explicitly approved development email. Only replies from this inbox that reference that development message are counted. This is not the sender address or a customer list."
        },
        {
          "path": "inputs.payload.email_send_approval.approved",
          "label": "Send Approved Development Email",
          "type": "boolean",
          "default": false,
          "required": false,
          "description": "Permits one development-only rendering check when paired with a bounded approval ID. It never authorizes customer messaging."
        },
        {
          "path": "inputs.payload.email_send_approval.approval_id",
          "label": "Development Send Approval ID",
          "type": "text",
          "default": "",
          "required": false,
          "active_when_any": [
            { "path": "inputs.payload.email_send_approval.approved", "equals": true }
          ],
          "description": "A bounded human approval reference for the one development-only send."
        },
        {
          "path": "reply_monitoring.enabled",
          "label": "Monitor Development Replies",
          "type": "boolean",
          "default": false,
          "required": false,
          "description": "After a successful approved development send, keep the co-worker running and read only matching IMAP reply headers. No reply is ever sent automatically."
        },
        {
          "path": "reply_monitoring.poll_interval_seconds",
          "label": "Reply Monitor Interval (seconds)",
          "type": "text",
          "default": "15",
          "required": false,
          "active_when_any": [
            { "path": "reply_monitoring.enabled", "equals": true }
          ],
          "description": "How often the read-only development inbox monitor checks for replies, bounded between 5 and 300 seconds."
        }
      ]
    },
    "job_data": {
      "resources": [
        {
          "name": "state",
          "path": "state",
          "access": "read_write"
        }
      ]
    }
  },
  "workflow": {
    "workflow_id": "gtm_assistant_v3",
    "execution": {
      "strategy": "serial"
    },
    "policy": {
      "failure": {
        "default": "fail_closed"
      },
      "human": {
        "enabled": true,
        "mode": "approval_required",
        "allowed_decisions": [
          "approve",
          "revise",
          "reject"
        ],
        "blocked_actions": [
          "send_external_communications",
          "publish_child_facing_content",
          "spend_money",
          "change_pricing",
          "change_data_collection"
        ],
        "default_action": "reject",
        "timeout_seconds": 86400
      }
    },
    "steps": [
      {
        "id": "diagnose_customer_journey",
        "kind": "source",
        "label": "Diagnose Customer Journey",
        "goal": "Identify activation, retention, support, and value-proof friction from de-identified evidence.",
        "needs": [],
        "run": {
          "definition": "steps.diagnose_customer_journey"
        },
        "control": {
          "required": true,
          "timeout_seconds": 900,
          "failure_policy": "fail_workflow",
          "retry": {
            "max_attempts": 2,
            "backoff_seconds": 1,
            "backoff_multiplier": 2,
            "jitter": 0
          },
          "uncertainty": {
            "min_confidence": 0,
            "on_low_confidence": "continue_with_warning"
          }
        }
      },
      {
        "id": "publish_customer_lifecycle_packet",
        "kind": "sink",
        "label": "Publish Customer Lifecycle Brief",
        "goal": "Publish aggregate product intelligence and draft interventions without contacting customers.",
        "needs": [
          "diagnose_customer_journey"
        ],
        "run": {
          "definition": "steps.publish_customer_lifecycle_packet"
        },
        "control": {
          "required": true,
          "timeout_seconds": 900,
          "failure_policy": "fail_workflow",
          "retry": {
            "max_attempts": 2,
            "backoff_seconds": 1,
            "backoff_multiplier": 2,
            "jitter": 0
          },
          "uncertainty": {
            "min_confidence": 0,
            "on_low_confidence": "continue_with_warning"
          }
        }
      },
      {
        "id": "deliver_approved_lifecycle_email",
        "kind": "sink",
        "label": "Deliver Approved Development Lifecycle Email",
        "goal": "Fail closed unless one aggregate lifecycle draft has explicit approval and a secret-injected single test recipient.",
        "needs": [
          "publish_customer_lifecycle_packet"
        ],
        "run": {
          "definition": "steps.deliver_approved_lifecycle_email"
        },
        "control": {
          "required": true,
          "timeout_seconds": 60,
          "failure_policy": "fail_workflow",
          "retry": {
            "max_attempts": 1,
            "backoff_seconds": 0,
            "backoff_multiplier": 1,
            "jitter": 0
          },
          "uncertainty": {
            "min_confidence": 0,
            "on_low_confidence": "continue_with_warning"
          }
        }
      },
      {
        "id": "monitor_development_email_replies",
        "kind": "sink",
        "label": "Monitor Development Email Replies",
        "goal": "Keep the approved development run available for MCP while reading only matching reply headers until manually stopped.",
        "needs": [
          "deliver_approved_lifecycle_email"
        ],
        "run": {
          "definition": "steps.monitor_development_email_replies"
        },
        "control": {
          "required": true,
          "timeout_seconds": 86400,
          "failure_policy": "fail_workflow",
          "retry": {
            "max_attempts": 1,
            "backoff_seconds": 0,
            "backoff_multiplier": 1,
            "jitter": 0
          },
          "uncertainty": {
            "min_confidence": 0,
            "on_low_confidence": "continue_with_warning"
          }
        }
      }
    ]
  },
  "manifest": {
    "type": "service"
  },
  "service": {
    "enabled": true,
    "manual_close": "Stop the co-worker in OtterDesk, send SIGTERM, or create the configured STOP file.",
    "run_until": "manual_stop",
    "state_artifact": "development_reply_monitoring_state.json",
    "stop_file": "${MN_RUN_DIR}/STOP"
  },
  "skill_dependencies": [
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-email-delivery-skill",
      "version": "1.2.31"
    },
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-mcp-client-skill",
      "version": "1.2.31"
    },
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-mcp-server-skill",
      "version": "1.2.31"
    },
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-goal-work-packet-skill",
      "version": "1.2.31"
    },
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-marketing-email-skill",
      "version": "1.2.31"
    }
  ],
  "agent_dependencies": [
    {
      "type": "pip",
      "source": "gar",
      "name": "mn-prototype-stateful-step-agent",
      "version": "1.2.31"
    },
    {
      "type": "pip",
      "source": "gar",
      "name": "mn-prototype-supervised-service-agent",
      "version": "1.2.31"
    }
  ],
  "type": "service"
}
