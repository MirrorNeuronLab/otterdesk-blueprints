{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/extensions/blocks.schema.json",
  "steps": {
    "read_ct_volume": {
      "uses": "mn.blocks.native_computation@1",
      "hooks": {
        "request": "domain.native_inference:prepare",
        "validate": "domain.native_inference:accepted",
        "project": "domain.reporting:publish"
      },
      "inputs": {
        "ct_file": {
          "$ref": "run_input",
          "path": [
            "ct_file"
          ]
        },
        "region": {
          "$ref": "run_input",
          "path": [
            "region"
          ]
        },
        "prompt": {
          "$ref": "run_input",
          "path": [
            "prompt"
          ]
        },
        "supervisor_instructions": {
          "$ref": "run_input",
          "path": [
            "supervisor_instructions"
          ]
        }
      },
      "limits": {
        "max_calls": 1,
        "timeout_seconds": 900
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "ct_file": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "enum": [
              "chest",
              "abdomen"
            ]
          },
          "prompt": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "supervisor_instructions": {
            "type": "array"
          }
        },
        "required": [
          "ct_file",
          "region"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": [
          "research_only",
          "notice",
          "report",
          "artifacts"
        ],
        "properties": {
          "research_only": {
            "const": true
          },
          "artifacts": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "config": {
        "model": "ct",
        "request_timeout_seconds": 600,
        "response_schema": {
          "type": "object",
          "properties": {
            "research_only": {
              "const": true
            },
            "answer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32000
            },
            "model_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "research_only",
            "answer",
            "model_revision"
          ],
          "examples": [
            {
              "research_only": true,
              "answer": "Simulated output for workflow testing. No scan findings were evaluated.",
              "model_revision": "simulated"
            }
          ]
        }
      }
    }
  }
}
