{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/manifest.schema.json",
  "id": "litigation_analyst",
  "name": "Litigation Analyst",
  "version": "5.1.0",
  "description": "Make sense of a large collection of case documents. Find important facts, timelines, connections, and conflicting evidence, with links to the original sources. Get draft findings for legal review.",
  "workflow": "workflow.json",
  "execution": "execution.json",
  "contracts": "contracts.json",
  "config": "config/default.json",
  "dependencies": "dependencies.json",
  "license": "LICENSE.md",
  "terms": "TERM.md",
  "extensions": {
    "mn.product": {
      "file": "extensions/product.json",
      "required": false
    },
    "mn.response": {
      "file": "extensions/response.json",
      "required": true
    },
    "mn.llm": {
      "file": "extensions/llm.json",
      "required": true
    },
    "mn.ui": {
      "file": "extensions/ui.json",
      "required": false
    },
    "mn.context": {
      "file": "extensions/context.json",
      "required": true
    },
    "mn.storage": {
      "file": "extensions/storage.json",
      "required": true
    },
    "mn.mcp": {
      "file": "extensions/mcp.json",
      "required": true
    },
    "mn.blocks": {
      "file": "extensions/blocks.json",
      "required": true
    }
  }
}
