{
  "inputs": {
    "adapter": "json",
    "payload": {
      "goal": "Give me a financial criminal investigation report on those data"
    }
  },
  "investigation": {
    "top_k": 3,
    "access_scope": "case",
    "max_files": 5000,
    "max_file_bytes": 33554432,
    "max_total_bytes": 268435456,
    "max_skill_invocations": 5000,
    "max_model_decisions": 5000,
    "max_investigation_seconds": 99999
  },
  "skill_runtime": {
    "enabled": true,
    "driver": "docker_worker",
    "docker_worker_image": "docker_worker",
    "image": "mirror-neuron/litigation-analyst:local",
    "install_scope": "shared_job_container"
  },
  "outputs": {
    "folder_path": "~/Downloads/litigation_analyst"
  },
  "context_memory": {
    "enabled": true,
    "contract": "mn.context.working.v1",
    "policy": {
      "window_tokens": 16384,
      "output_tokens": 2048,
      "max_calls": 5000,
      "final_call_reserve": 4
    }
  },
  "dynamic_investigation": {
    "max_rounds": 3,
    "hypotheses_per_round": 2
  }
}
