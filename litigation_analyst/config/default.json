{
  "inputs": {
    "adapter": "json",
    "payload": {
      "goal": "Investigate financially relevant events and competing explanations in the supplied materials. Cite the evidence and state limitations.",
      "review_file": ""
    }
  },
  "investigation": {
    "top_k": 3,
    "access_scope": "case",
    "max_files": 5000,
    "max_file_bytes": 33554432,
    "max_total_bytes": 268435456,
    "max_skill_invocations": 5000,
    "max_model_decisions": 5000,
    "max_investigation_seconds": 99999
  },
  "skill_runtime": {
    "enabled": true,
    "driver": "docker_worker",
    "docker_worker_image": "docker_worker",
    "image": "mirror-neuron/litigation-analyst:local",
    "install_scope": "shared_job_container"
  },
  "outputs": {
    "folder_path": "~/Downloads/litigation-analyst"
  },
  "context_memory": {
    "policy": {
      "window_tokens": 16384,
      "output_tokens": 2048,
      "max_calls": 5000,
      "final_call_reserve": 4
    }
  },
  "dynamic_investigation": {
    "max_rounds": 3,
    "hypotheses_per_round": 2
  },
  "text_memory": {
    "enabled": true,
    "quality_verification": false,
    "max_results": 6,
    "max_context_bytes": 32768
  },
  "source_context": {
    "enabled": true
  },
  "source_relationships": {
    "mode": "hybrid",
    "model": "docker.io/ai/nemotron-3.5-lightning:latest",
    "context_tokens": 131072,
    "max_calls": 256,
    "max_unit_bytes": 24000,
    "max_units_per_document": 512,
    "graph_max_hops": 4,
    "graph_max_edges": 49
  },
  "local_inputs": {
    "folders": [
      {
        "config_path": "inputs.payload.input_folder",
        "payload_path": "mn_local_inputs/case",
        "runtime_path": "mn_local_inputs/case",
        "allowed_extensions": [
          "*"
        ]
      }
    ],
    "files": [
      {
        "config_path": "inputs.payload.review_file",
        "payload_path": "mn_local_inputs/review-decisions.json",
        "runtime_path": "mn_local_inputs/review-decisions.json"
      }
    ]
  },
  "workspace": {
    "matter_name": "Litigation investigation",
    "authorized_source_ids": null,
    "max_page_bytes": 33554432
  }
}
