{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/workflow.schema.json",
  "workflow_id": "litigation_analyst_v2",
  "steps": [
    {
      "id": "prepare_case_sources",
      "kind": "source",
      "label": "Prepare Case Sources",
      "goal": "Inventory and normalize legal sources with exact provenance.",
      "needs": [],
      "control": {
        "timeout_seconds": 3600
      }
    },
    {
      "id": "build_case_indexes",
      "kind": "stage",
      "label": "Build Evidence Indexes",
      "goal": "Build and validate the frozen document index and observed graph before investigation.",
      "needs": [
        "prepare_case_sources"
      ],
      "control": {
        "timeout_seconds": 99999
      }
    },
    {
      "id": "investigate_case_evidence",
      "kind": "stage",
      "label": "Investigate Case Evidence",
      "goal": "Test neutral hypotheses against bounded document and graph evidence.",
      "needs": [
        "build_case_indexes"
      ],
      "control": {
        "timeout_seconds": 99999
      }
    },
    {
      "id": "write_review_draft",
      "kind": "sink",
      "label": "Publish investigation workspace",
      "goal": "Verify exact citations and publish a source-linked interactive investigation, immutable snapshot history and review draft.",
      "needs": [
        "investigate_case_evidence"
      ],
      "control": {
        "timeout_seconds": 3600
      }
    }
  ],
  "defaults": {
    "step": {
      "control": {
        "failure_policy": "fail_workflow",
        "retry": {
          "max_attempts": 1
        }
      }
    }
  },
  "child_workflows": {
    "investigate_case_evidence": {
      "planner": "plan_litigation_round",
      "templates": {
        "plan_litigation_round": {
          "control": {
            "timeout_seconds": 600,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": []
          }
        },
        "collect_litigation_evidence": {
          "run": {
            "handler": "mn_sdk.integrations.block_worker",
            "with": {
              "revision": "litigation_analyst@5.0.2",
              "instance": {
                "uses": "mn.blocks.domain_operation@1",
                "hooks": {
                  "operation": "domain.round_tasks:collect_evidence"
                },
                "input_schema": {
                  "type": "object",
                  "required": [
                    "task",
                    "_child"
                  ]
                },
                "limits": {
                  "max_calls": 1,
                  "timeout_seconds": 600
                }
              }
            }
          },
          "control": {
            "timeout_seconds": 600,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        },
        "assess_litigation_hypothesis": {
          "run": {
            "handler": "mn_sdk.integrations.block_worker",
            "with": {
              "revision": "litigation_analyst@5.0.2",
              "instance": {
                "uses": "mn.blocks.domain_operation@1",
                "hooks": {
                  "operation": "domain.round_tasks:assess_hypothesis"
                },
                "input_schema": {
                  "type": "object",
                  "required": [
                    "task",
                    "_child"
                  ]
                },
                "limits": {
                  "max_calls": 1,
                  "timeout_seconds": 600
                }
              }
            }
          },
          "control": {
            "timeout_seconds": 600,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        },
        "review_litigation_finding": {
          "run": {
            "handler": "mn_sdk.integrations.block_worker",
            "with": {
              "revision": "litigation_analyst@5.0.2",
              "instance": {
                "uses": "mn.blocks.domain_operation@1",
                "hooks": {
                  "operation": "domain.round_tasks:review_finding"
                },
                "input_schema": {
                  "type": "object",
                  "required": [
                    "task",
                    "_child"
                  ]
                },
                "limits": {
                  "max_calls": 1,
                  "timeout_seconds": 600
                }
              }
            }
          },
          "control": {
            "timeout_seconds": 600,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        },
        "summarize_litigation_round": {
          "run": {
            "handler": "mn_sdk.integrations.block_worker",
            "with": {
              "revision": "litigation_analyst@5.0.2",
              "instance": {
                "uses": "mn.blocks.domain_operation@1",
                "hooks": {
                  "operation": "domain.round_tasks:summarize_round"
                },
                "input_schema": {
                  "type": "object",
                  "required": [
                    "task",
                    "_child"
                  ]
                },
                "limits": {
                  "max_calls": 1,
                  "timeout_seconds": 600
                }
              }
            }
          },
          "control": {
            "timeout_seconds": 600,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        }
      },
      "inputs": {
        "seed": [
          "outputs",
          "result"
        ]
      },
      "outputs": {
        "result": [
          "result"
        ]
      },
      "max_rounds": 3,
      "max_steps_per_round": 7
    }
  }
}
