{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/workflow.schema.json",
  "workflow_id": "litigation_analyst_v2",
  "steps": [
    {
      "id": "prepare_case_sources",
      "kind": "source",
      "label": "Prepare Case Sources",
      "goal": "Inventory and normalize legal sources with exact provenance.",
      "needs": [],
      "run": {
        "definition": "steps.prepare_case_sources"
      },
      "control": {
        "timeout_seconds": 3600
      }
    },
    {
      "id": "build_case_indexes",
      "kind": "stage",
      "label": "Build Evidence Indexes",
      "goal": "Build and validate the frozen document index and observed graph before investigation.",
      "needs": [
        "prepare_case_sources"
      ],
      "run": {
        "definition": "steps.build_case_indexes"
      },
      "control": {
        "timeout_seconds": 3600
      }
    },
    {
      "id": "investigate_case_evidence",
      "kind": "stage",
      "label": "Investigate Case Evidence",
      "goal": "Test neutral hypotheses against bounded document and graph evidence.",
      "needs": [
        "build_case_indexes"
      ],
      "run": {
        "definition": "steps.investigate_case_evidence"
      },
      "control": {
        "timeout_seconds": 99999
      }
    },
    {
      "id": "write_review_draft",
      "kind": "sink",
      "label": "Write Review Draft",
      "goal": "Verify evidence citations and write a human-review draft and audit index.",
      "needs": [
        "investigate_case_evidence"
      ],
      "run": {
        "definition": "steps.write_review_draft"
      },
      "control": {
        "timeout_seconds": 3600
      }
    }
  ],
  "defaults": {
    "step": {
      "control": {
        "failure_policy": "fail_workflow",
        "retry": {
          "max_attempts": 1
        }
      }
    }
  },
  "child_workflows": {
    "investigate_case_evidence": {
      "planner": "plan_litigation_round",
      "templates": {
        "plan_litigation_round": {
          "run": {
            "handler": "agents.litigation_round_planner"
          },
          "control": {
            "timeout_seconds": 600,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": []
          }
        },
        "collect_litigation_evidence": {
          "run": {
            "handler": "agents.litigation_evidence_collector"
          },
          "control": {
            "timeout_seconds": 600,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        },
        "assess_litigation_hypothesis": {
          "run": {
            "handler": "agents.litigation_hypothesis_assessor"
          },
          "control": {
            "timeout_seconds": 600,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        },
        "review_litigation_finding": {
          "run": {
            "handler": "agents.litigation_finding_reviewer"
          },
          "control": {
            "timeout_seconds": 600,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        },
        "summarize_litigation_round": {
          "run": {
            "handler": "agents.litigation_round_summarizer"
          },
          "control": {
            "timeout_seconds": 600,
            "retry": {
              "max_attempts": 1
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "task"
            ]
          }
        }
      },
      "inputs": {
        "context": [
          "outputs",
          "result",
          "context"
        ]
      },
      "outputs": {
        "result": []
      },
      "max_rounds": 3,
      "max_steps_per_round": 7
    }
  }
}
