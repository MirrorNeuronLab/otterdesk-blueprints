{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/execution.schema.json",
  "mode": "compiled",
  "job_name": "litigation-analyst",
  "agents": {
    "registry": {
      "case_document_examiner": {
        "handler": "agents.case_document_examiner",
        "role": "Case Document Examiner"
      },
      "litigation_investigator": {
        "handler": "agents.litigation_investigator",
        "role": "Litigation Investigator"
      },
      "litigation_draft_editor": {
        "handler": "agents.litigation_draft_editor",
        "role": "Litigation Draft Editor"
      },
      "case_index_builder": {
        "handler": "agents.case_index_builder"
      },
      "litigation_round_planner": {
        "handler": "agents.litigation_round_planner",
        "role": "Litigation Round Planner"
      },
      "litigation_evidence_collector": {
        "handler": "agents.litigation_evidence_collector",
        "role": "Litigation Evidence Collector"
      },
      "litigation_hypothesis_assessor": {
        "handler": "agents.litigation_hypothesis_assessor",
        "role": "Litigation Hypothesis Assessor"
      },
      "litigation_finding_reviewer": {
        "handler": "agents.litigation_finding_reviewer",
        "role": "Litigation Finding Reviewer"
      },
      "litigation_round_summarizer": {
        "handler": "agents.litigation_round_summarizer",
        "role": "Litigation Round Summarizer"
      }
    }
  },
  "requirements": {
    "cpu": {
      "min_cores": 2
    },
    "memory": {
      "min_gb": 4
    },
    "disk": {
      "min_gb": 8
    },
    "network": {
      "egress": "EMC2 GitHub download during preparation; configured local model only during analysis"
    }
  },
  "workers": {
    "groups": [
      {
        "steps": [
          "prepare_case_sources",
          "build_case_indexes",
          "write_review_draft",
          "plan_litigation_round",
          "collect_litigation_evidence",
          "assess_litigation_hypothesis",
          "review_litigation_finding",
          "summarize_litigation_round"
        ],
        "uses": "mn-agents.worker.python_docker@1",
        "with": {
          "stereotype": [
            "blueprint_docker_worker",
            "internal_write_worker"
          ],
          "docker_worker_image": "docker_worker",
          "image": "mirror-neuron/litigation-analyst:local",
          "dockerfile": "docker_worker/Dockerfile",
          "build_context": ".",
          "workdir": "/app",
          "timeout_seconds": 3600,
          "upload_paths": [
            {
              "source": "domain",
              "target": "domain"
            },
            {
              "source": "agents",
              "target": "agents"
            },
            {
              "source": "steps",
              "target": "steps"
            },
            {
              "source": "runtime",
              "target": "runtime"
            }
          ]
        }
      },
      {
        "steps": [
          "investigate_case_evidence"
        ],
        "uses": "mn-agents.worker.python_docker@1",
        "with": {
          "stereotype": [
            "blueprint_docker_worker",
            "internal_write_worker"
          ],
          "docker_worker_image": "docker_worker",
          "image": "mirror-neuron/litigation-analyst:local",
          "dockerfile": "docker_worker/Dockerfile",
          "build_context": ".",
          "workdir": "/app",
          "timeout_seconds": 99999,
          "upload_paths": [
            {
              "source": "domain",
              "target": "domain"
            },
            {
              "source": "agents",
              "target": "agents"
            },
            {
              "source": "steps",
              "target": "steps"
            },
            {
              "source": "runtime",
              "target": "runtime"
            }
          ]
        }
      }
    ]
  },
  "required_context_engine": true
}
