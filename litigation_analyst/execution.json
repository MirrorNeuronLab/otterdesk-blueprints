{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/execution.schema.json",
  "mode": "compiled",
  "job_name": "litigation-analyst",
  "agents": {
    "registry": {}
  },
  "requirements": {
    "cpu": {
      "min_cores": 2
    },
    "memory": {
      "min_gb": 4
    },
    "disk": {
      "min_gb": 8
    },
    "network": {
      "egress": "Optional pinned sample download during preparation; the SDK-managed gateway for the configured default model provider during analysis."
    },
    "gpu": {
      "min_count": 1,
      "min_memory_mb": 49152,
      "memory_operator": ">=",
      "enforcement": "hard"
    }
  },
  "workers": {
    "groups": [
      {
        "steps": [
          "prepare_case_sources",
          "build_case_indexes",
          "write_review_draft",
          "plan_litigation_round",
          "collect_litigation_evidence",
          "assess_litigation_hypothesis",
          "review_litigation_finding",
          "summarize_litigation_round",
          "investigate_case_evidence"
        ],
        "uses": "mn-agents.worker.python_docker@1",
        "with": {
          "stereotype": [
            "blueprint_docker_worker",
            "internal_write_worker"
          ],
          "docker_worker_image": "docker_worker",
          "image": "mirror-neuron/litigation-analyst:local",
          "dockerfile": "docker_worker/Dockerfile",
          "build_context": ".",
          "workdir": "/app",
          "upload_paths": [
            {
              "source": "domain",
              "target": "domain"
            }
          ]
        }
      }
    ]
  },
  "remote_model_requirements": {
    "config_path": "llm.model",
    "requirements": {
      "memory": {
        "min_gb": 16
      },
      "gpu": {
        "min_count": 1,
        "enforcement": "hard"
      }
    }
  }
}
