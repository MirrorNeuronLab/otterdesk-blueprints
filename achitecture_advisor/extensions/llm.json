{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/extensions/llm.schema.json",
  "enabled": true,
  "mode": "live",
  "provider": "docker_model_runner",
  "model": "default",
  "backend": "llama.cpp",
  "require_live": true,
  "default_config": "primary",
  "configs": {
    "primary": {
      "provider": "docker_model_runner",
      "model": "default",
      "backend": "llama.cpp",
      "api_base": "auto",
      "timeout_seconds": 180,
      "max_tokens": 1500,
      "num_retries": 1,
      "required": true
    }
  }
}
