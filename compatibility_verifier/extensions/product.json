{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/extensions/product.schema.json",
  "category": "Engineering",
  "product": {
    "agent_role": "Compatibility verifier",
    "input": "A local source folder, an optional verification scope, and pinned runner evidence when required.",
    "output": "An evidence-backed verdict with developer findings in Markdown, JSON and a local web report.",
    "how_it_works": "Compare cross-service journeys across captured revisions and identify the first stage that diverged.",
    "collaboration": {
      "schema": "mn.collaboration.group.v1",
      "topology": "group",
      "protocol": "software-verification.v1",
      "goalId": "software-verification",
      "accepts": [
        "software_verifier_suite",
        "functional_verifier",
        "security_verifier",
        "reliability_verifier"
      ],
      "goalKey": "inputs.payload.goal_id",
      "commonGoalKey": "inputs.payload.common_goal",
      "groupKey": "inputs.payload.collaboration_group_id",
      "peersKey": "inputs.payload.collaboration_peers",
      "maxMembers": 5,
      "sameRuntime": false,
      "managerBlueprintId": "software_verifier_suite",
      "delivery": "mailbox"
    }
  }
}
