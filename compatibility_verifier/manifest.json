{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/manifest.schema.json",
  "id": "compatibility_verifier",
  "name": "Compatibility verifier",
  "tagline": "Check interfaces and integrated builds",
  "version": "1.2.0",
  "payload_api": "mn.blueprint.v1",
  "description": "Compare public exports, command entry points and protected customer-facing contracts across revisions.",
  "workflow": "workflow.json",
  "execution": "execution.json",
  "contracts": "contracts.json",
  "config": "config/default.json",
  "dependencies": "dependencies.json",
  "license": "LICENSE.md",
  "terms": "TERM.md",
  "extensions": {
    "mn.blocks": {
      "file": "extensions/blocks.json",
      "required": true
    },
    "mn.product": {
      "file": "extensions/product.json",
      "required": false
    },
    "mn.context": {
      "file": "extensions/context.json",
      "required": true
    },
    "mn.response": {
      "file": "extensions/response.json",
      "required": true
    },
    "mn.mcp": {
      "file": "extensions/mcp.json",
      "required": true
    },
    "mn.rag": {
      "file": "extensions/rag.json",
      "required": true
    },
    "mn.ui": {
      "file": "extensions/ui.json",
      "required": false
    }
  }
}
