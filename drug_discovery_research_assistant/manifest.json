{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/manifest.schema.json",
  "id": "drug_discovery_research_assistant",
  "name": "Drug Discovery Research Assistant",
  "version": "4.0.0",
  "description": "Explore possible starting points for drug research. Get five proposed molecules, a comparison of their computer-based screening results, and supporting evidence to help plan further study. Results are research ideas, not proven treatments.",
  "workflow": "workflow.json",
  "execution": "execution.json",
  "contracts": "contracts.json",
  "config": "config/default.json",
  "license": "LICENSE.md",
  "terms": "TERM.md",
  "dependencies": "dependencies.json",
  "extensions": {
    "mn.agentic": {
      "file": "extensions/agentic.json",
      "required": true
    },
    "mn.airgap": {
      "file": "extensions/airgap.json",
      "required": true
    },
    "mn.context": {
      "file": "extensions/context.json",
      "required": true
    },
    "mn.domain": {
      "file": "extensions/domain.json",
      "required": true
    },
    "mn.llm": {
      "file": "extensions/llm.json",
      "required": true
    },
    "mn.product": {
      "file": "extensions/product.json",
      "required": false
    },
    "mn.rag": {
      "file": "extensions/rag.json",
      "required": true
    },
    "mn.response": {
      "file": "extensions/response.json",
      "required": true
    },
    "mn.storage": {
      "file": "extensions/storage.json",
      "required": true
    },
    "mn.testing": {
      "file": "extensions/testing.json",
      "required": false
    },
    "mn.ui": {
      "file": "extensions/ui.json",
      "required": false
    },
    "mn.mcp": {
      "file": "extensions/mcp.json",
      "required": true
    },
    "mn.blocks": {
      "file": "extensions/blocks.json",
      "required": true
    }
  }
}
