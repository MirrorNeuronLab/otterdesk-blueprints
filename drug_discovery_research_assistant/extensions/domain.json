{
  "$schema": "https://mirrorneuron.dev/schemas/blueprint/v1/extensions/domain.schema.json",
  "metadata": {
    "interfaces": {
      "channels": {
        "agentic_research": {
          "config": "agentic_research",
          "description": "Bounded LLM-selected or actor-guided tool contract for domain work."
        },
        "artifacts": {
          "artifacts": [
            "run.json",
            "config.json",
            "inputs.json",
            "events.jsonl",
            "result.json",
            "final_artifact.json",
            "cycle_progress.json",
            "leading_candidate.json",
            "leading_candidate.svg"
          ],
          "description": "Stable run-store files and domain-specific outputs.",
          "optional_artifacts": [
            "job.json",
            "web_ui.json",
            "ui.json",
            "web/index.html",
            "logs.jsonl"
          ]
        },
        "events": {
          "artifact": "events.jsonl",
          "description": "Append-only workflow events."
        },
        "human": {
          "artifact": "human.jsonl",
          "description": "Human notices, approval requests, responses, timeouts, and applied decisions."
        },
        "input_skills": {
          "description": "Connector-backed or reusable skill-backed input sources."
        },
        "inputs": {
          "artifact": "inputs.json",
          "description": "Resolved runtime inputs and adapter provenance."
        },
        "knowledge_rag": {
          "artifact": "knowledge/",
          "config": "knowledge_rag",
          "description": "Optional local blueprint knowledge retrieval used to ground actor prompts and tool planning.",
          "privacy": "blueprint knowledge only by default"
        },
        "logs": {
          "description": "Runtime stdout/stderr and explicit log artifacts.",
          "stream": "stdout/stderr"
        },
        "output_skills": {
          "description": "Optional fan-out destinations after local run-store writes."
        },
        "outputs": {
          "artifacts": [
            "result.json",
            "final_artifact.json",
            "cycle_progress.json",
            "leading_candidate.json",
            "leading_candidate.svg"
          ],
          "description": "Live cycle progress, the primary result, and the final user-facing artifact."
        },
        "resources": {
          "artifact": "resources.jsonl",
          "description": "Resource samples such as token, runtime, connector, and disk usage."
        },
        "streams": {
          "default": [
            "events"
          ],
          "description": "Named data or event streams exposed by the blueprint.",
          "kinds": [
            "audio",
            "video",
            "data",
            "multimodal"
          ],
          "transports": [
            "file",
            "http",
            "https",
            "rtsp",
            "rtmp",
            "webrtc",
            "websocket",
            "socketio",
            "tcp",
            "udp",
            "sse",
            "kafka",
            "mqtt",
            "custom"
          ]
        },
        "web_ui": {
          "artifacts": [
            "web_ui.json",
            "ui.json"
          ],
          "description": "Job-scoped progress dashboard with a leading-candidate molecule preview."
        }
      },
      "config_sections": [
        "standard_version",
        "identity",
        "mode",
        "metadata",
        "inputs",
        "simulation",
        "llm",
        "outputs",
        "logging",
        "resources",
        "human_control",
        "real_adapters",
        "streams",
        "input_skills",
        "output_skills",
        "error_handling",
        "state",
        "capabilities",
        "privacy",
        "triggers",
        "backpressure",
        "determinism",
        "schemas",
        "budgets",
        "agent_handoffs",
        "web_ui",
        "interfaces",
        "execution_model",
        "suggested_schedule",
        "knowledge_rag",
        "agentic_research"
      ],
      "identity": [
        "blueprint_id",
        "name",
        "run_id"
      ],
      "input_adapters": [
        "mock",
        "json",
        "file",
        "env_json"
      ],
      "optional_outputs": [
        "job.json",
        "web_ui.json",
        "ui.json",
        "web/index.html",
        "logs.jsonl"
      ],
      "output_adapters": [
        "local_run_store"
      ],
      "outputs": [
        "run.json",
        "config.json",
        "inputs.json",
        "events.jsonl",
        "result.json",
        "final_artifact.json"
      ],
      "response_schema": "mn.blueprint.response.v1",
      "stream_kinds": [
        "audio",
        "video",
        "data",
        "multimodal"
      ],
      "stream_transports": [
        "file",
        "http",
        "https",
        "rtsp",
        "rtmp",
        "webrtc",
        "websocket",
        "socketio",
        "tcp",
        "udp",
        "sse",
        "kafka",
        "mqtt",
        "custom"
      ],
      "web_ui_adapters": [
        "none",
        "static_html",
        "external_url",
        "custom"
      ]
    },
    "status_logging": {
      "env": "MN_BLUEPRINT_LOG_LEVEL",
      "format": "jsonl",
      "stream": "stderr"
    }
  }
}
