{
  "apiVersion": "mn.workflow.source/v2",
  "kind": "WorkflowSource",
  "standard": {
    "profile": "blueprint",
    "source_schema": "mn.workflow.source/v2",
    "target_schema": "mn.workflow/v1",
    "migration_policy": "sdk_managed"
  },
  "identity": {
    "id": "bibblio_content_studio_coworker",
    "name": "Bibblio Content Studio Co-worker",
    "job_name": "bibblio-content-studio-coworker",
    "category": "business",
    "version": 1,
    "manifest_version": "1.0"
  },
  "description": "A focused content-production co-worker that accepts only learning-approved briefs, creates versioned draft package structures, runs production checks, and stops at mandatory review.",
  "intent": {
    "description": "AI Personalized Learning Content Studio Director serving one shared goal: turn Bibblio into a profitable business.",
    "problem": "Bibblio needs a reliable, economical way to turn approved learning objectives into complete reusable content packages without bypassing curriculum or child-safety review.",
    "target_users": "Bibblio's founder and designated content, learning, safety, brand, accessibility, and production reviewers.",
    "safety": {
      "enabled": true,
      "mode": "approval_required",
      "allowed_decisions": [
        "approve",
        "revise",
        "reject"
      ],
      "blocked_actions": [
        "send_external_communications",
        "publish_child_facing_content",
        "spend_money_or_launch_paid_campaigns",
        "change_pricing_or_subscription_terms",
        "make_learning_medical_or_therapeutic_claims",
        "change_child_or_family_data_collection"
      ],
      "default_action": "reject",
      "timeout_seconds": 86400,
      "reason": "The co-worker observes, analyzes, drafts, and queues; a designated human approves every consequential external action."
    }
  },
  "config": {
    "default": "config/default.json",
    "embed": true,
    "manifest_defaults": [
      "llm",
      "mcp_collaboration",
      {
        "from": "requirements",
        "to": "resources"
      },
      {
        "from": "workflow.policy.human",
        "to": "human_control"
      },
      {
        "from": "identity.id",
        "to": "identity.blueprint_id"
      },
      {
        "from": "identity.name",
        "to": "identity.name"
      }
    ]
  },
  "defaults": {
    "worker": {
      "with": {
        "stereotype": "internal_write_worker",
        "image": "mirror-neuron/bibblio-content-studio-coworker:local",
        "upload_paths": [
          {
            "source": "domain",
            "target": "domain"
          }
        ]
      }
    }
  },
  "contracts": {
    "input_adapters": {
      "default": "mock",
      "resolved_artifact": "inputs.json",
      "supported": [
        "mock",
        "json",
        "file",
        "env_json"
      ]
    },
    "inputs": {
      "business_goal": {
        "type": "domain_value",
        "required": false,
        "privacy": "internal",
        "description": "Shared business goal served by all five independently launched Bibblio co-workers.",
        "example": "Turn Bibblio into a profitable business."
      },
      "goal_id": {
        "type": "domain_value",
        "required": false,
        "privacy": "internal",
        "description": "Stable goal identity used for explicit MCP peer collaboration.",
        "example": "bibblio-profitable-business"
      },
      "input_folder": {
        "type": "local_path",
        "path_kind": "directory",
        "required": false,
        "privacy": "confidential",
        "description": "Local folder containing this co-worker's focused input file.",
        "example": "@/examples/sample_inputs"
      },
      "output_folder": {
        "type": "local_path",
        "path_kind": "directory",
        "required": false,
        "privacy": "confidential",
        "description": "Local folder for review-ready artifacts.",
        "example": "~/Downloads/bibblio"
      },
      "peer_mcp_servers": {
        "type": "domain_value",
        "required": false,
        "privacy": "confidential",
        "description": "Optional pre-approved MCP servers for peer Bibblio co-worker jobs serving the same goal.",
        "example": []
      },
      "learning_briefs_file": {
        "type": "local_path",
        "path_kind": "file",
        "required": false,
        "privacy": "confidential",
        "description": "JSON file of learning briefs carrying explicit PASS or PASS WITH CONDITIONS review status.",
        "example": "@/examples/sample_inputs/approved_learning_briefs.json"
      }
    },
    "outputs": {
      "primary": {
        "id": "final_artifact",
        "type": "final_artifact",
        "path": "final_artifact.json",
        "schema_version": "mn.blueprint.final_artifact_contract.v1",
        "required_fields": [
          "type",
          "executive_summary",
          "recommended_action",
          "confidence",
          "evidence",
          "next_steps",
          "source_refs"
        ]
      },
      "artifacts": [
        {
          "artifact_id": "final_artifact",
          "type": "final_artifact",
          "path": "final_artifact.json",
          "producer": "bibblio_content_studio_director",
          "mime_type": "application/json",
          "schema_version": "mn.blueprint.final_artifact.v1",
          "source_refs": [
            "inputs.json",
            "workflow_state/work_packets"
          ]
        },
        {
          "artifact_id": "bibblio_content_studio_packet",
          "type": "content_studio_production_packet",
          "path": "bibblio_content_studio_packet.json",
          "producer": "bibblio_content_studio_director",
          "mime_type": "application/json",
          "schema_version": "mn.bibblio.aspect_packet.v1",
          "source_refs": [
            "inputs.json",
            "workflow_state/work_packets"
          ]
        },
        {
          "artifact_id": "mcp_exchange",
          "type": "mcp_job_exchange",
          "path": "collaboration/mcp_exchange.sqlite3",
          "producer": "mirrorneuron-goal-work-packet-skill",
          "mime_type": "application/vnd.sqlite3",
          "schema_version": "mn.mcp.job_exchange.v1",
          "source_refs": [
            "workflow_state/work_packets"
          ]
        }
      ]
    },
    "status": {
      "event": "blueprint_status",
      "heartbeat": true,
      "phases": [
        "loading_inputs",
        "running_worker",
        "waiting_for_human",
        "writing_artifacts",
        "completed"
      ]
    },
    "privacy": {
      "default_classification": "confidential"
    }
  },
  "agents": {
    "registry": {
      "bibblio_content_studio_director": {
        "handler": "agents.bibblio_content_studio_director",
        "role": "AI Personalized Learning Content Studio Director"
      }
    }
  },
  "llm": {
    "enabled": true,
    "mode": "actor_assisted",
    "mock_mode": "deterministic",
    "provider": "docker_model_runner",
    "model": "small",
    "runtime_model": "small",
    "backend": "llama.cpp",
    "default_config": "primary",
    "configs": {
      "primary": {
        "provider": "docker_model_runner",
        "model": "small",
        "runtime_model": "small",
        "backend": "llama.cpp",
        "temperature": 0.2,
        "max_tokens": 2400
      }
    },
    "responsibilities": [
      "Separate observed facts from assumptions.",
      "Preserve source references and name missing evidence.",
      "Draft review-ready recommendations without executing external actions."
    ],
    "agents": {
      "bibblio_content_studio_director": {
        "llm_config": "primary",
        "role": "AI Personalized Learning Content Studio Director",
        "responsibilities": [
          "Turn approved learning briefs into complete versioned draft package structures.",
          "Track production QA, provenance, cost, accessibility, and reusable components.",
          "Never bypass learning-safety review or publish directly to children."
        ]
      }
    }
  },
  "mcp_collaboration": {
    "enabled": true,
    "goal_id": "bibblio-profitable-business",
    "publication_state": "staged",
    "publish_local_exchange": true,
    "peer_reads_enabled": false,
    "include_staged_peer_records": true,
    "max_peer_servers": 8,
    "max_records_per_peer": 50,
    "note": "Internal workflow messages remain on Core. MCP exposes bounded goal work packets from separately launched co-worker jobs only when explicit peer configurations are approved."
  },
  "requirements": {
    "cpu": {
      "min_cores": 1
    },
    "memory": {
      "min_gb": 1
    },
    "disk": {
      "min_gb": 1
    },
    "gpu": {
      "min_count": 0
    }
  },
  "metadata": {
    "blueprint_id": "bibblio_content_studio_coworker",
    "runtime_features": [
      "approved-brief intake",
      "draft content packages",
      "production QA contract",
      "mandatory learning-safety handoff"
    ],
    "collaboration_group": "bibblio-profitability-team",
    "business_goal": "Turn Bibblio into a profitable business.",
    "job_data": {
      "resources": [
        {
          "name": "state",
          "path": "state",
          "access": "read_write"
        }
      ]
    }
  },
  "workflow": {
    "workflow_id": "bibblio_content_studio_coworker_v1",
    "execution": {
      "strategy": "serial"
    },
    "policy": {
      "failure": {
        "default": "fail_closed"
      },
      "human": {
        "enabled": true,
        "mode": "approval_required",
        "allowed_decisions": [
          "approve",
          "revise",
          "reject"
        ],
        "blocked_actions": [
          "send_external_communications",
          "publish_child_facing_content",
          "spend_money",
          "change_pricing",
          "change_data_collection"
        ],
        "default_action": "reject",
        "timeout_seconds": 86400
      }
    },
    "steps": [
      {
        "id": "plan_content_batch",
        "kind": "source",
        "label": "Plan Content Batch",
        "goal": "Convert only approved learning briefs into a small, reusable draft production batch.",
        "needs": [],
        "run": {
          "definition": "steps.plan_content_batch"
        },
        "control": {
          "required": true,
          "timeout_seconds": 900,
          "failure_policy": "fail_workflow",
          "retry": {
            "max_attempts": 2,
            "backoff_seconds": 1,
            "backoff_multiplier": 2,
            "jitter": 0
          },
          "uncertainty": {
            "min_confidence": 0,
            "on_low_confidence": "continue_with_warning"
          }
        }
      },
      {
        "id": "publish_content_studio_packet",
        "kind": "sink",
        "label": "Publish Content Studio Packet",
        "goal": "Publish production status and a mandatory review bundle without releasing content.",
        "needs": [
          "plan_content_batch"
        ],
        "run": {
          "definition": "steps.publish_content_studio_packet"
        },
        "control": {
          "required": true,
          "timeout_seconds": 900,
          "failure_policy": "fail_workflow",
          "retry": {
            "max_attempts": 2,
            "backoff_seconds": 1,
            "backoff_multiplier": 2,
            "jitter": 0
          },
          "uncertainty": {
            "min_confidence": 0,
            "on_low_confidence": "continue_with_warning"
          }
        }
      }
    ]
  },
  "skill_dependencies": [
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-goal-work-packet-skill",
      "version": "1.2.31"
    }
  ],
  "agent_dependencies": [
    {
      "type": "pip",
      "source": "gar",
      "name": "mn-prototype-stateful-step-agent",
      "version": "1.2.31"
    }
  ]
}
