{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/extensions/blocks.schema.json",
  "steps": {
    "assess_procurement_case": {
      "uses": "mn.blocks.domain_operation@1",
      "hooks": {
        "operation": "domain.case_packet:assess_block"
      },
      "inputs": {
        "previous": {
          "$ref": "upstream",
          "step_id": "build_purchase_evidence",
          "path": [
            "purchase_evidence"
          ]
        }
      },
      "outputs": {
        "case_assessment": {
          "$ref": "flow_output",
          "path": [
            "result"
          ]
        }
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "previous": {
            "type": "object"
          }
        },
        "required": [
          "previous"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "case_packet": {
            "type": [
              "object",
              "null"
            ]
          },
          "decision_digest": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "case_packet"
        ],
        "additionalProperties": false
      },
      "limits": {
        "max_calls": 1,
        "timeout_seconds": 900
      }
    }
  }
}
