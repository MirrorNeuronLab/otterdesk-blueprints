{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/manifest.schema.json",
  "id": "purchasing_manager",
  "name": "Procurement Manager",
  "version": "1.1.1",
  "description": "Turns a purchase request into a review-ready comparison. Checks supplier quotes, known costs, requirements, and evidence; flags required reviews without contacting suppliers or placing orders.",
  "workflow": "workflow.json",
  "execution": "execution.json",
  "contracts": "contracts.json",
  "config": "config/default.json",
  "license": "LICENSE.md",
  "terms": "TERM.md",
  "dependencies": "dependencies.json",
  "extensions": {
    "mn.agentic": {
      "file": "extensions/agentic.json",
      "required": true
    },
    "mn.airgap": {
      "file": "extensions/airgap.json",
      "required": true
    },
    "mn.llm": {
      "file": "extensions/llm.json",
      "required": true
    },
    "mn.product": {
      "file": "extensions/product.json",
      "required": false
    },
    "mn.rag": {
      "file": "extensions/rag.json",
      "required": true
    },
    "mn.response": {
      "file": "extensions/response.json",
      "required": true
    },
    "mn.storage": {
      "file": "extensions/storage.json",
      "required": true
    },
    "mn.ui": {
      "file": "extensions/ui.json",
      "required": false
    }
  }
}
