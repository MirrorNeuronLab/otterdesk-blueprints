{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/execution.schema.json",
  "policies": {
    "recovery_mode": "local_restart"
  },
  "agents": {
    "registry": {
      "purchase_market_researcher": {
        "handler": "mn_sdk.integrations.block_worker",
        "role": "Source Provenance And Market Research Analyst",
        "with": {
          "revision": "procurement_manager@5.1.0",
          "instance": {
            "uses": "mn.blocks.domain_operation@1",
            "hooks": {
              "operation": "domain.comparison:research_market"
            },
            "limits": {
              "max_calls": 1,
              "timeout_seconds": 1800
            }
          }
        }
      },
      "purchase_total_cost_analyst": {
        "handler": "mn_sdk.integrations.block_worker",
        "role": "Heavy Asset Lifecycle Economics Analyst",
        "with": {
          "revision": "procurement_manager@5.1.0",
          "instance": {
            "uses": "mn.blocks.domain_operation@1",
            "hooks": {
              "operation": "domain.comparison:analyze_total_cost"
            },
            "limits": {
              "max_calls": 1,
              "timeout_seconds": 1800
            }
          }
        }
      },
      "purchase_risk_reviewer": {
        "handler": "mn_sdk.integrations.block_worker",
        "role": "Technical Supplier And Operational Risk Reviewer",
        "with": {
          "revision": "procurement_manager@5.1.0",
          "instance": {
            "uses": "mn.blocks.domain_operation@1",
            "hooks": {
              "operation": "domain.comparison:review_purchase_risks"
            },
            "limits": {
              "max_calls": 1,
              "timeout_seconds": 1800
            }
          }
        }
      }
    }
  },
  "defaults": {
    "worker": {
      "with": {
        "stereotype": "internal_write_worker",
        "image": "mirror-neuron/purchasing-manager:local",
        "upload_paths": [
          {
            "source": "domain",
            "target": "domain"
          }
        ],
        "upload_path": "domain",
        "upload_as": "domain"
      }
    }
  },
  "requirements": {
    "cpu": {
      "min_cores": 1
    },
    "disk": {
      "min_gb": 1
    },
    "gpu": {
      "min_count": 1,
      "min_memory_mb": 49152,
      "memory_operator": ">=",
      "enforcement": "hard"
    },
    "memory": {
      "min_gb": 2
    }
  },
  "workers": {
    "groups": [
      {
        "steps": [
          "compare_purchase_options"
        ],
        "with": {
          "stereotype": "public_browser_worker"
        }
      },
      {
        "steps": [
          "publish_purchase_decision_packet"
        ],
        "with": {
          "stereotype": "internal_write_worker"
        }
      }
    ]
  },
  "mode": "compiled",
  "job_name": "procurement-manager"
}
