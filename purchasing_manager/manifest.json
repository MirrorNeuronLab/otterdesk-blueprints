  "llm": {
    "enabled": true,
    "agents": {
      "purchase_intake_analyst": {
        "llm_config": "primary",
        "role": "Procurement Requirements Analyst",
        "responsibilities": [
          "Translate the request into testable business, technical, budget, delivery, and approval requirements.",
          "Separate supplied facts from preferences, assumptions, and unresolved decisions.",
          "Identify the evidence and named stakeholder sign-offs required before sourcing begins."
        ]
      },
      "purchase_knowledge_retriever": {
        "enabled": false,
        "llm_config": "primary",
        "role": "Procurement Evidence Analyst",
        "responsibilities": [
          "Retrieve category-specific procurement and technical diligence guidance deterministically.",
          "Index only approved local quotes, requirements, and evidence.",
          "Return source citations, evidence gaps, and retrieval limitations without an LLM call."
        ]
      },
      "purchase_market_researcher": {
        "enabled": false,
        "llm_config": "primary",
        "role": "Supplier And Market Researcher",
        "responsibilities": [
          "Collect supplier, configuration, quote, availability, lead-time, and comparable evidence through bounded source tools.",
          "Timestamp volatile product and supplier facts and preserve URLs.",
          "Record blocked, stale, or non-verifiable sources without an LLM call."
        ]
      },
      "purchase_total_cost_analyst": {
        "llm_config": "primary",
        "role": "Total Cost Of Ownership Analyst",
        "responsibilities": [
          "Reconcile quoted subtotal, tax, delivery, setup, support, energy, and renewal costs from explicit evidence.",
          "Show budget position and known multi-year cost while keeping unknown costs visible.",
          "Never invent supplier discounts, tax treatment, financing, fees, or savings assumptions."
        ]
      },
      "purchase_risk_reviewer": {
        "llm_config": "primary",
        "role": "Technical And Supplier Risk Reviewer",
        "responsibilities": [
