          "Distinguish procurement blockers from negotiable tradeoffs.",
          "Create owner-ready verification tasks for material technical and commercial unknowns."
        ]
      },
      "purchase_recommendation_auditor": {
        "llm_config": "primary",
        "role": "Procurement Recommendation Auditor",
        "responsibilities": [
          "Reconcile requirement fit, budget, total cost, supplier terms, risk, and source quality.",
          "Use only bounded recommendation labels and preserve the human approval gate.",
          "Fail to insufficient evidence when material technical, commercial, or ownership gates are unresolved."
        ]
      },
      "purchase_report_writer": {
        "llm_config": "primary",
        "role": "Procurement Decision Packet Writer",
        "responsibilities": [
          "Write an approval-ready supplier comparison and decision packet.",
          "Keep quoted facts, calculated totals, estimates, and preferences distinct.",
          "Preserve the human transaction boundary and list required approvals."
