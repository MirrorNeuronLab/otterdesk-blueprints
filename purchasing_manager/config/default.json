{
  "agent_handoffs": {},
  "backpressure": {
    "drop_policy": "skip_with_error",
    "llm": {
      "max_calls_per_minute": 30,
      "max_concurrent_calls": 1,
      "min_interval_seconds": 2.0,
      "rationale": "Protect local Docker Model Runner from concurrent blueprint actor calls."
    },
    "max_concurrency": 4,
    "max_events_per_second": 10,
    "queue_size": 1000
  },
  "benchmark": {
    "baseline": "all_context",
    "enabled": true,
    "quality_metrics": [
      "action_accuracy",
      "purchase_type_fit",
      "critical_fact_recall",
      "risk_awareness",
      "quality_score_delta",
      "estimated_token_reduction_ratio",
      "budget_violation_rate"
    ],
    "schema_version": "mn.finance.purchasing_manager.v1"
  },
  "budgets": {
    "max_connector_reads": 500,
    "max_connector_writes": 20,
    "max_disk_mb": 250,
    "max_llm_calls": 5,
    "max_llm_tokens": 20000,
    "max_runtime_seconds": 600,
    "max_stream_duration_seconds": 3600
  },
  "capabilities": {
    "optional": [
      "llm.call",
      "network.egress",
      "stream.subscribe",
      "knowledge.rag",
      "llm.tool_plan"
    ],
    "required": [
      "filesystem.write"
    ]
  },
  "determinism": {
    "enabled": true,
    "frozen_clock": null,
    "replay": {
      "from_events": "events.jsonl",
      "from_inputs": "inputs.json",
      "llm_mode": "mock"
    },
    "seed_field": "seed"
  },
  "error_handling": {
    "default_mode": "stop",
    "policies": {
      "llm_call": {
        "backoff_seconds": 2,
        "max_attempts": 3,
        "mode": "retry"
      },
      "optional_output": {
        "mode": "skip"
      },
      "required_output": {
        "mode": "stop"
      }
    }
  },
  "execution_model": [
    "load_metadata",
    "resolve_config",
    "load_inputs",
    "start_run_store",
    "observe_simulation_state",
    "call_llm_agent",
    "evaluate_workflow_state",
    "route_by_context",
    "request_human_input",
    "apply_decision_to_simulation",
    "emit_events",
    "write_final_artifact",
    "fan_out_output_skills",
    "emit_status_events",
    "handle_human_control",
    "write_artifact_records"
  ],
  "input_skills": {
    "llm_ocr": {
      "skill": "llm_ocr_skill",
      "package": "mirrorneuron-llm-ocr-skill",
      "enabled": true,
      "required": false,
      "min_text_chars": 40
    },
    "web_browser": {
      "skill": "web_browser_skill",
      "package": "mirrorneuron-web-browser-skill",
      "enabled": true,
      "required": false,
      "purpose": "Unified public research for official product specifications and supplier terms, with lightweight w3m routing and policy-governed rendered-page fallback."
    }
  },
  "internet_research": {
    "enabled": true,
    "max_seed_urls": 6,
    "max_queries": 2,
    "max_sources": 3,
    "min_observed_sources_before_search": 4,
    "search_only_when_source_gap": true,
    "timeout_seconds": 12,
    "total_timeout_seconds": 30,
    "max_chars": 12000,
    "respect_robots": true,
    "per_host_delay_seconds": 1
  },
  "inputs": {
    "adapter": "json",
    "description": "Default business request backed by time-stamped public market observations, official technical specifications, and public economic data. Supplier facts must be refreshed before approval.",
    "payload": {
      "purchase_type": "computer",
      "item_description": "Source one supportable local-AI desktop system for a Boston engineering office within a $5,000 landed-acquisition budget.",
      "budget": 5000,
      "location": "Boston, MA",
      "route": "",
      "travel_dates": "",
      "priorities": [
        "technical fit for local model development",
        "landed acquisition cost under budget",
        "risk-adjusted three-year total ownership cost",
        "current purchase availability",
        "supportability and deployment readiness"
      ],
      "constraints": {
        "min_gpu_vram_gb": 16,
        "min_system_ram_gb": 64,
        "min_storage_tb": 2,
        "min_warranty_years": 1,
        "available_for_purchase_required": true
      },
      "analysis": {
        "horizon_years": 3,
        "discount_rate": 0.08,
        "tax_rate": 0.0625,
        "electricity_rate_per_kwh": 0.2452,
        "active_hours_per_year": 1000,
        "idle_hours_per_year": 1000,
        "loaded_labor_cost_per_hour": 95,
        "downtime_cost_per_hour": 190,
        "expected_downtime_hours_per_year": 6,
        "annual_maintenance_reserve": 150,
        "residual_value_percent": 0.1,
        "source_refs": [
          "https://www.mass.gov/guides/sales-and-use-tax",
          "https://www.eia.gov/electricity/monthly/epm_table_grapher.php?t=epmt_5_6_a"
        ],
        "scenarios": [
          {
            "name": "low utilization / low disruption",
            "active_hours_per_year": 750,
            "idle_hours_per_year": 750,
            "expected_downtime_hours_per_year": 2,
            "annual_maintenance_reserve": 100,
            "residual_value_percent": 0.15
          },
          {
            "name": "base planning case",
            "active_hours_per_year": 1000,
            "idle_hours_per_year": 1000,
            "expected_downtime_hours_per_year": 6,
            "annual_maintenance_reserve": 150,
            "residual_value_percent": 0.1
          },
          {
            "name": "high utilization / disruption stress",
            "active_hours_per_year": 1500,
            "idle_hours_per_year": 1000,
            "expected_downtime_hours_per_year": 16,
            "annual_maintenance_reserve": 300,
            "residual_value_percent": 0.05
          }
        ]
      },
      "input_folder": "@/examples/sample_inputs",
      "output_folder": "~/Downloads/purchasing_manager"
    }
  },
  "interfaces": {
    "channels": {
      "artifacts": {
        "artifacts": [
          "run.json",
          "config.json",
          "inputs.json",
          "events.jsonl",
          "result.json",
          "final_artifact.json"
        ],
        "description": "Stable run-store files and domain-specific outputs.",
        "optional_artifacts": [
          "job.json",
          "web_ui.json",
          "ui.json",
          "web/index.html",
          "logs.jsonl"
        ]
      },
      "events": {
        "artifact": "events.jsonl",
        "description": "Append-only workflow events."
      },
      "human": {
        "artifact": "human.jsonl",
        "description": "Human notices, approval requests, responses, timeouts, and applied decisions.",
        "mirrored_to": "events.jsonl"
      },
      "input_skills": {
        "description": "Connector-backed or reusable skill-backed input sources."
      },
      "inputs": {
        "artifact": "inputs.json",
        "description": "Resolved runtime inputs and adapter provenance."
      },
      "logs": {
        "artifact": "logs.jsonl",
        "description": "Runtime stdout/stderr and explicit log artifacts.",
        "index": "logs.index.json",
        "stream": "stdout/stderr"
      },
      "output_skills": {
        "description": "Optional fan-out destinations after local run-store writes."
      },
      "outputs": {
        "artifacts": [
          "result.json",
          "final_artifact.json"
        ],
        "description": "Primary result and final user-facing artifact."
      },
      "resources": {
        "artifact": "resources.jsonl",
        "description": "Resource samples such as token, runtime, connector, and disk usage."
      },
      "streams": {
        "default": [
          "events"
        ],
        "description": "Named data or event streams exposed by the blueprint.",
        "kinds": [
          "audio",
          "video",
          "data",
          "multimodal"
        ],
        "transports": [
          "file",
          "http",
          "https",
          "rtsp",
          "rtmp",
          "webrtc",
          "websocket",
          "socketio",
          "tcp",
          "udp",
          "sse",
          "kafka",
          "mqtt",
          "custom"
        ]
      },
      "web_ui": {
        "artifacts": [
          "web_ui.json",
          "ui.json",
          "web/index.html"
        ],
        "description": "Optional web input/output handles."
      },
      "knowledge_rag": {
        "description": "Optional local blueprint knowledge retrieval used to ground actor prompts and tool planning.",
        "config": "knowledge_rag",
        "artifact": "@/payloads/knowledge/",
        "privacy": "blueprint knowledge only by default"
      },
      "agentic_research": {
        "description": "Bounded LLM-selected or actor-guided tool contract for domain work.",
        "config": "agentic_research"
      }
    },
    "config_sections": [
      "standard_version",
      "identity",
      "mode",
      "metadata",
      "inputs",
      "simulation",
      "llm",
      "outputs",
      "logging",
      "resources",
      "human_control",
      "real_adapters",
      "streams",
      "input_skills",
      "output_skills",
      "error_handling",
      "state",
      "capabilities",
      "privacy",
      "triggers",
      "backpressure",
      "determinism",
      "schemas",
      "budgets",
      "agent_handoffs",
      "web_ui",
      "interfaces",
      "execution_model",
      "suggested_schedule",
      "knowledge_rag",
      "agentic_research",
      "llm_analysis"
    ],
    "identity_fields": [
      "blueprint_id",
      "name",
      "run_id"
    ],
    "input_adapters": [
      "mock",
      "json",
      "file",
      "env_json"
    ],
    "optional_run_artifacts": [
      "job.json",
      "web_ui.json",
      "ui.json",
      "web/index.html",
      "logs.jsonl",
      "logs.index.json",
      "human.jsonl",
      "resources.jsonl"
    ],
    "output_adapters": [
      "local_run_store"
    ],
    "response_schema": "mn.blueprint.response.v1",
    "run_artifacts": [
      "run.json",
      "config.json",
      "inputs.json",
      "events.jsonl",
      "result.json",
      "final_artifact.json"
    ],
    "stream_kinds": [
      "audio",
      "video",
      "data",
      "multimodal"
    ],
    "stream_transports": [
      "file",
      "http",
      "https",
      "rtsp",
      "rtmp",
      "webrtc",
      "websocket",
      "socketio",
      "tcp",
      "udp",
      "sse",
      "kafka",
      "mqtt",
      "custom"
    ],
    "web_ui_adapters": [
      "none",
      "static_html",
      "gradio",
      "custom"
    ],
    "config": [
      "standard_version",
      "identity",
      "mode",
      "metadata",
      "inputs",
      "simulation",
      "llm",
      "outputs",
      "logging",
      "resources",
      "human_control",
      "real_adapters",
      "streams",
      "input_skills",
      "output_skills",
      "error_handling",
      "state",
      "capabilities",
      "privacy",
      "triggers",
      "backpressure",
      "determinism",
      "schemas",
      "budgets",
      "agent_handoffs",
      "web_ui",
      "interfaces",
      "execution_model",
      "suggested_schedule",
      "knowledge_rag",
      "agentic_research",
      "llm_analysis"
    ]
  },
  "llm": {
    "mode": "live",
    "strict_json": true,
    "require_live": false,
    "configs": {
      "primary": {
        "timeout_seconds": 60,
        "max_tokens": 1200,
        "num_retries": 1
      }
    }
  },
  "llm_analysis": {
    "max_calls_per_run": 5,
    "max_context_chars": 30000,
    "max_candidates": 8,
    "max_list_items": 10,
    "max_text_chars": 1600,
    "failure_mode": "deterministic_fallback_with_visible_warning"
  },
  "logging": {
    "events": [
      "run_started",
      "inputs_loaded",
      "large_context_seeded",
      "simulation_step_started",
      "memory_context_compiled",
      "llm_decision",
      "benchmark_step_scored",
      "simulation_state_updated",
      "run_completed",
      "blueprint_status",
      "blueprint_phase_started",
      "blueprint_phase_completed",
      "blueprint_phase_failed",
      "artifact_written",
      "human_notice",
      "human_input_requested",
      "human_input_received",
      "human_input_timeout",
      "human_decision_applied",
      "output_skill_started",
      "output_skill_completed",
      "output_skill_failed"
    ],
    "events_jsonl": true,
    "level": "INFO",
    "logs_jsonl": true,
    "redact_env_secrets": true,
    "redact_fields": [
      "api_key",
      "token",
      "authorization",
      "cookie",
      "password",
      "private_key"
    ],
    "resources_jsonl": true,
    "rotation": {
      "check_interval_records": 100,
      "compress": "background",
      "enabled": true,
      "max_bytes_mb": 100,
      "max_segments": 7,
      "span_seconds": 86400
    },
    "stderr_jsonl": true,
    "writer": {
      "batch_size": 100,
      "flush_interval_seconds": 0.5,
      "mode": "async",
      "overflow_policy": "drop_low_priority",
      "queue_size": 10000,
      "shutdown_flush_timeout_seconds": 2
    }
  },
  "memory": {
    "compression_goal": "replace full-history agent handoffs with a compact source-grounded decision packet while preserving older critical facts",
    "enabled": true,
    "mode": "compare",
    "retrieval_tags": [
      "critical",
      "technical_requirement",
      "source_provenance",
      "market_observation",
      "landed_cost",
      "total_cost",
      "discounted_cash_flow",
      "equivalent_annual_cost",
      "lease_vs_buy",
      "warranty",
      "delivery_risk"
    ],
    "selection_limit": 36
  },
  "memory_layer": {
    "collection": "mn_memory",
    "containers": "optional_sidecar",
    "context_addr_env": "MN_CONTEXT_ADDR",
    "conversation": {
      "agent_role": "otterdesk_chat",
      "include_human_events": true,
      "include_runtime_events": true,
      "include_runtime_logs": true,
      "target_tokens": 2400,
      "token_budget": 6000,
      "use_model_compression": false
    },
    "conversation_enabled": true,
    "conversation_enabled_env": "OTTERDESK_CONTEXT_MEMORY_ENABLED",
    "default_context_addr": "localhost:50052",
    "enabled": true,
    "enabled_env": "MN_CONTEXT_MEMORY_ENABLED",
    "namespace": "purchasing_manager_context",
    "project_path": "${MN_MEMBRANE_PROJECT_PATH}",
    "python_sdk_path": "${MN_MEMBRANE_SDK_PATH}",
    "sdk_distribution": "mirrorneuron-membrane-python-sdk",
    "sdk_import_package": "mn_context_engine_sdk"
  },
  "knowledge_rag": {
    "backend": "milvus_lite"
  },
  "metadata": {
    "category": "finance",
    "description": "A procurement-oriented purchasing co-worker that turns real, traceable market evidence and company assumptions into an approval-ready heavy-asset comparison using landed cost, discounted lifecycle cash flow, risk-adjusted TCO, equivalent annual cost, unit economics, sensitivity analysis, and acquisition-method analysis."
  },
  "mode": "live",
  "output_skills": {},
  "outputs": {
    "adapter": "local_run_store",
    "artifact_contract": "Source-grounded procurement decision packet with supplier comparison, landed acquisition cost, discounted and risk-adjusted TCO, equivalent annual cost, productive-hour economics, scenario sensitivity, cash/finance/lease analysis when real terms exist, risk flags, evidence gaps, approval checklist, and review-only recommendation.",
    "run_root": "~/.mn/runs",
    "skills": {},
    "tcp": {
      "enabled": false,
      "ports": []
    },
    "write_run_store": true,
    "folder_path": "~/Downloads/purchasing_manager"
  },
  "privacy": {
    "default_classification": "confidential",
    "rules": {
      "confidential": {
        "log": "redacted",
        "send_to_llm": "allowed_configs_only",
        "send_to_output_skills": "approved_destinations_only"
      },
      "internal": {
        "log": "metadata_only",
        "send_to_llm": true,
        "send_to_output_skills": true
      },
      "public": {
        "log": true,
        "send_to_llm": true,
        "send_to_output_skills": true
      },
      "regulated": {
        "log": "redacted",
        "send_to_llm": false,
        "send_to_output_skills": "approved_destinations_only"
      }
    }
  },
  "real_adapters": {
    "inline_json": {
      "adapter": "json",
      "description": "Load overrides from an inline JSON object.",
      "payload": {}
    },
    "input_file": {
      "adapter": "file",
      "description": "Load JSON overrides from a local file path.",
      "path": null
    }
  },
  "resources": {
    "enabled": true,
    "gpu_enabled": "auto",
    "gpu_sample_interval_seconds": 60,
    "history_window_hours": 24,
    "raw_retention_hours": 48,
    "rollup_bucket_seconds": 3600,
    "sample_interval_seconds": 10
  },
  "schemas": {
    "artifact_record": "mn.artifact.record.v1",
    "config": "mn.blueprint.config.v1",
    "events": "mn.blueprint.events.v1",
    "final_artifact": "mn.blueprint.final_artifact.v1",
    "human_control": "mn.blueprint.human_control.v1",
    "input_skills": "mn.blueprint.input_skills.v1",
    "inputs": "mn.blueprint.inputs.v1",
    "logs": "mn.blueprint.logs.v1",
    "output_skills": "mn.blueprint.output_skills.v1",
    "resources": "mn.blueprint.resources.v1",
    "status_contract": "mn.blueprint.status_contract.v1",
    "web_ui": "mn.blueprint.web_ui.v1"
  },
  "simulation": {
    "enabled": false,
    "deterministic": true,
    "type": "General purchase research with local RAG and public-source comparison."
  },
  "standard_version": "1.0",
  "state": {
    "checkpoint_interval": {
      "events": 100,
      "seconds": 60
    },
    "enabled": false,
    "idempotency_key_fields": [
      "source_ref",
      "event_id"
    ],
    "resume_mode": "none",
    "input_folder": "@/examples/sample_inputs",
    "output_folder": "~/Downloads/purchasing_manager"
  },
  "streams": {},
  "triggers": {
    "schedule": null,
    "sources": [],
    "type": "manual"
  },
  "web_ui": {
    "dashboard": {
      "data_source": "local_run_store",
      "panels": [
        "current_status",
        "recent_events",
        "pending_human_requests",
        "output_artifacts",
        "resource_usage",
        "errors",
        "llm_calls",
        "token_budget",
        "llm_retries"
      ],
      "reads": [
        "events.jsonl",
        "human.jsonl",
        "logs.jsonl",
        "resources.jsonl",
        "result.json",
        "final_artifact.json",
        "web_ui.json"
      ],
      "standard_panels": [
        "current_status",
        "recent_events",
        "pending_human_requests",
        "output_artifacts",
        "resource_usage",
        "errors",
        "llm_calls",
        "token_budget",
        "llm_retries"
      ]
    },
    "enabled": true,
    "input": {
      "adapter": "none",
      "custom_url": null,
      "fields": [],
      "host": "127.0.0.1",
      "instructions": null,
      "port": null,
      "share": false,
      "title": null
    },
    "output": {
      "adapter": "gradio",
      "auto_generate": true,
      "custom_url": null,
      "refresh_seconds": 2,
      "title": null
    }
  },
  "suggested_schedule": {
    "cron": "0 8 * * 1",
    "cadence": "weekly",
    "advisory_only": true,
    "note": "Suggested cadence only; runtime decides the actual schedule."
  },
  "local_inputs": {
    "folders": [
      {
        "config_path": "inputs.payload.input_folder",
        "payload_path": "runtime/mn_local_inputs/purchasing_manager_documents",
        "runtime_path": "mn_local_inputs/purchasing_manager_documents",
        "allowed_extensions": [
          ".pdf",
          ".png",
          ".jpg",
          ".jpeg",
          ".tif",
          ".tiff",
          ".bmp",
          ".webp",
          ".txt",
          ".json",
          ".csv",
          ".md"
        ],
        "linked_config_paths": [
          "inputs.payload.input_folder",
          "state.input_folder"
        ]
      }
    ]
  }
}
