{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/manifest.schema.json",
  "id": "mac_security_investigator",
  "name": "Mac security investigator",
  "version": "0.2.3",
  "description": "Reviews local Mac unified-log evidence across user-initiated scans and preserves source receipts, explicit coverage limits and saved reports without inspecting OS files.",
  "workflow": "workflow.json",
  "execution": "execution.json",
  "contracts": "contracts.json",
  "config": "config/default.json",
  "dependencies": "dependencies.json",
  "license": "LICENSE.md",
  "terms": "TERM.md",
  "extensions": {
    "mn.product": {
      "file": "extensions/product.json",
      "required": false
    },
    "mn.storage": {
      "file": "extensions/storage.json",
      "required": true
    },
    "mn.response": {
      "file": "extensions/response.json",
      "required": true
    },
    "mn.context": {
      "file": "extensions/context.json",
      "required": true
    },
    "mn.ui": {
      "file": "extensions/ui.json",
      "required": false
    },
    "mn.rag": {
      "file": "extensions/rag.json",
      "required": false
    }
  }
}
