{
  "inputs": {
    "adapter": "mock",
    "description": "Synthetic Bibblio demo input for the generic Learning Quality & Safety Co-worker.",
    "payload": {
      "business_name": "Bibblio",
      "business_goal": "Build a successful business for Bibblio.",
      "goal_id": "bibblio-business-success",
      "planning_horizon_days": 90,
      "input_folder": "@/examples/sample_inputs",
      "content_backlog_file": "@/examples/sample_inputs/content_backlog.json",
      "output_folder": "~/Downloads/learning_quality_safety_coworker",
      "peer_mcp_servers": []
    }
  },
  "outputs": {
    "folder_path": "~/Downloads/learning_quality_safety_coworker",
    "write_run_store": true
  },
  "execution": {
    "quick_test": true
  },
  "llm": {
    "mode": "fake",
    "require_live": false
  },
  "mcp_collaboration": {
    "chat_grace_seconds": 8,
    "publish_local_exchange": true,
    "peer_reads_enabled": false
  },
  "privacy": {
    "default_classification": "confidential",
    "child_data_export": "blocked",
    "external_communications": "approval_required",
    "minimum_data": true
  },
  "learning_safety": {
    "require_human_review": true,
    "block_therapeutic_claims": true
  }
