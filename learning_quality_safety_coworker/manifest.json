{
  "apiVersion": "mn.workflow.source/v2",
  "kind": "WorkflowSource",
  "standard": {
    "profile": "blueprint",
    "source_schema": "mn.workflow.source/v2",
    "target_schema": "mn.workflow/v1",
    "migration_policy": "sdk_managed"
  },
  "identity": {
    "id": "bibblio_learning_safety_coworker",
    "name": "Bibblio Learning & Safety Co-worker",
    "job_name": "bibblio-learning-safety-coworker",
    "category": "business",
    "version": 1,
    "manifest_version": "1.0"
  },
  "description": "A focused learning and child-safety co-worker that reviews proposed objectives and backlog items, records PASS/REVISE/BLOCK decisions, and prevents unsafe or unsupported child-facing work from advancing.",
  "intent": {
    "description": "AI Director of Learning Science, Curriculum, and Child Safety serving one shared goal: turn Bibblio into a profitable business.",
    "problem": "Bibblio needs every learning experience to have an observable objective, developmental fit, correct answer logic, safe content, and an auditable human review gate.",
    "target_users": "Bibblio's founder and qualified learning, curriculum, child-safety, privacy, and accessibility reviewers.",
    "safety": {
      "enabled": true,
      "mode": "approval_required",
      "allowed_decisions": [
        "approve",
        "revise",
        "reject"
      ],
      "blocked_actions": [
        "send_external_communications",
        "publish_child_facing_content",
        "spend_money_or_launch_paid_campaigns",
        "change_pricing_or_subscription_terms",
        "make_learning_medical_or_therapeutic_claims",
        "change_child_or_family_data_collection"
      ],
      "default_action": "reject",
      "timeout_seconds": 86400,
      "reason": "The co-worker observes, analyzes, drafts, and queues; a designated human approves every consequential external action."
    }
  },
  "config": {
    "default": "config/default.json",
    "embed": true,
    "manifest_defaults": [
      "llm",
      "mcp_collaboration",
      {
        "from": "requirements",
        "to": "resources"
      },
      {
        "from": "workflow.policy.human",
        "to": "human_control"
      },
      {
        "from": "identity.id",
        "to": "identity.blueprint_id"
      },
      {
        "from": "identity.name",
        "to": "identity.name"
      }
    ]
  },
  "defaults": {
    "worker": {
      "with": {
        "stereotype": "internal_write_worker",
        "image": "mirror-neuron/bibblio-learning-safety-coworker:local",
        "upload_paths": [
          {
            "source": "domain",
            "target": "domain"
          }
        ]
      }
    }
  },
  "contracts": {
    "input_adapters": {
      "default": "mock",
      "resolved_artifact": "inputs.json",
      "supported": [
        "mock",
        "json",
        "file",
        "env_json"
      ]
    },
    "inputs": {
      "business_goal": {
        "type": "domain_value",
        "required": false,
        "privacy": "internal",
        "description": "Shared business goal served by all five independently launched Bibblio co-workers.",
        "example": "Turn Bibblio into a profitable business."
      },
      "goal_id": {
        "type": "domain_value",
        "required": false,
        "privacy": "internal",
        "description": "Stable goal identity used for explicit MCP peer collaboration.",
        "example": "bibblio-profitable-business"
      },
      "input_folder": {
        "type": "local_path",
        "path_kind": "directory",
        "required": false,
        "privacy": "confidential",
        "description": "Local folder containing this co-worker's focused input file.",
        "example": "@/examples/sample_inputs"
      },
      "output_folder": {
        "type": "local_path",
        "path_kind": "directory",
        "required": false,
        "privacy": "confidential",
        "description": "Local folder for review-ready artifacts.",
        "example": "~/Downloads/bibblio"
      },
      "peer_mcp_servers": {
        "type": "domain_value",
        "required": false,
        "privacy": "confidential",
        "description": "Optional pre-approved MCP servers for peer Bibblio co-worker jobs serving the same goal.",
        "example": []
      },
      "content_backlog_file": {
        "type": "local_path",
        "path_kind": "file",
        "required": false,
        "privacy": "confidential",
        "description": "JSON backlog of proposed learning objectives, age bands, parent value, sensitive-topic flags, and claim risk.",
        "example": "@/examples/sample_inputs/content_backlog.json"
      }
    },
    "outputs": {
      "primary": {
        "id": "final_artifact",
        "type": "final_artifact",
        "path": "final_artifact.json",
        "schema_version": "mn.blueprint.final_artifact_contract.v1",
        "required_fields": [
          "type",
          "executive_summary",
          "recommended_action",
          "confidence",
          "evidence",
          "next_steps",
          "source_refs"
        ]
      },
      "artifacts": [
        {
          "artifact_id": "final_artifact",
          "type": "final_artifact",
          "path": "final_artifact.json",
          "producer": "bibblio_learning_safety_director",
          "mime_type": "application/json",
          "schema_version": "mn.blueprint.final_artifact.v1",
          "source_refs": [
            "inputs.json",
            "workflow_state/work_packets"
          ]
        },
        {
          "artifact_id": "bibblio_learning_safety_packet",
          "type": "learning_safety_decision_packet",
          "path": "bibblio_learning_safety_packet.json",
          "producer": "bibblio_learning_safety_director",
          "mime_type": "application/json",
          "schema_version": "mn.bibblio.aspect_packet.v1",
          "source_refs": [
            "inputs.json",
            "workflow_state/work_packets"
          ]
        },
        {
          "artifact_id": "mcp_exchange",
          "type": "mcp_job_exchange",
          "path": "collaboration/mcp_exchange.sqlite3",
          "producer": "mirrorneuron-goal-work-packet-skill",
          "mime_type": "application/vnd.sqlite3",
          "schema_version": "mn.mcp.job_exchange.v1",
          "source_refs": [
            "workflow_state/work_packets"
          ]
        }
      ]
    },
    "status": {
      "event": "blueprint_status",
      "heartbeat": true,
      "phases": [
        "loading_inputs",
        "running_worker",
        "waiting_for_human",
        "writing_artifacts",
        "completed"
      ]
    },
    "privacy": {
      "default_classification": "confidential"
    }
  },
  "agents": {
    "auxiliary_entrypoints": [
      "mcp_collaboration_server"
    ],
    "extra_nodes": [
      {
        "node_id": "mcp_collaboration_server",
        "type": "stream",
        "agent_type": "executor",
        "alias": "mcp_collaboration_server",
        "display_name": "MCP Collaboration Server",
        "config": {
          "command": [
            "mn-job-mcp-server"
          ],
          "environment": {
            "MN_BLUEPRINT_ID": "bibblio_learning_safety_coworker",
            "MN_MCP_GOAL_ID": "bibblio-profitable-business",
            "MN_MCP_PATH": "/mcp"
          },
          "no_auto_providers": true,
          "no_keep": true,
          "output_message_type": null,
          "pass_env": [
            "MN_MCP_CONTAINER_LOOPBACK_PROXY"
          ],
          "python_environment": {
            "packages": [
              "mirrorneuron-mcp-server-skill==1.2.31"
            ]
          },
          "runner_module": "MirrorNeuron.Runner.HostLocal",
          "tty": false,
          "upload_as": ".",
          "upload_path": ".",
          "workdir": "/sandbox/job"
        },
        "resources": {
          "ports": [
            {
              "label": "mcp-collaboration",
              "port": "auto",
              "protocol": "http"
            }
          ]
        },
        "services": [
          {
            "address": "127.0.0.1",
            "name": "mn-job-collaboration",
            "port": "${env.MN_PORT_MCP_COLLABORATION}",
            "tags": [
              "mcp",
              "job-collaboration"
            ],
            "meta": {
              "blueprint_id": "bibblio_learning_safety_coworker",
              "goal_id": "bibblio-profitable-business",
              "job_id": "${env.MN_JOB_ID}",
              "run_id": "${env.MN_RUN_ID}",
              "path": "/mcp",
              "transport": "streamable-http"
            },
            "checks": [
              {
                "name": "tcp-ready",
                "type": "tcp",
                "port": "${service.port}",
                "interval_ms": 100,
                "timeout_ms": 1000,
                "failures_before_critical": 3
              }
            ]
          }
        ]
      }
    ],
    "registry": {
      "bibblio_learning_safety_director": {
        "handler": "agents.bibblio_learning_safety_director",
        "role": "AI Director of Learning Science, Curriculum, and Child Safety"
      }
    }
  },
  "llm": {
    "enabled": true,
    "mode": "actor_assisted",
    "mock_mode": "deterministic",
    "provider": "docker_model_runner",
    "model": "small",
    "runtime_model": "small",
    "backend": "llama.cpp",
    "default_config": "primary",
    "configs": {
      "primary": {
        "provider": "docker_model_runner",
        "model": "small",
        "runtime_model": "small",
        "backend": "llama.cpp",
        "temperature": 0.2,
        "max_tokens": 2400
      }
    },
    "responsibilities": [
      "Separate observed facts from assumptions.",
      "Preserve source references and name missing evidence.",
      "Draft review-ready recommendations without executing external actions."
    ],
    "agents": {
      "bibblio_learning_safety_director": {
        "llm_config": "primary",
        "role": "AI Director of Learning Science, Curriculum, and Child Safety",
        "responsibilities": [
          "Verify observable learning objectives and developmental fit.",
          "Record PASS, REVISE, or BLOCK decisions with evidence and conditions.",
          "Keep child-facing publication and sensitive topics behind qualified human review."
        ]
      }
    }
  },
  "mcp_collaboration": {
    "enabled": true,
    "goal_id": "bibblio-profitable-business",
    "publication_state": "staged",
    "publish_local_exchange": true,
    "peer_reads_enabled": false,
    "include_staged_peer_records": true,
    "max_peer_servers": 8,
    "max_records_per_peer": 50,
    "note": "Internal workflow messages remain on Core. MCP exposes bounded goal work packets from separately launched co-worker jobs only when explicit peer configurations are approved."
  },
  "requirements": {
    "cpu": {
      "min_cores": 1
    },
    "memory": {
      "min_gb": 1
    },
    "disk": {
      "min_gb": 1
    },
    "gpu": {
      "min_count": 0
    }
  },
  "metadata": {
    "blueprint_id": "bibblio_learning_safety_coworker",
    "runtime_features": [
      "curriculum intake review",
      "PASS/REVISE/BLOCK gate",
      "therapeutic claim blocking",
      "MCP learning decisions"
    ],
    "collaboration_group": "bibblio-profitability-team",
    "business_goal": "Turn Bibblio into a profitable business.",
    "job_data": {
      "resources": [
        {
          "name": "state",
          "path": "state",
          "access": "read_write"
        }
      ]
    }
  },
  "workflow": {
    "workflow_id": "bibblio_learning_safety_coworker_v1",
    "execution": {
      "strategy": "serial"
    },
    "policy": {
      "failure": {
        "default": "fail_closed"
      },
      "human": {
        "enabled": true,
        "mode": "approval_required",
        "allowed_decisions": [
          "approve",
          "revise",
          "reject"
        ],
        "blocked_actions": [
          "send_external_communications",
          "publish_child_facing_content",
          "spend_money",
          "change_pricing",
          "change_data_collection"
        ],
        "default_action": "reject",
        "timeout_seconds": 86400
      }
    },
    "steps": [
      {
        "id": "review_learning_backlog",
        "kind": "source",
        "label": "Review Learning Backlog",
        "goal": "Assign deterministic intake decisions and quarantine unsafe or incomplete learning proposals.",
        "needs": [],
        "run": {
          "definition": "steps.review_learning_backlog"
        },
        "control": {
          "required": true,
          "timeout_seconds": 900,
          "failure_policy": "fail_workflow",
          "retry": {
            "max_attempts": 2,
            "backoff_seconds": 1,
            "backoff_multiplier": 2,
            "jitter": 0
          },
          "uncertainty": {
            "min_confidence": 0,
            "on_low_confidence": "continue_with_warning"
          }
        }
      },
      {
        "id": "publish_learning_safety_packet",
        "kind": "sink",
        "label": "Publish Learning & Safety Packet",
        "goal": "Publish the authoritative learning gate for the Content Studio and founder.",
        "needs": [
          "review_learning_backlog"
        ],
        "run": {
          "definition": "steps.publish_learning_safety_packet"
        },
        "control": {
          "required": true,
          "timeout_seconds": 900,
          "failure_policy": "fail_workflow",
          "retry": {
            "max_attempts": 2,
            "backoff_seconds": 1,
            "backoff_multiplier": 2,
            "jitter": 0
          },
          "uncertainty": {
            "min_confidence": 0,
            "on_low_confidence": "continue_with_warning"
          }
        }
      }
    ]
  },
  "skill_dependencies": [
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-mcp-client-skill",
      "version": "1.2.31"
    },
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-mcp-server-skill",
      "version": "1.2.31"
    },
    {
      "type": "pip",
      "source": "gar",
      "name": "mirrorneuron-goal-work-packet-skill",
      "version": "1.2.31"
    }
  ],
  "agent_dependencies": [
    {
      "type": "pip",
      "source": "gar",
      "name": "mn-prototype-stateful-step-agent",
      "version": "1.2.31"
    }
  ]
}
