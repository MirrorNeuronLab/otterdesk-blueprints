{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/execution.schema.json",
  "type": "service",
  "job_name": "ros-amr-controller",
  "service": {
    "enabled": true,
    "manual_close": "Pause or stop the co-worker in OtterDesk; Core tears down only this run's isolated Docker Compose project on the selected ROS host.",
    "run_until": "manual_stop"
  },
  "requirements": {
    "cpu": {
      "min_cores": 4
    },
    "memory": {
      "min_gb": 8
    },
    "disk": {
      "min_gb": 10
    },
    "gpu": {
      "min_count": 1,
      "vendor": "nvidia",
      "driver": "cuda",
      "min_memory_mb": 49152,
      "memory_operator": ">=",
      "enforcement": "hard"
    }
  },
  "policies": {
    "recovery_mode": "local_restart",
    "restart": {
      "attempts": 3,
      "delay_function": "exponential",
      "delay_ms": 2000,
      "interval_ms": 600000,
      "max_delay_ms": 30000,
      "mode": "fail"
    }
  },
  "agents": {
    "schema": "mn.agents.communication_graph/v1",
    "entrypoints": [
      "warehouse_service"
    ],
    "edges": [
      {
        "edge_id": "warehouse_service_to_finalize",
        "from_node": "warehouse_service",
        "message_type": "service_stopped",
        "to_node": "finalize"
      }
    ],
    "nodes": [
      {
        "node_id": "warehouse_service",
        "alias": "warehouse_service",
        "display_name": "TurtleBot Warehouse",
        "agent_type": "executor",
        "type": "generic",
        "role": "root_coordinator",
        "constraints": [
          {
            "attribute": "capabilities",
            "operator": "contains_all",
            "value": [
              "nvidia",
              "cuda"
            ]
          }
        ],
        "resources": {
          "cpu_cores": 4,
          "memory_mb": 8192,
          "disk_mb": 10240,
          "gpu_count": 1,
          "runtime_driver": "docker_compose",
          "devices": [
            {
              "kind": "gpu",
              "type": "nvidia/gpu",
              "vendor": "nvidia",
              "driver": "cuda",
              "min_memory_mb": 49152,
              "memory_operator": ">=",
              "count": 1
            }
          ],
          "ports": [
            {
              "label": "video",
              "port": 8080,
              "protocol": "http"
            },
            {
              "label": "dashboard",
              "port": 8088,
              "protocol": "http"
            },
            {
              "label": "robot-mcp",
              "port": 8090,
              "protocol": "http"
            },
            {
              "label": "rosbridge",
              "port": 9090,
              "protocol": "tcp"
            }
          ]
        },
        "config": {
          "runner_module": "MirrorNeuron.Runner.DockerCompose",
          "compose": {
            "exclusive": true,
            "project_name": "mn-compose-ros-amr-controller",
            "context": "docker_compose/turtlebot-maze",
            "file": "docker-compose.yaml",
            "env_file": "mirrorneuron/warehouse.env",
            "services": [
              "demo-world-warehouse",
              "warehouse-video-server",
              "warehouse-video-ui",
              "rosbridge",
              "warehouse-control-relay",
              "warehouse-navigation-gateway",
              "warehouse-mcp"
            ],
            "health": [
              {
                "url": "http://127.0.0.1:8088/"
              },
              {
                "url": "http://127.0.0.1:8090/health"
              },
              {
                "tcp_port": 8080
              },
              {
                "tcp_port": 9090
              }
            ],
            "startup_timeout_seconds": 900
          },
          "idempotent": false,
          "safe_to_retry": false,
          "timeout_seconds": 86400,
          "output_message_type": "service_stopped",
          "max_attempts": 1,
          "max_output_bytes": 1048576
        },
        "services": [
          {
            "name": "ros-amr-controller-web-ui",
            "address": "${config.web_ui.service.advertise_host}",
            "port": "${config.web_ui.service.port}",
            "origin": "internal",
            "tags": [
              "web_ui",
              "ros_amr_controller",
              "robotics",
              "turtlebot",
              "warehouse"
            ],
            "meta": {
              "blueprint_id": "ros_amr_controller",
              "title": "Warehouse AMR Monitor",
              "url": "http://${config.web_ui.service.advertise_host}:${config.web_ui.service.port}",
              "schema_version": "mn.turtlebot.web_ui.v1"
            },
            "checks": [
              {
                "name": "dashboard-http",
                "type": "http",
                "address": "${config.web_ui.service.advertise_host}",
                "port": "${config.web_ui.service.port}",
                "path": "/",
                "expected_status": 200,
                "interval_ms": 2000,
                "timeout_ms": 1000,
                "failures_before_critical": 5,
                "required": true
              }
            ]
          },
          {
            "name": "ros-amr-controller-mcp",
            "address": "${config.web_ui.service.advertise_host}",
            "port": "${config.mcp_control.service.port}",
            "origin": "internal",
            "tags": [
              "mcp",
              "robot-control",
              "ros-amr-controller"
            ],
            "meta": {
              "url": "http://${config.web_ui.service.advertise_host}:${config.mcp_control.service.port}/mcp",
              "path": "/mcp",
              "schema_version": "mn.ros_amr_controller.mcp.v1"
            },
            "checks": [
              {
                "name": "robot-mcp-http",
                "type": "http",
                "address": "${config.web_ui.service.advertise_host}",
                "port": "${config.mcp_control.service.port}",
                "path": "/health",
                "expected_status": 200,
                "interval_ms": 2000,
                "timeout_ms": 1000,
                "failures_before_critical": 5,
                "required": true
              }
            ]
          },
          {
            "name": "turtlebot-video",
            "address": "${config.web_ui.service.advertise_host}",
            "port": 8080,
            "origin": "internal",
            "tags": [
              "ros2",
              "video",
              "turtlebot"
            ]
          },
          {
            "name": "turtlebot-rosbridge",
            "address": "${config.web_ui.service.advertise_host}",
            "port": 9090,
            "origin": "internal",
            "tags": [
              "ros2",
              "websocket",
              "turtlebot"
            ]
          }
        ]
      },
      {
        "node_id": "finalize",
        "alias": "finalize",
        "display_name": "Finalize Service Run",
        "agent_type": "executor",
        "type": "generic",
        "role": "worker",
        "resources": {
          "cpu_cores": 0.1,
          "memory_mb": 32,
          "disk_mb": 4,
          "runtime_driver": "host_local"
        },
        "config": {
          "runner_module": "MirrorNeuron.Runner.HostLocal",
          "command": [
            "bash",
            "finish_service.sh"
          ],
          "output_message_type": "final_result",
          "idempotent": true,
          "safe_to_retry": true,
          "max_attempts": 1,
          "upload_as": "worker",
          "upload_path": "worker",
          "workdir": "/sandbox/job/worker"
        }
      }
    ]
  },
  "runtime": {
    "bindings": {
      "warehouse_service": {
        "strategy": "single",
        "type": "worker",
        "workers": [
          {
            "id": "warehouse_service",
            "role": "Run the continuous ROS 2 warehouse service."
          }
        ]
      },
      "finalize": {
        "strategy": "single",
        "type": "worker",
        "workers": [
          {
            "id": "finalize",
            "role": "Finalize a deliberately stopped service run."
          }
        ]
      }
    },
    "initial_inputs": {
      "warehouse_service": [
        {
          "scenario": "warehouse"
        }
      ]
    },
    "store": {
      "path": "~/.mn/runs/${run_id}",
      "type": "local_run_store"
    },
    "workflow_control": {
      "schema_version": "mn.workflow.runtime_control.v1",
      "enabled": true,
      "source_of_truth": "workflow.steps",
      "state_ledger": {
        "enabled": true,
        "persisted_field": "workflow_state",
        "step_statuses": [
          "pending",
          "ready",
          "queued",
          "running",
          "retry_wait",
          "blocked",
          "completed",
          "partial",
          "skipped",
          "failed"
        ],
        "message_ledger": true,
        "delivery_semantics": "at_least_once_with_idempotency"
      },
      "attempts": {
        "stale_attempt_outputs": "ignore",
        "retry_policy_source": "workflow.steps[].control.retry",
        "timeout_source": "workflow.steps[].control.timeout_seconds"
      },
      "liveness": {
        "event": "agent_beacon",
        "interval_ms": 15000,
        "timeout_ms": 45000,
        "required": true,
        "missed_action": "fail_attempt"
      },
      "reconciliation": {
        "interval_ms": 2000,
        "on_timeout": "fail_attempt_then_retry",
        "on_missed_beacon": "fail_attempt_then_retry",
        "on_retry_exhausted": "apply_step_failure_policy"
      },
      "pause_cancel": {
        "pause_mode": "stop_active_attempts",
        "resume_mode": "reconcile_from_workflow_state",
        "cancel_mode": "terminate_active_attempts"
      },
      "events": [
        "workflow_step_attempt_started",
        "workflow_step_beacon",
        "workflow_step_attempt_completed",
        "workflow_step_attempt_timed_out",
        "workflow_step_attempt_retry_scheduled",
        "workflow_step_blocked",
        "workflow_step_completed",
        "workflow_step_failed",
        "workflow_message_dead_lettered"
      ]
    }
  },
  "mode": "compiled"
}
