{
  "inputs": {
    "adapter": "mock",
    "payload": {
      "scenario": "warehouse"
    }
  },
  "logging": {
    "events_jsonl": true,
    "logs_jsonl": true,
    "redact_env_secrets": true
  },
  "mcp_control": {
    "enabled": true,
    "kind": "streamable_http",
    "service": {
      "host": "0.0.0.0",
      "path": "/mcp",
      "port": 8090
    }
  },
  "outputs": {
    "adapter": "local_run_store",
    "run_root": "~/.mn/runs",
    "write_run_store": true
  },
  "resources": {
    "enabled": true,
    "gpu_enabled": true,
    "gpu_sample_interval_seconds": 5,
    "sample_interval_seconds": 5
  },
  "standard_version": "1.0",
  "web_ui": {
    "dashboard": {
      "path": "@/payloads/docker_compose/turtlebot-maze/web_ui/index.html",
      "standard_panels": [
        "status",
        "timeline",
        "agents",
        "artifacts",
        "resources",
        "logs",
        "human_control"
      ]
    },
    "enabled": true,
    "input": {
      "adapter": "rosbridge"
    },
    "kind": "live_service",
    "output": {
      "adapter": "live_http"
    },
    "service": {
      "host": "0.0.0.0",
      "port": 8088
    }
  }
}
