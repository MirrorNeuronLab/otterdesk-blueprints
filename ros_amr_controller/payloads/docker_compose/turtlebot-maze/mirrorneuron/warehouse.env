# Static, headless settings for the managed Spark Compose project.
ROS_DISTRO=jazzy
TURTLEBOT_MODEL=3
BT_TYPE=queue
ENABLE_VISION=false
TARGET_COLOR=green
DETECTOR_TYPE=hsv
TARGET_OBJECT=cup
DISPLAY=
TURTLEBOT_X11_SOCKET=/dev/null
TURTLEBOT_XAUTHORITY=/dev/null
EGL_PLATFORM=surfaceless
__EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json
