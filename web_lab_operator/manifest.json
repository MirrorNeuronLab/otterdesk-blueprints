{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/manifest.schema.json",
  "id": "web_lab_operator",
  "name": "Web Lab Operator",
  "payload_api": "mn.blueprint.v1",
  "version": "1.2.0",
  "description": "Turn Markdown procedures into a supervised PyLabRobot liquid-handling simulation. Recall prior outcomes with Membrane, observe the deck, make bounded adaptations and review the saved evidence.",
  "workflow": "workflow.json",
  "execution": "execution.json",
  "contracts": "contracts.json",
  "config": "config/default.json",
  "dependencies": "dependencies.json",
  "license": "LICENSE.md",
  "terms": "TERM.md",
  "extensions": {
    "mn.product": {
      "file": "extensions/product.json",
      "required": false
    },
    "mn.storage": {
      "file": "extensions/storage.json",
      "required": true
    },
    "mn.response": {
      "file": "extensions/response.json",
      "required": true
    },
    "mn.context": {
      "file": "extensions/context.json",
      "required": true
    },
    "mn.rag": {
      "file": "extensions/rag.json",
      "required": true
    },
    "mn.llm": {
      "file": "extensions/llm.json",
      "required": true
    },
    "mn.ui": {
      "file": "extensions/ui.json",
      "required": false
    },
    "mn.mcp": {
      "file": "extensions/mcp.json",
      "required": true
    },
    "mn.blocks": {
      "file": "extensions/blocks.json",
      "required": true
    }
  }
}
