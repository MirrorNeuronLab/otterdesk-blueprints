{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/extensions/blocks.schema.json",
  "steps": {
    "capture_lab_procedure": {
      "uses": "mn.blocks.domain_operation@1",
      "hooks": {
        "operation": "domain.intake:capture"
      },
      "inputs": {
        "procedure_markdown": {
          "$ref": "run_input",
          "path": [
            "procedure_markdown"
          ]
        },
        "procedure_file": {
          "$ref": "run_input",
          "path": [
            "procedure_file"
          ]
        }
      },
      "limits": {
        "max_calls": 1,
        "timeout_seconds": 30
      }
    },
    "plan_lab_procedure": {
      "uses": "mn.blocks.structured_assessment@1",
      "config": {
        "prompt_file": "@/payloads/prompts/plan.md",
        "response_schema": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "ready",
                "needs_review"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "maxItems": 30,
              "minItems": 0
            },
            "unresolved": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "maxItems": 30,
              "minItems": 0
            },
            "plates": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "maxItems": 4,
              "minItems": 0
            },
            "liquids": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "well": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,31}/[A-H](?:[1-9]|1[0-2])$"
                  },
                  "volume_ul": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 360
                  },
                  "liquid": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "required": [
                  "well",
                  "volume_ul",
                  "liquid"
                ],
                "additionalProperties": false
              },
              "maxItems": 384,
              "minItems": 0
            },
            "steps": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,31}$"
                      },
                      "instruction_lines": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "maxItems": 20,
                        "minItems": 1
                      },
                      "kind": {
                        "const": "transfer"
                      },
                      "source": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,31}/[A-H](?:[1-9]|1[0-2])$"
                      },
                      "destination": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,31}/[A-H](?:[1-9]|1[0-2])$"
                      },
                      "volume_ul": {
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 360
                      },
                      "alternate_sources": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]{0,31}/[A-H](?:[1-9]|1[0-2])$"
                        },
                        "maxItems": 8,
                        "minItems": 0
                      }
                    },
                    "required": [
                      "id",
                      "instruction_lines",
                      "kind",
                      "source",
                      "destination",
                      "volume_ul",
                      "alternate_sources"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,31}$"
                      },
                      "instruction_lines": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "maxItems": 20,
                        "minItems": 1
                      },
                      "kind": {
                        "const": "mix"
                      },
                      "well": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,31}/[A-H](?:[1-9]|1[0-2])$"
                      },
                      "volume_ul": {
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 300
                      },
                      "cycles": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      }
                    },
                    "required": [
                      "id",
                      "instruction_lines",
                      "kind",
                      "well",
                      "volume_ul",
                      "cycles"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,31}$"
                      },
                      "instruction_lines": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "maxItems": 20,
                        "minItems": 1
                      },
                      "kind": {
                        "const": "wait"
                      },
                      "seconds": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 30
                      }
                    },
                    "required": [
                      "id",
                      "instruction_lines",
                      "kind",
                      "seconds"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,31}$"
                      },
                      "instruction_lines": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "maxItems": 20,
                        "minItems": 1
                      },
                      "kind": {
                        "const": "check_volume"
                      },
                      "well": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,31}/[A-H](?:[1-9]|1[0-2])$"
                      },
                      "minimum_ul": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 360
                      },
                      "maximum_ul": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 360
                      }
                    },
                    "required": [
                      "id",
                      "instruction_lines",
                      "kind",
                      "well",
                      "minimum_ul",
                      "maximum_ul"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "maxItems": 80,
              "minItems": 0
            },
            "goals": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "well": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,31}/[A-H](?:[1-9]|1[0-2])$"
                  },
                  "volume_ul": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 360
                  },
                  "tolerance_ul": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 5
                  }
                },
                "required": [
                  "well",
                  "volume_ul",
                  "tolerance_ul"
                ],
                "additionalProperties": false
              },
              "maxItems": 384,
              "minItems": 0
            }
          },
          "required": [
            "status",
            "summary",
            "assumptions",
            "unresolved",
            "plates",
            "liquids",
            "steps",
            "goals"
          ],
          "additionalProperties": false
        },
        "max_tokens": 12000
      },
      "hooks": {
        "validate": "domain.protocol:assessment_valid"
      },
      "inputs": {
        "procedure": {
          "$ref": "upstream",
          "step_id": "capture_lab_procedure",
          "path": [
            "result"
          ]
        }
      },
      "limits": {
        "max_calls": 1,
        "timeout_seconds": 180
      }
    },
    "simulate_lab_procedure": {
      "uses": "mn.blocks.domain_operation@1",
      "hooks": {
        "operation": "domain.simulation:run",
        "verify": "domain.simulation:verify"
      },
      "inputs": {
        "procedure": {
          "$ref": "upstream",
          "step_id": "capture_lab_procedure",
          "path": [
            "result"
          ]
        },
        "plan": {
          "$ref": "upstream",
          "step_id": "plan_lab_procedure",
          "path": [
            "result"
          ]
        }
      },
      "limits": {
        "max_calls": 80,
        "timeout_seconds": 960
      }
    },
    "publish_lab_review": {
      "uses": "mn.blocks.domain_operation@1",
      "hooks": {
        "operation": "domain.reporting:publish"
      },
      "inputs": {
        "simulation": {
          "$ref": "upstream",
          "step_id": "simulate_lab_procedure",
          "path": [
            "result"
          ]
        }
      },
      "limits": {
        "max_calls": 1,
        "timeout_seconds": 60
      }
    }
  }
}
