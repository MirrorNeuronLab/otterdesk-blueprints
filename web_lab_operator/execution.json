{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/execution.schema.json",
  "type": "batch",
  "mode": "compiled",
  "job_name": "web-lab-operator",
  "requirements": {
    "cpu": {
      "min_cores": 2
    },
    "memory": {
      "min_gb": 4
    },
    "disk": {
      "min_gb": 2
    },
    "gpu": {
      "min_count": 1,
      "min_memory_mb": 49152,
      "memory_operator": ">=",
      "enforcement": "hard"
    },
    "network": {
      "egress": "Dependency/image downloads during preparation; the configured model route and authenticated runtime Membrane service for private job memory. No robot access."
    }
  },
  "agents": {
    "registry": {}
  },
  "workers": {
    "groups": [
      {
        "steps": ["plan_lab_procedure"],
        "with": {
          "timeout_seconds": 1620
        }
      }
    ]
  },
  "defaults": {
    "worker": {
      "uses": "mn-agents.worker.python_docker@1",
      "with": {
        "stereotype": [
          "blueprint_docker_worker",
          "internal_write_worker"
        ],
        "docker_worker_image": "docker_worker",
        "image": "mirror-neuron/web-lab-operator:1.3.0",
        "dockerfile": "docker_worker/Dockerfile",
        "build_context": ".",
        "workdir": "/app",
        "timeout_seconds": 1200,
        "upload_paths": [
          {
            "source": "domain",
            "target": "domain"
          },
          {
            "source": "prompts",
            "target": "prompts"
          },
          {
            "source": "web_assets",
            "target": "web_assets"
          }
        ]
      }
    }
  }
}
