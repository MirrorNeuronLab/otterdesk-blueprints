        "required": true,
        "to": "finalize"
      }
    ],
    "collaboration": {},
    "native": {
      "warehouse_service": {
        "resources": {
          "cpu_cores": 4,
          "devices": [
            {
              "count": 1,
              "driver": "cuda",
              "kind": "gpu",
              "memory_operator": ">=",
              "min_memory_mb": 49152,
              "type": "nvidia/gpu",
              "vendor": "nvidia"
            }
          ],
          "disk_mb": 10240,
          "gpu_count": 1,
          "memory_mb": 8192,
          "ports": [
            {
              "label": "video",
              "port": 8080,
              "protocol": "http"
            },
            {
              "label": "dashboard",
              "port": 8088,
              "protocol": "http"
            },
            {
              "label": "robot-mcp",
              "port": 8090,
              "protocol": "http"
            },
            {
              "label": "rosbridge",
              "port": 9090,
              "protocol": "tcp"
            }
          ],
          "runtime_driver": "docker_compose"
        },
        "constraints": [
          {
            "attribute": "capabilities",
            "operator": "contains_all",
            "value": [
              "nvidia",
              "cuda"
            ]
          }
        ],
        "runner_module": "MirrorNeuron.Runner.DockerCompose"
      }
    }
  },
