{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/contracts.schema.json",
  "summary": "Cumulative AI-observed guest crossings at the three doors of the live synthetic lobby.",
  "inputs": {
    "output_folder": {
      "type": "local_path",
      "path_kind": "directory",
      "required": false
    }
  },
  "outputs": {
    "profile": "standard_run_store",
    "primary": {
      "id": "people_counts",
      "path": "people_counts.json",
      "type": "service_result",
      "schema_version": "mn.deepstream_hotel.people_counts.v1",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "status", "entered", "left", "doors", "recent_crossings", "observed_at"],
        "properties": {
          "schema_version": {"const": "mn.deepstream_hotel.people_counts.v1"},
          "status": {"enum": ["starting", "running", "stopped", "failed"]},
          "entered": {"type": "integer", "minimum": 0},
          "left": {"type": "integer", "minimum": 0},
          "doors": {
            "type": "object",
            "additionalProperties": false,
            "required": ["west_exit", "entrance", "east_exit"],
            "properties": {
              "west_exit": {"$ref": "#/$defs/door_counts"},
              "entrance": {"$ref": "#/$defs/door_counts"},
              "east_exit": {"$ref": "#/$defs/door_counts"}
            }
          },
          "recent_crossings": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["door", "direction", "observed_at"],
              "properties": {
                "door": {"enum": ["west_exit", "entrance", "east_exit"]},
                "direction": {"enum": ["entered", "left"]},
                "observed_at": {"type": "string", "format": "date-time"}
              }
            }
          },
          "observed_at": {"type": ["string", "null"], "format": "date-time"}
        },
        "$defs": {
          "door_counts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entered", "left"],
            "properties": {
              "entered": {"type": "integer", "minimum": 0},
              "left": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  },
  "privacy": {
    "external_sharing": "disabled",
    "classification": "internal"
  }
}
