#usda 1.0
(
    customLayerData = {
        string calibration = "K [R|t], OpenCV pixel coordinates"
        string scene = "Hotel Reception Hall"
        string worldUnits = "meters"
    }
    defaultPrim = "World"
    endTimeCode = 359
    framesPerSecond = 30
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 30
    upAxis = "Z"
)

def Xform "World"
{
    def "Materials"
    {
        def Material "IvoryStone"
        {
            token outputs:surface.connect = </World/Materials/IvoryStone/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.68, 0.63, 0.53)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Limestone"
        {
            token outputs:surface.connect = </World/Materials/Limestone/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.63, 0.59, 0.51)
                float inputs:metallic = 0
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "Walnut"
        {
            token outputs:surface.connect = </World/Materials/Walnut/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.058, 0.029)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "DeepGreen"
        {
            token outputs:surface.connect = </World/Materials/DeepGreen/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.035, 0.11, 0.095)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Brass"
        {
            token outputs:surface.connect = </World/Materials/Brass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.38, 0.13)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.26
                token outputs:surface
            }
        }

        def Material "Charcoal"
        {
            token outputs:surface.connect = </World/Materials/Charcoal/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.055, 0.06, 0.057)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "LoungeRug"
        {
            token outputs:surface.connect = </World/Materials/LoungeRug/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.23, 0.22)
                float inputs:metallic = 0
                float inputs:roughness = 0.95
                token outputs:surface
            }
        }

        def Material "HotelSign"
        {
            token outputs:surface.connect = </World/Materials/HotelSign/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Materials/HotelSign/Texture.outputs:rgb>
                float inputs:roughness = 0.65
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @hotel_sign.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Materials/HotelSign/UV.outputs:result>
                color3f outputs:rgb
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }
        def Material "ExitSign"
        {
            token outputs:surface.connect = </World/Materials/ExitSign/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Materials/ExitSign/Texture.outputs:rgb>
                float inputs:roughness = 0.65
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @exit_sign.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Materials/ExitSign/UV.outputs:result>
                color3f outputs:rgb
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }
    }

    def "Architecture"
    {
        def Cube "Floor" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Materials/IvoryStone>
            double size = 1
            float3 xformOp:scale = (20, 16, 0.24)
            double3 xformOp:translate = (0, 0, -0.12)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

