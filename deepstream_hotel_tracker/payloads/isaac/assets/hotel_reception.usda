                        prepend references = @downloads/people/Characters/F_Business_02/F_Business_02.usd@
                    )
                    {
                        over "female_adult_business_02"
                        {
                            over "Looks"
                            {
                                over "opaque__fabric__vest"
                                {
                                    over "Shader"
                                    {
                                        color3f inputs:diffuse_tint = (0.75, 0.68, 0.5)
                                    }
                                }
                            }

                            over "ManRoot"
                            {
                                over "female_adult_business_02"
                                {
                                    over "female_adult_business_02"
                                    {
                                        over "female_adult_business_02" (
                                            prepend apiSchemas = ["SkelBindingAPI"]
                                        )
                                        {
                                            rel skel:animationSource = </World/Animations/Walk>
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

