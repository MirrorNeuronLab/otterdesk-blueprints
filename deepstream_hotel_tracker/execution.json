{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/execution.schema.json",
  "type": "service",
  "mode": "compiled",
  "job_name": "deepstream-hotel-tracker",
  "service": {
    "enabled": true,
    "run_until": "manual_stop",
    "state_artifact": "people_counts.json",
    "manual_close": "Pause or stop the co-worker in OtterDesk to stop the lobby simulation and tracking."
  },
  "requirements": {
    "os": "linux",
    "cpu": {
      "min_cores": 4
    },
    "disk": {
      "min_gb": 80
    },
    "memory": {
      "min_gb": 8
    },
    "gpu": {
      "vendor": "nvidia",
      "driver": "cuda",
      "enforcement": "hard",
      "min_count": 1,
      "memory_operator": ">=",
      "min_memory_mb": 49152
    },
    "network": {
      "egress": "Image preparation downloads NVIDIA Isaac Sim, DeepStream, PeopleNet, and pinned Atrium and AgiBot USD dependencies, plus Ubuntu and Python packages."
    }
  },
  "agents": {
    "registry": {}
  },
  "defaults": {
    "worker": {
      "uses": "mn-agents.worker.python_docker@1",
      "with": {
        "docker_worker_image": "docker_worker",
        "build_context": ".",
        "dockerfile": "docker_worker/Dockerfile",
        "image": "mirror-neuron/deepstream-hotel-tracker:0.4.1",
        "python_executable": "/opt/mn-venv/bin/python3",
        "gpus": "all",
        "stereotype": [
          "blueprint_docker_worker",
          "internal_write_worker"
        ],
        "upload_paths": [
          {
            "source": "domain",
            "target": "domain"
          }
        ],
        "workdir": "/app"
      }
    }
  }
}
