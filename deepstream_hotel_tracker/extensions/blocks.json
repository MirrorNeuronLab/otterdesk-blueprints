{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/extensions/blocks.schema.json",
  "steps": {
    "check_lobby_setup": {
      "uses": "mn.blocks.domain_operation@1",
      "hooks": { "operation": "domain.live:check_lobby_setup" },
      "limits": { "max_calls": 1, "timeout_seconds": 30 }
    },
    "prepare_guest_detection": {
      "uses": "mn.blocks.domain_operation@1",
      "hooks": { "operation": "domain.live:prepare_guest_detection" },
      "limits": { "max_calls": 1, "timeout_seconds": 1200 }
    },
    "monitor_live_lobby": {
      "uses": "mn.blocks.monitored_service@1",
      "hooks": {
        "start": "domain.live:start",
        "ready": "domain.live:ready",
        "health": "domain.live:health",
        "cycle": "domain.live:cycle",
        "stop": "domain.live:stop"
      },
      "outputs": {
        "service": {
          "$ref": "flow_output",
          "path": ["result"]
        }
      },
      "config": {
        "interval_seconds": 2,
        "max_cycles": null,
        "buffer_policy": "latest",
        "startup_timeout_seconds": 1200
      },
      "limits": {
        "max_calls": 1
      }
    }
  }
}
