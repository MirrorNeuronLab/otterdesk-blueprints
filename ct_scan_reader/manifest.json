{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/manifest.schema.json",
  "id": "ct_scan_reader",
  "name": "CT research reader",
  "version": "0.1.0",
  "description": "Explore chest or abdominal CT scans with NVIDIA NV-Reason-CT. Research and education only \u2014 not for real diagnosis, treatment, or clinical decisions. Upload a .nii or .nii.gz volume in Chat and review the experimental report alongside a local CT preview.",
  "workflow": "workflow.json",
  "execution": "execution.json",
  "contracts": "contracts.json",
  "config": "config/default.json",
  "dependencies": "dependencies.json",
  "license": "LICENSE.md",
  "terms": "TERM.md",
  "extensions": {
    "mn.product": {
      "file": "extensions/product.json",
      "required": false
    },
    "mn.response": {
      "file": "extensions/response.json",
      "required": true
    },
    "mn.context": {
      "file": "extensions/context.json",
      "required": true
    },
    "mn.ui": {
      "file": "extensions/ui.json",
      "required": false
    },
    "mn.rag": {
      "file": "extensions/rag.json",
      "required": false
    }
  }
}
